<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp5">
    <androidx.cardview.widget.CardView
        android:id="@+id/parentCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp4"
        app:cardElevation="@dimen/dp6">
        <LinearLayout
            android:background="@drawable/curved_rectangle_background_white_with_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4">
            <RelativeLayout
                android:layout_width="408dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:gravity="center_horizontal"
                    android:id="@+id/vedioicon"
                    android:background="0x7f080539"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp12"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:textAlignment="center"
                    android:layout_marginStart="20dp"
                    android:layout_alignParentStart="true"
                    android:backgroundTint="@color/colorPrimary"/>
                <TextView
                    android:textSize="@dimen/small_text_size"
                    android:textColor="@color/theme_and_header_color"
                    android:gravity="center_horizontal"
                    android:id="@+id/vediotime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:text="@string/cell_injury"
                    android:layout_toRightOf="@+id/vedioicon"
                    android:layout_alignBottom="@+id/vediotitle"
                    android:layout_centerVertical="true"
                    android:textAlignment="center"
                    android:layout_marginStart="24dp"
                    android:layout_toEndOf="@+id/vedioicon"/>
                <TextView
                    android:textSize="14.5sp"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="marquee"
                    android:id="@+id/vediotitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/basic_concepts"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:layout_alignTop="@+id/vedioicon"
                    android:layout_centerVertical="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="@dimen/dp30"
                    android:layout_toEndOf="@+id/vediotime"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
