<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:background="@color/theme_and_header_color"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/image_back"
                android:padding="@dimen/dp5"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp30"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/heading_text_size"
                android:textStyle="bold"
                android:textColor="@color/commonToolbarTextColor"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/toolbarTitleTV"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Invoice"
                android:maxLines="1"
                android:layout_toRightOf="@+id/image_back"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter_bold"
                android:layout_marginStart="@dimen/dp10"/>
            <CheckBox
                android:gravity="center_vertical"
                android:id="@+id/select_all_delete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/select"
                android:fontFamily="@font/inter_medium"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"
                android:buttonTint="@color/colorWhite"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/delete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/delete"
                android:drawableLeft="@drawable/delete"
                android:fontFamily="@font/inter_medium"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/procceed"
        android:layout_below="@+id/main_toolbar">
        <RelativeLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp125"
                android:src="@drawable/round_half_corner_home_yellow"
                android:scaleType="fitXY"/>
            <RelativeLayout
                android:id="@+id/layout_course"
                android:background="@drawable/bg_course_invoice"
                android:paddingBottom="@dimen/dp30"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10">
                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/imageIV"
                    android:layout_width="@dimen/dp140"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/dp20"
                    android:src="@mipmap/course_placeholder"
                    android:scaleType="fitXY"
                    android:layout_centerHorizontal="true"
                    app:riv_corner_radius="@dimen/dp10"
                    app:riv_oval="false"/>
                <TextView
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/coursenameTV"
                    android:padding="@dimen/dp2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="ESE+GATE 2021 - Module course"
                    android:maxLines="2"
                    android:layout_below="@+id/imageIV"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginStart="@dimen/dp20"
                    android:layout_marginEnd="@dimen/dp20"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/validityTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/validity_100_days"
                    android:layout_below="@+id/coursenameTV"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/inter_regular"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@drawable/top_corer_bg_whit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/layout_course">
                <TextView
                    android:textSize="@dimen/sp20"
                    android:textStyle="bold"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/summary_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:text="@string/summary"
                    android:fontFamily="@font/inter_bold"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/price_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_below="@+id/summary_txt"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/package_price"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:id="@+id/txtPriceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 25000"
                        android:fontFamily="@font/inter_bold"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/view3"
                    android:background="@color/dark_quiz_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp2"
                    android:layout_below="@+id/price_layout"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/tax_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_below="@+id/view3"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/correct"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/coupon_applied"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/coupon_applied_10_off"
                        android:maxLines="1"
                        android:layout_toLeftOf="@+id/tax_value"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/correct"
                        android:gravity="center_vertical"
                        android:id="@+id/tax_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- ₹ 2500"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/total_amount_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_below="@+id/tax_layout"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:id="@+id/txtAmountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 1000"
                        android:fontFamily="@font/inter_bold"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/view4"
                    android:background="@color/dark_quiz_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp2"
                    android:layout_below="@+id/total_amount_layout"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/prices_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_below="@+id/view4"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:id="@+id/txtPricesValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 10"
                        android:fontFamily="@font/inter_bold"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/taxes_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_below="@+id/prices_layout"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gst"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/color_545454"
                        android:gravity="center_vertical"
                        android:id="@+id/txtTaxValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹ 10"
                        android:fontFamily="@font/inter_bold"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/view1"
                    android:background="@color/dark_quiz_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp2"
                    android:layout_below="@+id/taxes_layout"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/grand_total_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_below="@+id/view1"
                    android:paddingStart="@dimen/dp20"
                    android:paddingEnd="20dp">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/country_code_text_color"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/grand_total"
                        android:fontFamily="@font/inter_bold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/country_code_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/txtGrandTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="₹ 00.0"
                        android:fontFamily="@font/inter_bold"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/view2"
                    android:background="@color/dark_quiz_grey"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp2"
                    android:layout_below="@+id/grand_total_layout"/>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
    <Button
        android:textSize="@dimen/sp16"
        android:textStyle="bold"
        android:textColor="@color/commonBtnTextColor"
        android:gravity="center_vertical"
        android:id="@+id/procceed"
        android:background="@drawable/common_round_corners_button_drawable"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp50"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp10"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/proceed"
        android:layout_alignParentBottom="true"
        android:fontFamily="@font/inter_medium"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"/>
</RelativeLayout>
