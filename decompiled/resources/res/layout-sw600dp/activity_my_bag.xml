<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw600dp/activity_my_bag_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBarId"
        android:background="@drawable/background_app_bar_bottom_round"
        android:paddingBottom="@dimen/dp4"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:src="@drawable/back_arrow_black"
            android:layout_marginStart="@dimen/dp16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/black"
            android:id="@+id/bagTextId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="My Bag"
            android:fontFamily="@font/inter_bold"
            android:layout_marginStart="@dimen/dimen_23dp"
            app:layout_constraintStart_toEndOf="@+id/backButton"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/searchId"
            android:background="@drawable/round_white_bg_16_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp18"
            android:layout_marginBottom="@dimen/dp5"
            android:hint="Search..."
            android:drawablePadding="@dimen/dp20"
            android:drawableEnd="@drawable/search_yellow"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp12"
            android:elevation="@dimen/dimen_8dp"
            android:paddingHorizontal="@dimen/dimen_12dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bagTextId"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cartItem_coupon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarId">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewId"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cartItem_coupon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginRight="@dimen/dp12"
        app:cardCornerRadius="@dimen/dp4"
        app:layout_constraintBottom_toTopOf="@+id/orderLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <EditText
            android:textSize="14sp"
            android:gravity="start"
            android:id="@+id/coupon_code"
            android:background="@color/white"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Have a Coupon Code?"
            android:drawablePadding="12dp"
            android:inputType="text"
            android:drawableStart="@mipmap/coupon_default"
            android:fontFamily="@font/inter_medium"
            android:paddingStart="@dimen/dp8"
            android:paddingEnd="@dimen/dp8"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/yellow_light"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:fontFamily="@font/inter_medium"
            android:layout_marginEnd="@dimen/dp16"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/black"
        android:id="@+id/orderDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:text="Order Details"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cartItem_coupon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/orderLayout"
        android:background="@drawable/round_white_bg_16_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp10"
        android:paddingVertical="@dimen/dp14"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout2">
        <TextView
            android:textColor="#585858"
            android:id="@+id/totalProductId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Products (0 Items)"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/black"
            android:id="@+id/totalProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹39,900"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="#585858"
            android:id="@+id/deliveryChargeId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Delivery charges"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/totalProductId"/>
        <TextView
            android:textColor="@color/black"
            android:id="@+id/deliveryChargePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Free"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/totalProductPrice"/>
        <TextView
            android:textColor="#585858"
            android:id="@+id/grandTotalId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Grand total"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deliveryChargeId"/>
        <TextView
            android:textColor="@color/black"
            android:id="@+id/grandTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="₹39,900"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deliveryChargePrice"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout2"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="19sp"
            android:textColor="@color/yellow_light"
            android:id="@+id/totalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rs 39,900"
            android:fontFamily="@font/inter_bold"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inclusive of GST"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/totalPrice"/>
        <Button
            android:textColor="@color/black"
            android:id="@+id/placeOrderId"
            android:background="@drawable/round_button_bg_yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:minHeight="@dimen/dp0"
            android:text="Place Order"
            android:textAlignment="center"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="25dp"
            android:paddingVertical="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:id="@+id/no_data_found_RL"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/image"
                android:background="0x7f080655"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp10"/>
            <TextView
                android:textColor="@color/country_code_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/no_data"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/your_cart_is_empty"
                android:fontFamily="@font/amazon_ember_bd"/>
            <TextView
                android:textSize="@dimen/extrasmall_text_size_12"
                android:gravity="center"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="40dp"
                android:text="Sorry, there is no result for this search."
                android:fontFamily="@font/amazon_ember_rg"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
