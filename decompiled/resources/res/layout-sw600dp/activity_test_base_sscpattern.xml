<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:tag="layout-sw600dp/activity_test_base_sscpattern_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:tag="binding_1"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/include_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ssc_pattern_toolbar_layout"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/recyclerSectionTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/include_toolbar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/statsContainer"
            android:background="#f8f9fa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="9dp"
            android:paddingVertical="7dp"
            app:layout_constraintTop_toBottomOf="@+id/recyclerSectionTabs">
            <TextView
                android:textSize="12sp"
                android:textColor="#424242"
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Questions Answered:"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/ssc_red"
                android:gravity="center"
                android:id="@+id/tvTotalCount"
                android:background="@drawable/shape_circle_orange_light"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="@string/_0"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvTotalLabel"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/md_pink_A400"
                android:id="@+id/timeLeftTxt"
                android:background="@drawable/shape_rect_red_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_0_mins"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottomBar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:weightSum="3"
            android:layout_marginHorizontal="5dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/sp12"
                android:textColor="@color/ssc_blue"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btnPrevious"
                android:background="@drawable/btn_outline_blue"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:text="@string/previous"
                android:layout_weight="0.8"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_semibold"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/sp12"
                android:textColor="@color/ssc_blue"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btnMarkReview"
                android:background="@drawable/btn_outline_blue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:text="@string/mark_for_review"
                android:layout_weight="1.2"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_semibold"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/sp12"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btnSaveNext"
                android:background="@drawable/btn_solid_blue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:text="@string/save_amp_next"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_semibold"/>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerQuestions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintTop_toBottomOf="@+id/statsContainer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="end"
        android:id="@+id/nav_drawer_container"
        android:tag="binding_2"
        android:background="@color/white"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/include_drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/ssc_pattern_drawer_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/submitLoader"
        android:background="@color/gray_transparent"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBarSubmit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/ssc_blue"/>
        <TextView
            android:textSize="@dimen/dimen_16sp"
            android:textColor="@color/ssc_blue"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/submitLoaderText"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Uploading... "/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
