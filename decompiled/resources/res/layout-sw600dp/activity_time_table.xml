<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:background="@color/theme_and_header_color"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/currentAffair_image_back"
                android:padding="@dimen/dp12"
                android:layout_width="@dimen/dp45"
                android:layout_height="@dimen/dp45"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp18"
                android:textColor="@color/commonToolbarTextColor"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/toolbarTitleTV"
                android:paddingLeft="@dimen/dp16"
                android:paddingRight="@dimen/dp5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Time Table"
                android:maxLines="1"
                android:layout_weight="0.8"
                android:layout_centerVertical="true"
                android:fontFamily="@font/inter_bold"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/batchRecycler"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/main_toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/teacherTimeTableLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/main_toolbar">
        <RelativeLayout
            android:background="@drawable/background_rectangle"
            android:paddingLeft="@dimen/dp6"
            android:paddingRight="@dimen/dp6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="@dimen/dp10"
            android:backgroundTint="@color/colorPrimary">
            <ImageView
                android:id="@+id/arrow1"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"
                app:tint="@color/white"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/DateTableRecycler"
                android:background="@color/light_quiz_grey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingStart="10dp"
                android:paddingEnd="@dimen/dp10"
                android:layout_toStartOf="@+id/arrow2"
                android:layout_toEndOf="@+id/arrow1"/>
            <ImageView
                android:id="@+id/arrow2"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_arrow_forward_24"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:tint="@color/white"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/timeTableRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/DateTableRecycler"
            android:paddingStart="10dp"
            android:paddingEnd="@dimen/dp10"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/no_data_found_RL"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_toolbar">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/image"
                android:background="0x7f080655"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp10"
                android:layout_below="@+id/ll1"
                android:layout_centerInParent="true"/>
            <TextView
                android:textColor="@color/country_code_text_color"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/no_data"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/no_data_found"
                android:layout_centerInParent="true"
                android:fontFamily="@font/amazon_ember_bd"/>
            <TextView
                android:textSize="@dimen/extrasmall_text_size_12"
                android:gravity="center"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="@dimen/dp4"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="40dp"
                android:text="@string/sorry_there_is_no_result_for_this_search"
                android:fontFamily="@font/amazon_ember_rg"/>
            <Button
                android:textSize="@dimen/post_text_size"
                android:textColor="@color/commonBtnTextColor"
                android:id="@+id/backBtn"
                android:background="@drawable/common_round_corners_button_drawable"
                android:paddingLeft="@dimen/dp24"
                android:paddingRight="@dimen/dp24"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="24dp"
                android:text="@string/go_back"
                android:textAllCaps="false"
                android:fontFamily="@font/amazon_ember_bd"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
