<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:background="@color/theme_and_header_color"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/image_back"
                android:padding="@dimen/dp5"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp30"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/heading_text_size"
                android:textStyle="bold"
                android:textColor="@color/commonToolbarTextColor"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/toolbarTitleTV"
                android:paddingLeft="@dimen/dp5"
                android:paddingRight="@dimen/dp5"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp10"
                android:text="@string/add_address"
                android:maxLines="1"
                android:layout_toRightOf="@+id/image_back"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter_bold"/>
            <CheckBox
                android:gravity="center_vertical"
                android:id="@+id/select_all_delete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/select"
                android:fontFamily="@font/inter_medium"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"
                android:buttonTint="@color/country_code_text_color"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/delete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/delete"
                android:drawableLeft="@drawable/delete"
                android:fontFamily="@font/inter_medium"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/main_toolbar">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp16"
            app:cardElevation="@dimen/dp8">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dp20"
                android:outlineSpotShadowColor="@color/shadowMsgInput"
                android:outlineAmbientShadowColor="@color/black">
                <EditText
                    android:enabled="false"
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/nameTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:hint="@string/name"
                    android:maxLines="1"
                    android:editable="false"
                    android:inputType="textPersonName"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toTopOf="parent"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/fullAddressTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/full_address"
                    android:maxLines="3"
                    android:maxLength="190"
                    android:inputType="textPostalAddress"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/nameTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:textColor="#585858"
                    android:id="@+id/mobileTV"
                    android:padding="12dp"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:hint="Mobile Number"
                    android:maxLines="1"
                    android:maxLength="10"
                    android:inputType="number"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fullAddressTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:textColor="#585858"
                    android:id="@+id/alternateMobileTV"
                    android:padding="12dp"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:hint="Alternate Mobile Number"
                    android:maxLines="1"
                    android:maxLength="10"
                    android:inputType="number"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mobileTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/stateTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/states"
                    android:maxLines="1"
                    android:editable="false"
                    android:inputType="none"
                    android:drawableEnd="@drawable/arrow_down"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/alternateMobileTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/districtTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/district"
                    android:maxLines="1"
                    android:editable="false"
                    android:inputType="none"
                    android:drawableEnd="@drawable/arrow_down"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/stateTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/cityTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/city"
                    android:maxLines="1"
                    android:maxLength="40"
                    android:inputType="textPostalAddress"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/districtTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/pincodeTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pincode"
                    android:maxLines="1"
                    android:maxLength="6"
                    android:inputType="number"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/cityTV"/>
                <EditText
                    android:textSize="@dimen/post_text_size"
                    android:id="@+id/orderNotesTV"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/order_notes_optional"
                    android:maxLines="1"
                    android:inputType="textLongMessage"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"
                    app:layout_constraintTop_toBottomOf="@+id/pincodeTV"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewSavedAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/orderNotesTV"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/submit"
                    android:background="@drawable/round_corner_border_mycourse_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:layout_marginTop="@dimen/dp20"
                    android:text="@string/submit"
                    android:textAllCaps="false"
                    android:layout_marginStart="@dimen/dp40"
                    android:layout_marginEnd="@dimen/dp40"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/recyclerViewSavedAddress"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</RelativeLayout>
