<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_root"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_toolbar"
        android:background="@color/colorPrimary"
        android:paddingBottom="@dimen/dp4"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/image_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp16"
                app:tint="@color/commonToolbarTextColor"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/commonToolbarTextColor"
                android:id="@+id/toolbarTitleTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Address"
                android:layout_centerVertical="true"
                android:fontFamily="@font/inter_bold"
                android:layout_marginStart="@dimen/dimen_23dp"
                android:layout_toEndOf="@+id/image_back"/>
        </RelativeLayout>
        <CheckBox
            android:gravity="center_vertical"
            android:id="@+id/select_all_delete"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/select"
            android:fontFamily="@font/inter_medium"
            android:layout_marginEnd="@dimen/dp10"
            android:layout_alignParentEnd="true"
            android:buttonTint="@color/country_code_text_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/delete"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/delete"
            android:drawableLeft="@drawable/delete"
            android:fontFamily="@font/inter_medium"
            android:layout_marginEnd="@dimen/dp10"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:id="@+id/main_rl"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp20"
            android:outlineSpotShadowColor="@color/shadowMsgInput"
            android:outlineAmbientShadowColor="@color/black">
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/nameTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:hint="Name*"
                android:maxLines="1"
                android:maxLength="20"
                android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                android:inputType="text"
                android:fontFamily="@font/inter_medium"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/mobileTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:hint="Mobile Number*"
                android:maxLines="1"
                android:maxLength="10"
                android:inputType="phone"
                android:fontFamily="@font/inter_medium"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nameTV"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/alternateMobileTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:hint="Alternate Mobile Number"
                android:maxLines="1"
                android:maxLength="10"
                android:inputType="number"
                android:fontFamily="@font/inter_medium"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mobileTV"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/fullAddressTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Address (House No., Area and Street)*"
                android:maxLines="3"
                android:maxLength="100"
                android:inputType="textPostalAddress"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/alternateMobileTV"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/stateTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:focusable="false"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="State*"
                android:maxLines="1"
                android:editable="false"
                android:inputType="none"
                android:drawableEnd="@drawable/arrow_down"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fullAddressTV"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/districtTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:focusable="false"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="District*"
                android:maxLines="1"
                android:editable="false"
                android:inputType="none"
                android:drawableEnd="@drawable/arrow_down"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stateTV"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/cityTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="City*"
                android:maxLines="1"
                android:inputType="textPostalAddress"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/districtTV"/>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:id="@+id/pincodeTV"
                android:background="@drawable/round_common"
                android:padding="12dp"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Pincode*"
                android:maxLines="1"
                android:maxLength="6"
                android:inputType="number"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintTop_toBottomOf="@+id/cityTV"/>
            <RelativeLayout
                android:id="@+id/setAsDefaultRl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/orderNotesTV">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:id="@+id/setAsDefaultCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp5"
                    android:text="Set as default"
                    android:layout_marginStart="@dimen/dp10"/>
            </RelativeLayout>
            <EditText
                android:textSize="@dimen/post_text_size"
                android:textColor="#585858"
                android:id="@+id/orderNotesTV"
                android:background="@drawable/round_common"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp40"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/order_notes_optional"
                android:maxLines="1"
                android:inputType="textLongMessage"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pincodeTV"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setAsDefaultRl">
                <Button
                    android:textColor="@color/LogincolorPrimary"
                    android:id="@+id/submit"
                    android:background="@drawable/common_round_corners_button_drawable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:layout_marginBottom="12dp"
                    android:text="Save Address"
                    android:fontFamily="@font/inter_semibold"
                    android:textAlignment="center"
                    android:paddingStart="36dp"
                    android:paddingEnd="37dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="12dp"
                    android:layout_alignParentEnd="true"
                    android:paddingVertical="15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <RelativeLayout
        android:id="@+id/subRL"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/addAddressLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp10"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp6"
                android:layout_marginBottom="@dimen/dp6"
                android:text="+ ADD NEW ADDRESS"
                android:fontFamily="@font/inter_medium"
                android:layout_marginStart="@dimen/dp6"
                android:layout_marginEnd="@dimen/dp6"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSavedAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:layout_marginBottom="@dimen/dp10"
            android:layout_above="@+id/saveAddress"
            android:layout_below="@+id/addAddressLayout"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"/>
        <Button
            android:textColor="@color/whie"
            android:id="@+id/saveAddress"
            android:background="@drawable/common_round_corners_button_drawable"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="25dp"
            android:text="Deliver Here"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/inter_semibold"
            android:textAlignment="center"
            android:paddingStart="36dp"
            android:paddingEnd="37dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"
            android:paddingVertical="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </RelativeLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
