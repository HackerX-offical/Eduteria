<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppThemeOwn"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolbarDarkOverflow"
        android:id="@+id/feeds_toolbar"
        android:background="@color/theme_and_header_color"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:popupTheme="@style/Theme.AppCompat.NoActionBar">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="65dp"
                    android:layout_height="40dp"
                    android:src="0x7f080110"/>
                <TextView
                    android:textSize="@dimen/post_text_size"
                    android:textStyle="bold"
                    android:textColor="@color/commonToolbarTextColor"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp6"
                    android:text="@string/app_name"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/iconLL"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/homeBackIV"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:src="@drawable/ic_baseline_arrow_forward_24"
                    android:layout_centerVertical="true"
                    android:rotation="180"/>
                <TextView
                    android:textSize="@dimen/sub_heading_text_size"
                    android:textStyle="bold"
                    android:textColor="@color/whiteApp"
                    android:id="@+id/toolbartitleTV1"
                    android:paddingLeft="@dimen/dp0"
                    android:paddingRight="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/course"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_toEndOf="@+id/homeBackIV"/>
                <RelativeLayout
                    android:id="@+id/titleinnerRL"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_toEndOf="@+id/homeBackIV">
                    <TextView
                        android:textSize="@dimen/sub_heading_text_size"
                        android:textColor="@color/whiteApp"
                        android:id="@+id/toolbartitleTV"
                        android:paddingLeft="@dimen/dp0"
                        android:paddingRight="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/inter_bold"
                        android:paddingStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/downarrowIV"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginBottom="@dimen/dp5"
                        android:src="0x7f080390"
                        android:tint="@color/colorWhite"
                        android:layout_toRightOf="@+id/toolbartitleTV"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="2dp"/>
                </RelativeLayout>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/heading_text_size"
                android:textColor="@color/whiteApp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/iconLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp10"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageButton
                    android:id="@+id/chromecast"
                    android:background="@color/new_ui_yellow"
                    android:visibility="gone"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    app:srcCompat="@drawable/ic_cast_white"
                    app:tint="@color/colorWhite"/>
                <ImageView
                    android:id="@+id/searchIV"
                    android:padding="@dimen/dp5"
                    android:visibility="visible"
                    android:layout_width="@dimen/dp40"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_search_black"/>
                <RelativeLayout
                    android:id="@+id/relative_gotoCart"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp35"
                    android:layout_height="@dimen/dp35">
                    <ImageView
                        android:id="@+id/gotoCart"
                        android:padding="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp35"
                        android:layout_height="35dp"
                        app:srcCompat="@drawable/ic_cart"
                        app:tint="@color/white"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/black_405461"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/gotoCart"
                        android:fontFamily="@font/inter_medium"/>
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/linear_gotoCart"
                        android:background="@drawable/circle_notification_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_alignParentRight="true">
                        <TextView
                            android:textSize="@dimen/sp10"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/cart_count"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp16"
                            android:text=""/>
                    </LinearLayout>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/iv_whatsapp"
                    android:padding="@dimen/dp9"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp40"
                    android:layout_height="match_parent"
                    app:srcCompat="0x7f08065c"/>
                <RelativeLayout
                    android:id="@+id/notificationLL"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp35"
                    android:layout_height="@dimen/dp35">
                    <ImageView
                        android:id="@+id/notificationIV"
                        android:padding="@dimen/dp3"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@mipmap/notification_def"
                        app:tint="@color/white"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/black_405461"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/notification"
                        android:layout_below="@+id/notificationIV"
                        android:fontFamily="@font/inter_medium"/>
                    <LinearLayout
                        android:gravity="center"
                        android:id="@+id/cvrNotificationCount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp16"
                        android:layout_alignParentRight="true">
                        <TextView
                            android:textSize="@dimen/sp10"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/notificaionCount1"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp16"
                            android:text=""/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/pullto_referesh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_menu"
        android:layout_below="@+id/feeds_toolbar"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.appnew.android.Utils.StickyView.ui.StickyScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:stickyHeader="@+id/ll_top_two">
            <RelativeLayout
                android:id="@+id/mainlayout"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/ll_top"
                            android:background="@color/app_grey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RelativeLayout
                                android:background="@drawable/round_half_corner_home_yellow"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp110"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:weightSum="3">
                                <LinearLayout
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/my_library"
                                    android:background="@drawable/home_image_selector"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp0"
                                    android:layout_marginBottom="@dimen/dp8"
                                    android:minHeight="@dimen/dp170"
                                    android:layout_weight="1"
                                    android:layout_marginStart="@dimen/dp10">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp30"
                                        android:src="@mipmap/my_library"/>
                                    <TextView
                                        android:textSize="@dimen/post_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/black_071E57"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp10"
                                        android:text="@string/my_library"
                                        android:fontFamily="@font/inter_semibold"
                                        android:textAlignment="center"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/liveclass"
                                    android:background="@drawable/home_image_selector"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp0"
                                    android:layout_marginBottom="@dimen/dp8"
                                    android:minHeight="@dimen/dp170"
                                    android:layout_weight="1">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp30"
                                        android:src="0x7f08045d"/>
                                    <TextView
                                        android:textSize="@dimen/post_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/black_071E57"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp10"
                                        android:text="@string/live_classes"
                                        android:fontFamily="@font/inter_semibold"
                                        android:textAlignment="center"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:id="@+id/livetest"
                                    android:background="@drawable/home_image_selector"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp0"
                                    android:layout_marginBottom="@dimen/dp8"
                                    android:minHeight="@dimen/dp170"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="@dimen/dp10">
                                    <ImageView
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp30"
                                        android:src="0x7f08045f"/>
                                    <TextView
                                        android:textSize="@dimen/post_text_size"
                                        android:textStyle="bold"
                                        android:textColor="@color/black_071E57"
                                        android:layout_gravity="center"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp10"
                                        android:text="@string/live_tests"
                                        android:fontFamily="@font/inter_semibold"
                                        android:textAlignment="center"/>
                                </LinearLayout>
                            </LinearLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_top_two"
                            android:background="@drawable/round_half_corner_home_grey"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ll_top">
                            <RelativeLayout
                                android:gravity="center"
                                android:id="@+id/filter_one_click"
                                android:background="@drawable/image_filter_one"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginLeft="@dimen/dp16"
                                android:layout_marginTop="@dimen/dp10"
                                android:layout_marginRight="@dimen/dp8"
                                android:layout_marginBottom="@dimen/dp10"
                                android:layout_weight="4.25"
                                android:translationZ="@dimen/dp6"
                                android:elevation="@dimen/dp4">
                                <TextView
                                    android:textSize="@dimen/small_text_size2"
                                    android:textColor="@color/black_405461"
                                    android:ellipsize="end"
                                    android:id="@+id/filterOne"
                                    android:paddingLeft="@dimen/dp16"
                                    android:paddingRight="@dimen/dp2"
                                    android:layout_width="102dp"
                                    android:layout_height="wrap_content"
                                    android:text="@string/filter_one_text"
                                    android:maxLines="1"
                                    android:fontFamily="@font/inter_regular"/>
                                <ImageView
                                    android:id="@+id/downarrowIV_new"
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:src="@drawable/arrow_down"
                                    android:layout_marginEnd="@dimen/dp10"
                                    android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:gravity="center_vertical"
                                android:id="@+id/filter_two_click"
                                android:background="@drawable/image_filter_two"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginTop="@dimen/dp10"
                                android:layout_marginRight="@dimen/dp10"
                                android:layout_marginBottom="@dimen/dp10"
                                android:layout_weight="4.25"
                                android:translationZ="@dimen/dp6"
                                android:elevation="@dimen/dp4">
                                <TextView
                                    android:textSize="@dimen/small_text_size2"
                                    android:textColor="@color/black_405461"
                                    android:ellipsize="end"
                                    android:id="@+id/filterTwo"
                                    android:paddingLeft="@dimen/dp16"
                                    android:paddingRight="@dimen/dp2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/filter_two_text"
                                    android:maxLines="1"
                                    android:fontFamily="@font/inter_regular"
                                    android:layout_toStartOf="@+id/arrow"/>
                                <ImageView
                                    android:id="@+id/arrow"
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:src="@drawable/arrow_down"
                                    android:layout_marginEnd="@dimen/dp10"
                                    android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:gravity="center"
                                android:id="@+id/filter"
                                android:background="@drawable/filter_selector"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp6"
                                android:layout_weight="1.4"
                                android:layout_marginEnd="@dimen/dp10">
                                <ImageView
                                    android:padding="@dimen/dp6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="0x7f08027d"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:background="@color/white"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ll_top_two">
                            <RelativeLayout
                                android:id="@+id/viewPagerRL"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <include
                                    android:id="@+id/bannerSliderLayout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    layout="@layout/auto_slider_page_layout"/>
                            </RelativeLayout>
                            <androidx.recyclerview.widget.RecyclerView
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:id="@+id/tileRv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp6"
                                android:layout_marginTop="@dimen/dp12"
                                android:layout_marginRight="@dimen/dp6"/>
                            <RelativeLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dimen_6dp">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/title_ll"
                                    android:background="@color/white"
                                    android:paddingTop="6dp"
                                    android:paddingBottom="2dp"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/dimen_6dp">
                                    <TextView
                                        android:textSize="@dimen/sub_heading_text_size"
                                        android:textColor="@color/color_071E57"
                                        android:ellipsize="end"
                                        android:gravity="center"
                                        android:id="@+id/tile_tv"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/course"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/inter_bold"
                                        android:layout_marginStart="@dimen/dp10"/>
                                    <TextView
                                        android:textStyle="bold"
                                        android:textColor="@color/whiteApp"
                                        android:paddingLeft="8dp"
                                        android:paddingRight="8dp"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/view_all"/>
                                </LinearLayout>
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_below="@+id/title_ll">
                                    <androidx.recyclerview.widget.RecyclerView
                                        android:id="@+id/courseListRV"
                                        android:paddingBottom="@dimen/dp16"
                                        android:visibility="visible"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_below="@+id/course_banner"
                                        android:overScrollMode="never"
                                        android:layout_marginEnd="0dp"
                                        android:layout_alignParentEnd="true"/>
                                    <include layout="@layout/no_data_found"/>
                                </RelativeLayout>
                            </RelativeLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </com.appnew.android.Utils.StickyView.ui.StickyScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/floatGoToTop"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp20"
        android:src="@drawable/ic_goto_top"
        android:tint="@color/white"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
    <ProgressBar
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="@dimen/dp50"
        android:layout_height="@dimen/dp50"
        android:layout_above="@+id/RL1P"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/chatboat"
        android:visibility="gone"
        android:layout_width="@dimen/dp80"
        android:layout_height="@dimen/dp80"
        android:src="@mipmap/chatbot"
        android:scaleType="fitXY"
        android:layout_above="@+id/RL1P"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/RL1P"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="4dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/homeLL"
                android:background="@drawable/nav_ripple"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    app:srcCompat="@mipmap/home_active"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black_405461"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shop"
                    android:fontFamily="@font/inter_medium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/testLL"
                android:background="@drawable/nav_ripple"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:padding="@dimen/dp5"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    app:srcCompat="@mipmap/create_test_def"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black_405461"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/create_test"
                    android:fontFamily="@font/inter_medium"/>
            </LinearLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/profileLL"
                android:background="@drawable/nav_ripple"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/profile_image"
                    android:padding="@dimen/dp5"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    app:srcCompat="0x7f080515"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black_405461"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notification"
                    android:layout_below="@+id/profile_image"
                    android:fontFamily="@font/inter_medium"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/cvrNotificationCount"
                    android:background="@drawable/circle_notification_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_alignParentRight="true">
                    <TextView
                        android:textSize="@dimen/sp10"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/notificaionCount"
                        android:layout_width="@dimen/dp22"
                        android:layout_height="@dimen/dp22"/>
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cartLL"
                android:background="@drawable/nav_ripple"
                android:padding="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:padding="@dimen/dp5"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    app:srcCompat="@mipmap/download_def"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black_405461"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download"
                    android:fontFamily="@font/inter_medium"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <include
        android:id="@+id/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
