<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp6"
        android:elevation="@dimen/dp8"
        app:cardCornerRadius="@dimen/dp6">
        <RelativeLayout
            android:padding="@dimen/dp4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/dp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="4">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/dp16"
                            android:textStyle="bold"
                            android:textColor="@color/LogincolorPrimary"
                            android:ellipsize="end"
                            android:id="@+id/bookmark_count"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp8"
                            android:text="1"
                            android:lines="1"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:id="@+id/bookmark_tittle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp8"
                            android:text="Subject Name"
                            android:lines="1"
                            android:fontFamily="@font/inter_semibold"
                            android:layout_marginEnd="@dimen/dp20"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:id="@+id/bookmark_subject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp12"
                            android:lines="2"
                            android:fontFamily="@font/inter_semibold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/shareCurrentAffair"
                            android:padding="6dp"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp40"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginLeft="@dimen/dp8"
                            android:layout_marginBottom="@dimen/dp8"
                            android:src="0x7f080613"
                            android:layout_alignParentBottom="true"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/bookmark_image"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp100"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_weight="2.5"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_bookmark"
                android:layout_alignParentRight="true"
                app:tint="@color/colorPrimary"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
