<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/itemLL"
        android:background="@drawable/bg_mcq_unselected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp8">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/viewCenterDetails"
                android:padding="@dimen/dp4"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="@dimen/dp4"
                android:src="@drawable/add_button"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linearLayout3"
                android:padding="@dimen/dp6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="4">
                <TextView
                    android:textSize="@dimen/dimen_14dp"
                    android:textColor="@color/light_gray"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/timeTableTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"/>
                <View
                    android:background="#ccc"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="26dp"/>
                <TextView
                    android:textSize="@dimen/dimen_14dp"
                    android:textColor="@color/light_gray"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/timeTableDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_weight="1.5"
                    android:fontFamily="@font/inter_medium"/>
                <View
                    android:background="#ccc"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="26dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:paddingStart="@dimen/dp4">
                    <TextView
                        android:textSize="@dimen/dimen_14dp"
                        android:textColor="@color/light_gray"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/timeTableTeacherCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/courseTimeTableview"
            android:background="#ccc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"
            android:layout_marginStart="@dimen/dp20"
            android:layout_marginEnd="@dimen/dp20"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/centerDetailLL"
            android:padding="@dimen/dp6"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp2"
            android:layout_marginBottom="@dimen/dp2"
            android:weightSum="2">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/light_gray"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/centerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="@font/inter_medium"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/dp12"
                    android:textColor="@color/light_gray"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/courseName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/cancelRl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/itemLL">
        <View
            android:background="@color/notification_red"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp1"/>
        <TextView
            android:textSize="@dimen/dp8"
            android:textColor="@color/white"
            android:layout_gravity="end"
            android:id="@+id/batchCancel"
            android:background="@color/notification_red"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp2"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canceled"
            android:maxLines="1"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
