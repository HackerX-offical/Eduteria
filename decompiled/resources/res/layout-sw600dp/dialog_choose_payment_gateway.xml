<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#33000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/background_rectangle"
        android:padding="@dimen/dp8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/sp18"
            android:textColor="@color/colorPrimary"
            android:layout_gravity="center_horizontal"
            android:padding="@dimen/dp5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Payment Mode"
            android:textAlignment="center"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dimen_96dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_paymentMode"
                android:layout_width="@dimen/dp256"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp4"
                android:paddingEnd="@dimen/dp4"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/dp15"
                android:textColor="@color/colorPrimary"
                android:layout_gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/common_btn_unselected"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp10"
                android:text="@string/cancel"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <Button
                android:textSize="@dimen/dp15"
                android:textColor="@color/commonBtnTextColor"
                android:layout_gravity="center"
                android:id="@+id/btn_submit"
                android:background="@drawable/common_round_corners_button_drawable"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginRight="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp10"
                android:text="@string/ok"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
