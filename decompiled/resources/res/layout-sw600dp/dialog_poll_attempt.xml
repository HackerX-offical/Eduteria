<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outer_touch_area"
    android:background="@color/fully_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/mainlayout"
        android:layout_width="400dp"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:background="@drawable/round_white_bg_poll"
            android:padding="@dimen/dp10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:id="@+id/pollRL"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <androidx.core.widget.NestedScrollView
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">
                    <RelativeLayout
                        android:layout_gravity="top|center_horizontal"
                        android:id="@+id/pollDrag"
                        android:paddingTop="@dimen/dp24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/topHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp16"
                            android:paddingHorizontal="@dimen/dp12">
                            <TextView
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:id="@+id/pollTypeTxt"
                                android:background="@drawable/common_round_corners_button_drawable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quiz"
                                android:layout_centerVertical="true"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_semibold"
                                android:textAlignment="center"
                                android:layout_alignParentStart="true"
                                android:paddingHorizontal="@dimen/dp12"/>
                            <TextView
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:id="@+id/pollTime"
                                android:background="@drawable/bg_round_corner_fill_green_curved"
                                android:padding="@dimen/dp7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/inter_medium"
                                android:layout_alignParentEnd="true"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:textStyle="bold"
                            android:textColor="#405461"
                            android:gravity="center"
                            android:id="@+id/txtQues"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:layout_below="@+id/topHeader"
                            android:fontFamily="@font/inter_semibold"
                            android:layout_marginVertical="@dimen/dp6"/>
                        <RelativeLayout
                            android:id="@+id/quesLL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/txtQues">
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/cvrQuestions"
                                android:background="@color/white"
                                android:padding="@dimen/dp2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <include
                                    android:id="@+id/typeA"
                                    layout="@layout/layout_item_poll_questions_next_toppers"/>
                                <include
                                    android:id="@+id/typeB"
                                    layout="@layout/layout_item_poll_questions_next_toppers"/>
                                <include
                                    android:id="@+id/typeC"
                                    layout="@layout/layout_item_poll_questions_next_toppers"/>
                                <include
                                    android:id="@+id/typeD"
                                    layout="@layout/layout_item_poll_questions_next_toppers"/>
                            </LinearLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:padding="@dimen/dp8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/quesLL"
                            android:layout_centerHorizontal="true"
                            android:paddingVertical="@dimen/dp12">
                            <Button
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:id="@+id/submit"
                                android:background="@drawable/common_round_corners_button_drawable"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp28"
                                android:layout_marginTop="@dimen/dp12"
                                android:text="@string/submit"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_semibold"
                                android:layout_marginHorizontal="@dimen/dp4"
                                android:paddingHorizontal="20dp"/>
                            <Button
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:id="@+id/resultBtn"
                                android:background="@drawable/common_round_corners_button_drawable"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp28"
                                android:layout_marginTop="@dimen/dp12"
                                android:text="@string/result"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_semibold"
                                android:layout_marginHorizontal="@dimen/dp4"
                                android:paddingHorizontal="20dp"/>
                            <Button
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:id="@+id/leaderBoardBtn"
                                android:background="@drawable/common_round_corners_button_drawable"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp28"
                                android:layout_marginTop="@dimen/dp12"
                                android:text="@string/leaderboard"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_semibold"
                                android:layout_marginHorizontal="@dimen/dp4"
                                android:paddingHorizontal="20dp"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.core.widget.NestedScrollView>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/leaderboardRL"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <androidx.core.widget.NestedScrollView
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">
                    <RelativeLayout
                        android:layout_gravity="top|center_horizontal"
                        android:id="@+id/leaderboardDrag"
                        android:paddingTop="@dimen/dp24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:gravity="center_horizontal"
                            android:id="@+id/layout1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/my_image_icon"
                                android:layout_width="23dp"
                                android:layout_height="23dp"
                                android:layout_marginTop="35dp"
                                android:src="@drawable/two"
                                android:layout_marginStart="70dp"
                                android:layout_alignStart="@+id/cardView1"
                                android:elevation="6dp"/>
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardView1"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginTop="45dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginStart="90dp"
                                android:layout_alignParentStart="true"
                                android:elevation="4dp"
                                app:cardCornerRadius="7dp">
                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:src="@drawable/user_pic"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="#373737"
                                        android:ellipsize="end"
                                        android:layout_gravity="center"
                                        android:id="@+id/student1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sneha Singh"
                                        android:maxLines="2"
                                        android:textAlignment="center"/>
                                    <TextView
                                        android:textSize="9sp"
                                        android:textColor="#7c7c7c"
                                        android:id="@+id/studentOne"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Student"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/one"
                                android:layout_marginStart="95dp"
                                android:layout_alignStart="@+id/cardView2"
                                android:elevation="6dp"/>
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardView2"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_marginTop="15dp"
                                android:layout_marginBottom="2dp"
                                android:layout_toEndOf="@+id/cardView1"
                                android:elevation="4dp"
                                android:layout_marginHorizontal="20dp"
                                app:cardCornerRadius="7dp">
                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:layout_width="62dp"
                                        android:layout_height="62dp"
                                        android:src="@drawable/user_pic"/>
                                    <TextView
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="#373737"
                                        android:ellipsize="end"
                                        android:layout_gravity="center"
                                        android:id="@+id/student2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sneha Singh"
                                        android:maxLines="2"
                                        android:textAlignment="center"/>
                                    <TextView
                                        android:textSize="11sp"
                                        android:textColor="#7c7c7c"
                                        android:id="@+id/studentTwo"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Student"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                            <ImageView
                                android:layout_width="23dp"
                                android:layout_height="23dp"
                                android:layout_marginTop="33dp"
                                android:src="@drawable/three"
                                android:layout_marginStart="70dp"
                                android:layout_alignStart="@+id/cardView3"
                                android:elevation="6dp"/>
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardView3"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginTop="45dp"
                                android:layout_marginBottom="2dp"
                                android:layout_marginEnd="100dp"
                                android:layout_toEndOf="@+id/cardView2"
                                android:elevation="4dp"
                                app:cardCornerRadius="7dp">
                                <LinearLayout
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:layout_width="48dp"
                                        android:layout_height="48dp"
                                        android:src="@drawable/objects_img"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="#373737"
                                        android:ellipsize="end"
                                        android:layout_gravity="center"
                                        android:id="@+id/student3"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Sneha Singh"
                                        android:maxLines="2"
                                        android:textAlignment="center"/>
                                    <TextView
                                        android:textSize="9sp"
                                        android:textColor="#7c7c7c"
                                        android:id="@+id/studentThree"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Student"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:gravity="center_vertical"
                            android:id="@+id/layout2"
                            android:background="@drawable/shape"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="20dp"
                            android:layout_below="@+id/layout1">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="20dp">
                                <RelativeLayout
                                    android:id="@+id/RlStart"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentStart="true">
                                    <LinearLayout
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:textColor="@color/colorPrimary"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Rank"/>
                                        <ImageView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:src="@drawable/shape1_line"
                                            android:layout_marginStart="34dp"/>
                                    </LinearLayout>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true">
                                    <TextView
                                        android:textColor="@color/colorPrimary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Name"/>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:id="@+id/RlEnd"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentEnd="true">
                                    <LinearLayout
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content">
                                        <ImageView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:src="@drawable/shape1_line"
                                            android:layout_marginEnd="34dp"/>
                                        <TextView
                                            android:textColor="@color/colorPrimary"
                                            android:id="@+id/time"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Time"/>
                                    </LinearLayout>
                                </RelativeLayout>
                            </RelativeLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/layout4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="5dp"
                            android:layout_below="@+id/layout2">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recyclerViewRank"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:gravity="center_vertical"
                                android:id="@+id/layout3"
                                android:background="@drawable/shape1"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginHorizontal="20dp">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="20dp">
                                    <RelativeLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:layout_alignParentStart="true">
                                        <LinearLayout
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <TextView
                                                android:textColor="@color/white"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="25th"/>
                                            <ImageView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:src="@drawable/shape2_line"
                                                android:layout_marginStart="38dp"/>
                                        </LinearLayout>
                                    </RelativeLayout>
                                    <RelativeLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true">
                                        <LinearLayout
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:layout_width="25dp"
                                                android:layout_height="25dp"
                                                android:src="@drawable/user_pic"/>
                                            <TextView
                                                android:textColor="@color/white"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="You"
                                                android:layout_marginStart="10dp"/>
                                        </LinearLayout>
                                    </RelativeLayout>
                                    <RelativeLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerVertical="true"
                                        android:layout_alignParentEnd="true">
                                        <LinearLayout
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content">
                                            <ImageView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:src="@drawable/shape2_line"
                                                android:layout_marginEnd="50dp"/>
                                            <TextView
                                                android:textColor="@color/white"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="10/1 "/>
                                        </LinearLayout>
                                    </RelativeLayout>
                                </RelativeLayout>
                            </RelativeLayout>
                            <RelativeLayout
                                android:id="@+id/RelPollRank"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="10dp">
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recyclerViewPollRank"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"/>
                            </RelativeLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:padding="@dimen/dp8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/layout4"
                            android:layout_centerHorizontal="true"
                            android:paddingVertical="@dimen/dp12">
                            <Button
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:id="@+id/resultBtnTwo"
                                android:background="@drawable/common_round_corners_button_drawable"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/dp28"
                                android:layout_marginTop="@dimen/dp12"
                                android:text="@string/result"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_semibold"
                                android:layout_marginHorizontal="@dimen/dp4"
                                android:paddingHorizontal="20dp"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.core.widget.NestedScrollView>
            </RelativeLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/ivClose"
            android:padding="@dimen/dp4"
            android:visibility="gone"
            android:layout_width="@dimen/dp30"
            android:layout_height="@dimen/dp30"
            android:layout_marginTop="10dp"
            android:src="0x7f0801f8"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
