<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="8dp">
    <LinearLayout
        android:id="@+id/maiView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageBanner"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:src="@mipmap/square_placeholder_new"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/soldOutImg"
                android:background="#4d000000"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="30sp"
                    android:textColor="#d32f2f"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sold_out_stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sold_out"
                    android:rotation="-15"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="0.1"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/black"
                android:id="@+id/courseTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/loading"
                android:layout_marginStart="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageBanner"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/validityRowId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/courseTitle">
                <TextView
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Validity: "
                    android:drawablePadding="6dp"
                    android:layout_marginStart="14dp"
                    android:drawableTint="@color/colorPrimary"
                    app:drawableStartCompat="@drawable/ic_calender"/>
                <TextView
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/validity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    android:drawablePadding="6dp"
                    android:layout_marginEnd="14dp"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="#e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginHorizontal="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/validityRowId"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/price_linear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/paidCourseLay"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:id="@+id/price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00.00"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textAlignment="textEnd"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/gray_dark2"
                        android:id="@+id/originalPrice"
                        android:paddingLeft="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textAlignment="textStart"
                        android:layout_marginStart="4dp"/>
                    <RelativeLayout
                        android:id="@+id/discountRL"
                        android:background="@drawable/discount_bg"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="15sp">
                        <TextView
                            android:textColor="@color/colorPrimary"
                            android:id="@+id/discount"
                            android:padding="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 %"
                            android:layout_marginHorizontal="5dp"/>
                    </RelativeLayout>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/freeCourseText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free for Students"/>
            </LinearLayout>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/price_linear">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/exploreId"
                    android:background="@drawable/discount_light_bg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:minHeight="0dp"
                    android:text="Explore"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:textAlignment="center"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="10dp"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:id="@+id/buyNowId"
                    android:background="@drawable/discount_solid_bg"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:minHeight="0dp"
                    android:text="BUY NOW"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:layout_marginEnd="10dp"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:id="@+id/addToLib"
                    android:background="@drawable/discount_solid_bg"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:minHeight="0dp"
                    android:text="Add to Library"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:layout_marginEnd="10dp"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="10dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
