<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:tag="layout-sw600dp/enter_fib_layout_0"
    android:padding="@dimen/dp10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_dialogbox"
        android:padding="@dimen/dp10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp180"
        android:layout_margin="@dimen/dp10"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10">
        <EditText
            android:textSize="@dimen/sp17"
            android:textColor="@color/country_code_text_color"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:hint="@string/enter_answer"
            android:inputType="number"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp25"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp50"
            android:layout_marginTop="@dimen/dp15"
            android:layout_marginRight="@dimen/dp50"
            android:weightSum="2">
            <Button
                android:textSize="@dimen/sp17"
                android:textColor="@color/commonBtnTextColor"
                android:id="@+id/btn_submit"
                android:background="@drawable/common_round_corners_button_drawable"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp40"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginRight="@dimen/dp20"
                android:text="@string/submit"
                android:layout_weight="0.8"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
