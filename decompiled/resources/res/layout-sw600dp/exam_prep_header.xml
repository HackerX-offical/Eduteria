<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerLL"
    android:background="@color/colorPrimaryDark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/imageRL"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp12"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12"
                app:cardBackgroundColor="@color/background_all"
                app:cardCornerRadius="@dimen/dp5"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/courseImagebg"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@mipmap/square_placeholder"
                            android:scaleType="fitXY"
                            app:layout_constraintDimensionRatio="H,13:7"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <FrameLayout
                            android:id="@+id/soldOutImg"
                            android:background="#4d000000"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:scaleType="fitXY"
                            app:layout_constraintBottom_toBottomOf="@+id/courseImagebg"
                            app:layout_constraintEnd_toEndOf="@+id/courseImagebg"
                            app:layout_constraintStart_toStartOf="@+id/courseImagebg"
                            app:layout_constraintTop_toTopOf="@+id/courseImagebg">
                            <TextView
                                android:textSize="30sp"
                                android:textColor="#d32f2f"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_sold_out_stamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sold_out"
                                android:rotation="-15"
                                android:fontFamily="@font/inter_bold"
                                android:letterSpacing="0.1"/>
                        </FrameLayout>
                        <LinearLayout
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:id="@+id/ll_scholorship_discount"
                            android:background="@color/white"
                            android:paddingTop="@dimen/dp8"
                            android:paddingBottom="@dimen/dp8"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/dp6"
                            android:paddingEnd="@dimen/dp6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/courseImagebg">
                            <ImageView
                                android:layout_width="@dimen/dp18"
                                android:layout_height="@dimen/dp18"
                                android:src="@drawable/discount_red_img"
                                android:layout_marginEnd="@dimen/dp6"/>
                            <TextView
                                android:textSize="@dimen/sp14"
                                android:textColor="#f44336"
                                android:id="@+id/scholarshipCouponTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20% Scholarship discount is applied."
                                android:includeFontPadding="false"
                                android:fontFamily="@font/inter_medium"/>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_compat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp12">
                <TextView
                    android:textSize="@dimen/dp20"
                    android:textColor="@color/white"
                    android:id="@+id/course_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/inter_medium"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/authorname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:textSize="@dimen/dp14"
                    android:textColor="@color/white"
                    android:id="@+id/validityTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/inter_regular"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/round_corner_border_course_detail"
                android:paddingTop="@dimen/dp8"
                android:paddingBottom="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="@dimen/dp240"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp16"
                android:weightSum="2">
                <LinearLayout
                    android:gravity="top|center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:id="@+id/courseid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1234"
                        android:fontFamily="@font/inter_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top|center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type"
                        android:fontFamily="@font/amazon_ember_rg"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:id="@+id/type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="online course"
                        android:fontFamily="@font/amazon_ember_rg"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/newBuyNewButtonLL"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@color/colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="3">
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/demoVideoLL"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp4"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp2"
                            app:cardCornerRadius="@dimen/dp4"
                            app:cardElevation="@dimen/dp4">
                            <LinearLayout
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:paddingTop="@dimen/dp4"
                                android:paddingBottom="@dimen/dp4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/dp14"
                                android:paddingEnd="@dimen/dp14">
                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/video_solution"
                                    app:tint="@color/colorPrimary"/>
                                <TextView
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:id="@+id/headVideo_TV"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp3"
                                    android:text="Demo Videos"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/syllabusLL"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp4"
                            android:layout_marginStart="@dimen/dp2"
                            android:layout_marginEnd="@dimen/dp2"
                            app:cardCornerRadius="@dimen/dp4"
                            app:cardElevation="@dimen/dp4">
                            <LinearLayout
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:paddingTop="@dimen/dp4"
                                android:paddingBottom="@dimen/dp4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/dp14"
                                android:paddingEnd="@dimen/dp14">
                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/syllabus_icon"
                                    app:tint="@color/colorPrimary"/>
                                <TextView
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:id="@+id/headSyllabus_TV"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp3"
                                    android:text="Syllabus"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/rateYouLL"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp4"
                            android:layout_marginStart="@dimen/dp2"
                            android:layout_marginEnd="@dimen/dp4"
                            app:cardCornerRadius="@dimen/dp4"
                            app:cardElevation="@dimen/dp4">
                            <LinearLayout
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:paddingTop="@dimen/dp4"
                                android:paddingBottom="@dimen/dp4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="@dimen/dp14"
                                android:paddingEnd="@dimen/dp14">
                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/fev_icon"
                                    app:tint="@color/colorPrimary"/>
                                <TextView
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:layout_gravity="center"
                                    android:id="@+id/ratingCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp3"
                                    android:text="0"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/buyNowButton_RL"
                    android:background="@drawable/primary_bg_round"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp50"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_marginBottom="@dimen/dp10"
                    android:backgroundTint="@color/colorPrimary"
                    android:layout_marginHorizontal="@dimen/dp8">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginHorizontal="@dimen/dp8">
                        <TextView
                            android:textColor="@color/white"
                            android:id="@+id/buyNow_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buy Now"
                            android:layout_marginEnd="@dimen/dp10"/>
                        <TextView
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/buyNow_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs."/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/rounded_corners_course_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tileRv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp8"
                android:layout_marginRight="@dimen/dp8"/>
            <include layout="@layout/no_data_found"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
