<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/ibt_single_sub_vd_RL"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/study_single_itemLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/imageRlCover"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp70"
                android:layout_margin="@dimen/dp10"
                app:cardCornerRadius="@dimen/dp10">
                <RelativeLayout
                    android:id="@+id/imageRL"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/imageIV"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@mipmap/pdf"
                        android:scaleType="fitXY"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/share"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:src="0x7f080613"
                android:layout_below="@+id/imageRlCover"
                android:paddingStart="@dimen/dp5"
                android:paddingEnd="@dimen/dp5"
                android:layout_alignParentEnd="true"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp80"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginRight="@dimen/dp6"
                android:layout_toRightOf="@+id/imageRlCover">
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="end"
                    android:id="@+id/examPrepTitleTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp50"
                    android:hint="@string/my_exam_selection"
                    android:maxLines="3"
                    android:layout_alignParentTop="true"
                    android:fontFamily="@font/amazon_ember_bd"/>
                <ImageView
                    android:id="@+id/arrowIV"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp6"
                    android:src="@mipmap/forward_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cvrReadorLive"
                android:paddingRight="@dimen/dp8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/liveIV"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/live"/>
                <RelativeLayout
                    android:id="@+id/lockRL"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp4"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/dp10"
                    android:paddingEnd="@dimen/dp10"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@mipmap/gray_lock"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/forwardIV"
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:src="@mipmap/forward_black"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/read_now"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp7"
                    android:paddingBottom="@dimen/dp7"
                    android:focusable="true"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp2"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="@string/read"
                    android:includeFontPadding="false"
                    android:layout_below="@+id/imageRL"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp7"
                    android:paddingEnd="@dimen/dp7"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <include layout="@layout/no_data_found"/>
</RelativeLayout>
