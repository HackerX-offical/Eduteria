<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/ibt_single_sub_vd_RL"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/study_single_itemLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5"
                    app:cardCornerRadius="@dimen/dp10"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp">
                    <RelativeLayout
                        android:layout_width="@dimen/dp100"
                        android:layout_height="@dimen/dp70">
                        <ImageView
                            android:id="@+id/ibt_single_sub_vd_iv"
                            android:layout_width="@dimen/dp100"
                            android:layout_height="@dimen/dp70"
                            android:src="@mipmap/placeholder"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/liveIV"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp35"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/live"
                            android:tint="@color/white"
                            android:layout_alignParentStart="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <RelativeLayout
                    android:id="@+id/data_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp60"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="@dimen/dp2"
                    android:layout_toEndOf="@+id/card">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textStyle="normal"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/ibt_single_sub_vd_tv_title"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:text="dwklvnwljdvbjkwvbwkjvbjkwvbjkwvbkjwev jkwe vjkwe vjkwe vjkwe vjwev jwqbov wqo vbvwebvujkewbvewbvwuebveiwqvbweiuvbiuwevbuivbweuviwuvvbweviwuevuiwbevuivbweviwv"
                        android:maxLines="3"
                        android:includeFontPadding="false"
                        android:layout_alignParentTop="true"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:layout_toStartOf="@+id/l1"/>
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/durationTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="@dimen/dp2"
                        android:layout_marginBottom="@dimen/dp4"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:layout_below="@+id/ibt_single_sub_vd_tv_title"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:layout_toStartOf="@+id/l1"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/l1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/optionMenuImgView"
                            android:background="@android:color/transparent"
                            android:focusable="true"
                            android:visibility="gone"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp40"
                            android:scaleType="center"
                            android:layout_alignParentTop="true"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"
                            android:layout_alignParentEnd="true"/>
                        <RelativeLayout
                            android:orientation="vertical"
                            android:id="@+id/lockRL"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"
                            android:layout_alignParentEnd="true">
                            <ImageView
                                android:layout_width="@dimen/dp24"
                                android:layout_height="@dimen/dp24"
                                android:src="@mipmap/gray_lock"
                                android:layout_centerInParent="true"/>
                        </RelativeLayout>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/LogsLL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp4"
                    android:layout_below="@+id/card">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:text="@string/class_duration"
                            android:maxLines="1"
                            android:fontFamily="@font/amazon_ember_bd"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:maxLines="1"
                            android:fontFamily="@font/amazon_ember_bd"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:text="@string/total_view_time"
                            android:maxLines="1"
                            android:fontFamily="@font/amazon_ember_bd"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/total_view_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:maxLines="1"
                            android:fontFamily="@font/amazon_ember_bd"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:text="@string/remaining_time"
                            android:maxLines="1"
                            android:fontFamily="@font/amazon_ember_bd"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:textColor="@color/colorPrimary"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/remaining_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:layout_marginBottom="@dimen/dp3"
                            android:maxLines="1"
                            android:fontFamily="@font/amazon_ember_bd"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/realte"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginLeft="@dimen/dp8"
                    android:layout_below="@+id/LogsLL">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/watch_now"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="@dimen/dp5"
                        android:paddingBottom="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp5"
                        android:text="@string/watch"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:paddingStart="@dimen/dp5"
                        android:paddingEnd="@dimen/dp5"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/listne_now"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="@dimen/dp5"
                        android:paddingBottom="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp5"
                        android:text="@string/listen"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:paddingStart="@dimen/dp5"
                        android:paddingEnd="@dimen/dp5"
                        android:layout_toEndOf="@+id/watch_now"/>
                    <ImageView
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/share"
                        android:paddingTop="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:src="0x7f080613"
                        android:includeFontPadding="false"
                        android:paddingStart="@dimen/dp5"
                        android:paddingEnd="@dimen/dp5"
                        android:layout_alignParentEnd="true"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/read_now"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="@dimen/dp5"
                        android:paddingBottom="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp5"
                        android:text="@string/read"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:paddingStart="@dimen/dp5"
                        android:paddingEnd="@dimen/dp5"
                        android:layout_toEndOf="@+id/listne_now"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/attemptLL"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp5">
                        <TextView
                            android:textSize="@dimen/sp12"
                            android:textColor="@color/country_code_text_color"
                            android:ellipsize="end"
                            android:gravity="bottom"
                            android:layout_gravity="center_vertical"
                            android:padding="@dimen/dp5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attempt_now"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/amazon_ember_bd"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/learn"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="@dimen/dp5"
                        android:paddingBottom="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp5"
                        android:text="@string/learn"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:paddingStart="@dimen/dp5"
                        android:paddingEnd="@dimen/dp5"
                        android:layout_toEndOf="@+id/attemptLL"/>
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:gravity="center_vertical"
                        android:id="@+id/practice"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="@dimen/dp5"
                        android:paddingBottom="@dimen/dp5"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp30"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp5"
                        android:text="@string/practice"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:paddingStart="@dimen/dp5"
                        android:paddingEnd="@dimen/dp5"
                        android:layout_toEndOf="@+id/learn"/>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/subjectBTNLL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/card">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4">
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/paper"
                            android:background="@drawable/primary_bg_round"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/paper"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/booklet"
                            android:background="@drawable/primary_bg_round"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/booklet"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4">
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/upload"
                            android:background="@drawable/primary_bg_round"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/upload"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/marks"
                            android:background="@drawable/bg_round_corner_fill_green_curved"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/marks"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/sp11"
                android:textColor="@color/blue"
                android:id="@+id/messageTV"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download"
                android:textAlignment="textStart"
                android:layout_marginStart="@dimen/dp5"
                android:layout_marginEnd="@dimen/dp5"/>
            <ProgressBar
                android:id="@+id/downloadprogess"
                android:background="@color/white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp5"
                android:maxHeight="@dimen/dp20"
                android:indeterminate="false"
                android:minHeight="@dimen/dp7"
                android:scaleY="3"
                android:layout_marginStart="@dimen/dp5"
                android:layout_marginEnd="@dimen/dp5"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
