<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="#a6000000"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp90"
    android:layoutDirection="ltr">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/exo_prev"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton.Previous"/>
        <ImageButton
            android:id="@+id/exo_rew"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton.Rewind"/>
        <ImageButton
            android:id="@+id/exo_repeat_toggle"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton"/>
        <ImageButton
            android:id="@+id/exo_play"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton.Play"/>
        <ImageButton
            android:id="@+id/exo_pause"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton.Pause"/>
        <ImageButton
            android:id="@+id/exo_ffwd"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton.FastForward"/>
        <ImageButton
            android:id="@+id/exo_next"
            app:tint="@color/colorPrimary"
            style="@style/ExoMediaButton.Next"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/exo_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_weight="0.1"
            android:letterSpacing="-0.02"/>
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            app:bar_height="8dp"
            app:buffered_color="#4dd8d8d8"
            app:played_color="@color/white"
            app:scrubber_color="@color/white"
            app:unplayed_color="#4dd8d8d8"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/pixel_rate"
            android:background="@drawable/drwble_txt_red"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:text="1x"
            android:layout_weight="0.1"/>
        <ImageView
            android:id="@+id/img_zoomIn"
            android:padding="@dimen/dp5"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/exo_controls_fullscreen_enter"
            android:layout_weight="0.1"/>
        <ImageView
            android:id="@+id/img_zoomOut"
            android:padding="@dimen/dp5"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/exo_controls_fullscreen_exit"
            android:layout_weight="0.1"/>
    </LinearLayout>
</LinearLayout>
