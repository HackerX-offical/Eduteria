<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize">
            <ImageView
                android:id="@+id/iv_back"
                android:padding="@dimen/dp10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:src="0x7f080399"
                android:layout_centerVertical="true"
                app:tint="@color/black"/>
        </RelativeLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/image"
            android:background="@drawable/reset_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/sp18"
            android:textColor="@color/color_071E57"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/change_password"
            android:fontFamily="@font/inter_bold"/>
        <TextView
            android:textSize="@dimen/sp15"
            android:textColor="@color/black_405461"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="@dimen/dp16"
            android:layout_marginRight="@dimen/dp22"
            android:layout_marginBottom="20dp"
            android:text="@string/reset_password"
            android:fontFamily="@font/inter_regular"
            android:letterSpacing="0.01"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp20">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20">
                    <TextView
                        android:textSize="@dimen/post_text_size"
                        android:textColor="@color/colorWhite"
                        android:gravity="start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/change_pass_txt"
                        android:fontFamily="@font/inter_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_marginRight="20dp"
                    android:layout_below="@+id/ll1"
                    android:layout_centerVertical="true">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/app_eye_color">
                        <EditText
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/black_405461"
                            android:id="@+id/newpasswordET"
                            android:background="@drawable/round_corner_border_login_signup"
                            android:paddingLeft="@dimen/dp10"
                            android:paddingTop="@dimen/dp16"
                            android:paddingRight="@dimen/dp10"
                            android:paddingBottom="@dimen/dp16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/changepassowrd_new_password"
                            android:cursorVisible="true"
                            android:drawablePadding="15dp"
                            android:inputType="textPassword"
                            android:textCursorDrawable="@null"
                            android:drawableStart="@mipmap/lock"
                            android:fontFamily="@font/inter_medium"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/app_eye_color">
                        <EditText
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/color_071E57"
                            android:id="@+id/retrypasswordET"
                            android:background="@drawable/round_corner_border_login_signup"
                            android:paddingLeft="@dimen/dp10"
                            android:paddingTop="@dimen/dp16"
                            android:paddingRight="@dimen/dp10"
                            android:paddingBottom="@dimen/dp16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp12"
                            android:hint="@string/changepassowrd_retype_password"
                            android:cursorVisible="true"
                            android:drawablePadding="15dp"
                            android:inputType="textPassword"
                            android:textCursorDrawable="@null"
                            android:drawableStart="@mipmap/lock"
                            android:fontFamily="@font/inter_medium"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <Button
                        android:textSize="@dimen/post_text_size_x"
                        android:textStyle="bold"
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/submitBtn"
                        android:background="@drawable/common_round_corners_button_drawable"
                        android:paddingTop="@dimen/dp8"
                        android:paddingBottom="@dimen/dp8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="35dp"
                        android:layout_marginBottom="35dp"
                        android:text="@string/submit"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_medium"
                        android:textAlignment="center"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
