<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:background="@color/white"
        android:paddingBottom="@dimen/dp12"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/parent_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/logoImageLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp10"
                    app:cardCornerRadius="@dimen/dp8">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/imageRL"
                        android:background="@drawable/rounded_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/courseImageIcon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginTop="0dp"
                            android:scaleType="fitXY"
                            android:layout_marginStart="0dp"
                            android:layout_marginEnd="0dp"
                            app:layout_constraintDimensionRatio="H,16:9"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@mipmap/placeholder"/>
                        <ImageView
                            android:id="@+id/liveIV"
                            android:padding="@dimen/dp2"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/live"
                            android:scaleType="fitXY"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp15"
                android:layout_below="@+id/logoImageLL">
                <TextView
                    android:textSize="@dimen/sp20"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:id="@+id/course_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_marginStart="@dimen/dp15"
                    android:layout_marginEnd="@dimen/dp15"
                    android:layout_toStartOf="@+id/share"/>
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/ibt_single_vd_tv_day"
                    android:paddingTop="@dimen/dp2"
                    android:paddingBottom="@dimen/dp2"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:layout_below="@+id/course_name"
                    android:layout_marginStart="@dimen/dp15"
                    android:layout_marginEnd="@dimen/dp15"/>
                <ImageView
                    android:id="@+id/share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:src="0x7f080613"
                    android:layout_marginStart="@dimen/dp15"
                    android:layout_marginEnd="@dimen/dp15"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="#8a000000"
                    android:id="@+id/course_start_date"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Course Begins : 3 Aug 2020"
                    android:layout_below="@+id/ibt_single_vd_tv_day"
                    android:layout_marginStart="@dimen/dp15"
                    android:layout_marginEnd="@dimen/dp15"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/tagsrecyclerview"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:layout_below="@+id/course_start_date"
                    android:layout_marginStart="@dimen/dp15"
                    android:layout_marginEnd="@dimen/dp15"
                    app:layoutManager="LinearLayoutManager"/>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nestedScroll_dashboard"
                    android:fitsSystemWindows="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp10"
                    android:fillViewport="true"
                    android:layout_below="@+id/tagsrecyclerview">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:orientation="vertical"
                            android:id="@+id/course_intro_layout"
                            android:paddingBottom="@dimen/dp12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/dp10"
                            android:paddingStart="@dimen/dp10"
                            android:paddingEnd="@dimen/dp10">
                            <RelativeLayout
                                android:gravity="center_vertical"
                                android:id="@+id/intro_layout"
                                android:background="@drawable/bg_course_inro_gray"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp10">
                                <ImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/info_icon"
                                    android:layout_width="55dp"
                                    android:layout_height="@dimen/dp55"
                                    android:layout_marginTop="@dimen/dp7"
                                    android:layout_marginBottom="@dimen/dp7"
                                    android:src="@mipmap/help"
                                    android:layout_centerVertical="true"
                                    android:paddingStart="@dimen/dp12"
                                    android:paddingEnd="@dimen/dp5"/>
                                <TextView
                                    android:textSize="@dimen/sp15"
                                    android:textStyle="bold"
                                    android:textColor="@color/black"
                                    android:id="@+id/course_intro"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp8"
                                    android:layout_marginTop="@dimen/dp16"
                                    android:text="Course Introduction"
                                    android:layout_toRightOf="@+id/info_icon"
                                    android:layout_centerVertical="true"
                                    android:fontFamily="@font/inter_bold"/>
                                <ImageView
                                    android:id="@+id/hide_img_data"
                                    android:padding="3dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp16"
                                    android:src="@drawable/down_arrow_black"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentEnd="true"/>
                                <ImageView
                                    android:id="@+id/show_img_data"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/dp16"
                                    android:src="@drawable/up_arrow_black"
                                    android:layout_centerVertical="true"
                                    android:layout_alignParentEnd="true"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:id="@+id/course_data_view"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp10"
                                android:layout_below="@+id/intro_layout">
                                <WebView
                                    android:id="@+id/webViewDesc"
                                    android:scrollbars="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="true"/>
                                <TextView
                                    android:id="@+id/course_intro_text"
                                    android:visibility="gone"
                                    android:scrollbars="vertical"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="true"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/layout_feature_faq"
                            android:background="#f5f5f8"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:weightSum="2"
                            android:layout_below="@+id/course_intro_layout"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_marginEnd="@dimen/dp10">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/features"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/dp7"
                                android:layout_marginBottom="@dimen/dp7"
                                android:src="@mipmap/featurtes"
                                android:layout_weight="1"
                                android:paddingStart="@dimen/dp12"
                                android:paddingEnd="@dimen/dp5"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/faq"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/dp7"
                                android:layout_marginBottom="@dimen/dp7"
                                android:src="@mipmap/faq"
                                android:layout_weight="1"
                                android:paddingStart="@dimen/dp5"
                                android:paddingEnd="@dimen/dp12"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/asktous_ll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp12"
                            android:layout_marginBottom="@dimen/dp12"
                            android:layout_below="@+id/layout_feature_faq"
                            android:layout_marginStart="@dimen/dp12"
                            android:layout_marginEnd="@dimen/dp12"
                            android:elevation="@dimen/dp3">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/ask_to_us"
                                android:scaleType="fitXY"
                                android:layout_toRightOf="@+id/fbIV"/>
                            <Button
                                android:textColor="@color/white"
                                android:id="@+id/talktousBTN"
                                android:background="@drawable/bg_round_corners_button"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp12"
                                android:text="Ask to us"
                                style="@style/round_corner_button_style"/>
                        </LinearLayout>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:id="@+id/subscriptionSectionId"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp12"
                            android:layout_marginBottom="@dimen/dp12"
                            android:layout_below="@+id/asktous_ll"
                            android:layout_marginStart="@dimen/dp12"
                            android:layout_marginEnd="@dimen/dp12"
                            android:elevation="@dimen/dp3">
                            <TextView
                                android:textSize="@dimen/sp15"
                                android:textStyle="bold"
                                android:textColor="@color/black"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="30dp"
                                android:text="@string/select_your_subscription_plan"
                                android:fontFamily="@font/inter_bold"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="25dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/lightBlack"
                                        android:id="@+id/deliveryMethodText1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Delivery Method"
                                        android:layout_weight="0.5"
                                        android:fontFamily="@font/inter_medium"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/lightBlack"
                                        android:ellipsize="end"
                                        android:id="@+id/deliveryId1"
                                        android:background="@drawable/background_orange_circle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Android"
                                        android:maxLines="1"
                                        android:layout_weight="0.5"
                                        android:drawableEnd="@drawable/arrow_down"
                                        android:paddingStart="16dp"
                                        android:layout_alignParentEnd="true"
                                        android:paddingVertical="9dp"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="25dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/lightBlack"
                                        android:id="@+id/deliveryMethodText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Plan"
                                        android:layout_weight="0.5"
                                        android:fontFamily="@font/inter_medium"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/lightBlack"
                                        android:ellipsize="end"
                                        android:id="@+id/deliveryId"
                                        android:background="@drawable/background_orange_circle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Android"
                                        android:maxLines="1"
                                        android:layout_weight="0.5"
                                        android:drawableEnd="@drawable/arrow_down"
                                        android:paddingStart="16dp"
                                        android:layout_alignParentEnd="true"
                                        android:paddingVertical="9dp"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/lightBlack"
                                        android:id="@+id/validityText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Validity"
                                        android:layout_weight="0.5"
                                        android:layout_below="@+id/deliveryMethodText"
                                        android:fontFamily="@font/inter_medium"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="@color/lightBlack"
                                        android:ellipsize="end"
                                        android:id="@+id/validityId"
                                        android:background="@drawable/background_orange_circle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="12 months"
                                        android:maxLines="1"
                                        android:layout_weight="0.5"
                                        android:layout_below="@+id/deliveryId"
                                        android:drawableEnd="@drawable/arrow_down"
                                        android:paddingStart="16dp"
                                        android:layout_alignParentEnd="true"
                                        android:paddingVertical="9dp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/course_layout"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp110"
                            android:layout_marginTop="@dimen/dp10"
                            android:weightSum="2"
                            android:layout_below="@+id/subscriptionSectionId"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_marginEnd="@dimen/dp10">
                            <RelativeLayout
                                android:gravity="center"
                                android:id="@+id/course_content_layout"
                                android:background="@drawable/bg_round_corners_button"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:minHeight="@dimen/dp100"
                                android:layout_weight="1"
                                android:layout_marginEnd="6.5dp">
                                <TextView
                                    android:textSize="@dimen/sp14"
                                    android:textStyle="bold"
                                    android:textColor="@color/white"
                                    android:id="@+id/_course_content_txt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Course \10Contents"/>
                            </RelativeLayout>
                            <RelativeLayout
                                android:id="@+id/buy_now"
                                android:background="@drawable/bg_round_corners_button"
                                android:paddingBottom="@dimen/dp10"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:layout_marginStart="6.5dp">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp60">
                                    <TextView
                                        android:textSize="@dimen/sp13"
                                        android:textColor="#fff"
                                        android:ellipsize="end"
                                        android:gravity="start"
                                        android:id="@+id/cut_amount"
                                        android:visibility="gone"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_marginTop="@dimen/dp8"
                                        android:lines="1"
                                        android:layout_marginStart="@dimen/dp8"
                                        android:layout_marginEnd="@dimen/dp5"
                                        android:layout_toStartOf="@+id/add_gst"/>
                                    <TextView
                                        android:textSize="@dimen/sp16"
                                        android:textStyle="bold"
                                        android:textColor="#fff"
                                        android:ellipsize="end"
                                        android:gravity="center"
                                        android:id="@+id/price"
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/dp30"
                                        android:layout_marginTop="@dimen/dp30"
                                        android:lines="1"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginStart="@dimen/dp8"
                                        android:layout_marginEnd="@dimen/dp5"
                                        android:layout_toStartOf="@+id/add_gst"/>
                                    <TextView
                                        android:textSize="@dimen/sp14"
                                        android:textStyle="bold"
                                        android:textColor="#fff"
                                        android:gravity="center"
                                        android:id="@+id/add_ingst"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="@dimen/dp60"
                                        android:text="GST \10 Inclusive"
                                        android:layout_marginEnd="@dimen/dp10"
                                        android:layout_alignParentEnd="true"/>
                                    <TextView
                                        android:textSize="@dimen/sp14"
                                        android:textStyle="bold"
                                        android:textColor="#fff"
                                        android:gravity="center"
                                        android:id="@+id/add_gst"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="@dimen/dp60"
                                        android:text="+ GST"
                                        android:layout_marginEnd="@dimen/dp20"
                                        android:layout_alignParentEnd="true"/>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:id="@+id/buy_now_layout"
                                    android:background="@drawable/rounded_bg"
                                    android:paddingTop="@dimen/dp8"
                                    android:paddingBottom="@dimen/dp8"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_alignParentBottom="true"
                                    android:layout_centerHorizontal="true"
                                    android:paddingStart="@dimen/dp30"
                                    android:paddingEnd="@dimen/dp30">
                                    <TextView
                                        android:textSize="@dimen/sp16"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:id="@+id/txt_button"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Buy Now"/>
                                </RelativeLayout>
                                <RelativeLayout
                                    android:gravity="center"
                                    android:id="@+id/purchased_layout"
                                    android:background="@drawable/rounded_bg"
                                    android:paddingTop="@dimen/dp8"
                                    android:paddingBottom="@dimen/dp8"
                                    android:visibility="gone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:layout_centerInParent="true"
                                    android:layout_centerHorizontal="true"
                                    android:paddingStart="@dimen/dp30"
                                    android:paddingEnd="@dimen/dp30">
                                    <TextView
                                        android:textSize="@dimen/sp14"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:gravity="center"
                                        android:id="@+id/purchased_layout_button"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Purchased"/>
                                </RelativeLayout>
                            </RelativeLayout>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.core.widget.NestedScrollView>
            </RelativeLayout>
        </RelativeLayout>
        <include
            android:id="@+id/no_data_fond"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/no_data_found"/>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
