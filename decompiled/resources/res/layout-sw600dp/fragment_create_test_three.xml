<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:id="@+id/parentLL"
        android:paddingTop="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/lltop"
            android:background="@drawable/bg_round_corners_test_create_three"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp24">
            <TextView
                android:textSize="@dimen/post_text_size"
                android:textColor="@color/whiteApp"
                android:layout_gravity="center"
                android:id="@+id/totalquestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp16"
                android:text="@string/total_questions"
                android:fontFamily="@font/inter_semibold"
                android:textAlignment="center"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_marginTop="@dimen/dp16"
                android:layout_marginRight="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp16"
                android:weightSum="3">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_round_test_create_three_inside"
                    android:paddingTop="@dimen/dp8"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp10">
                    <TextView
                        android:textSize="@dimen/post_text_size_x"
                        android:textStyle="bold"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center"
                        android:id="@+id/lowTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="0"
                        android:fontFamily="@font/inter_semibold"
                        android:textAlignment="center"/>
                    <TextView
                        android:textSize="@dimen/small_text_size"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="@string/low"
                        android:fontFamily="@font/inter_regular"
                        android:textAlignment="center"/>
                </LinearLayout>
                <View
                    android:background="@color/yellow_lite"
                    android:layout_width="@dimen/dimen_1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp16"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_round_test_create_three_inside"
                    android:paddingTop="@dimen/dp8"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/post_text_size_x"
                        android:textStyle="bold"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center"
                        android:id="@+id/mediumTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="0"
                        android:fontFamily="@font/inter_semibold"
                        android:textAlignment="center"/>
                    <TextView
                        android:textSize="@dimen/small_text_size"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="@string/medium"
                        android:fontFamily="@font/inter_regular"
                        android:textAlignment="center"/>
                </LinearLayout>
                <View
                    android:background="@color/yellow_lite"
                    android:layout_width="@dimen/dimen_1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/dp16"
                    android:layout_marginBottom="@dimen/dp16"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_round_test_create_three_inside"
                    android:paddingTop="@dimen/dp8"
                    android:paddingBottom="@dimen/dp12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp10">
                    <TextView
                        android:textSize="@dimen/post_text_size_x"
                        android:textStyle="bold"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center"
                        android:id="@+id/highTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="0"
                        android:fontFamily="@font/inter_semibold"
                        android:textAlignment="center"/>
                    <TextView
                        android:textSize="@dimen/small_text_size"
                        android:textColor="@color/colorWhite"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="@string/high"
                        android:fontFamily="@font/inter_regular"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp100"
            android:layout_below="@+id/lltop">
            <TextView
                android:textSize="@dimen/text_size_tertiary"
                android:textColor="@color/country_code_text_color"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp24"
                android:layout_marginBottom="@dimen/dp16"
                android:text="@string/enter_number_of_questions_you_want_to_attempt"
                android:fontFamily="@font/inter_regular"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/spinnerLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp12">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/State"
                    android:background="@drawable/round_corner_border_login_signup"
                    android:paddingTop="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <TextView
                        android:textSize="@dimen/small_text_size"
                        android:textColor="@color/country_code_text_color"
                        android:layout_gravity="top"
                        android:id="@+id/typeSpinner"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingRight="@dimen/dp10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/type"
                        android:maxLines="1"
                        android:layout_toLeftOf="@+id/downarrowIV"
                        android:layout_centerInParent="true"
                        android:inputType="text"
                        android:fontFamily="@font/inter_medium"/>
                    <ImageView
                        android:id="@+id/downarrowIV"
                        android:padding="@dimen/dp4"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        android:src="@drawable/arrow_down"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_marginEnd="@dimen/dp10"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp12"
                app:hintEnabled="false">
                <EditText
                    android:textSize="@dimen/small_text_size"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/et_max"
                    android:background="@drawable/round_corner_border_login_signup"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Number of Questions"
                    android:maxLines="1"
                    android:maxLength="3"
                    android:digits="0123456789"
                    android:inputType="phone"
                    android:fontFamily="@font/inter_regular"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="@dimen/text_size_tertiary"
                android:textColor="@color/country_code_text_color"
                android:layout_gravity="center"
                android:id="@+id/maxTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp32"
                android:text="@string/maximum"/>
        </LinearLayout>
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:elevation="10dp">
            <Button
                android:textSize="@dimen/post_text_size_x"
                android:textStyle="bold"
                android:textColor="@color/commonBtnTextColor"
                android:id="@+id/buttonProceed"
                android:background="@drawable/common_round_corners_button_drawable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp12"
                android:text="@string/create"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_medium"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12"/>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
