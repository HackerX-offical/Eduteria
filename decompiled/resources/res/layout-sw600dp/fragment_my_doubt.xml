<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/pullto_referesh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/doubt_subjects"
                android:padding="@dimen/dp6"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_top_two"
                android:background="@drawable/round_half_corner_home_grey"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/filter_one_click"
                    android:background="@drawable/image_filter_one"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginLeft="@dimen/dp16"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp10"
                    android:layout_weight="4.25"
                    android:translationZ="@dimen/dp6"
                    android:elevation="@dimen/dp4">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/black_405461"
                        android:ellipsize="end"
                        android:id="@+id/filterOne"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp2"
                        android:layout_width="102dp"
                        android:layout_height="wrap_content"
                        android:text="Subject"
                        android:maxLines="1"
                        android:fontFamily="@font/inter_regular"/>
                    <ImageView
                        android:id="@+id/downarrowIV_new"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:src="@drawable/arrow_down"
                        android:layout_marginEnd="@dimen/dp10"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/filter_two_click"
                    android:background="@drawable/image_filter_two"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp40"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp10"
                    android:layout_weight="4.25"
                    android:translationZ="@dimen/dp6"
                    android:elevation="@dimen/dp4">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/black_405461"
                        android:ellipsize="end"
                        android:id="@+id/filterTwo"
                        android:paddingLeft="@dimen/dp16"
                        android:paddingRight="@dimen/dp2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Topic"
                        android:maxLines="1"
                        android:fontFamily="@font/inter_regular"
                        android:layout_toStartOf="@+id/arrow"/>
                    <ImageView
                        android:id="@+id/arrow"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:src="@drawable/arrow_down"
                        android:layout_marginEnd="@dimen/dp10"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:id="@+id/filter"
                    android:background="@drawable/filter_selector"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:layout_weight="1.4"
                    android:layout_marginEnd="@dimen/dp10">
                    <ImageView
                        android:padding="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f08027d"/>
                </RelativeLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mydoubt_list_recycler"
                android:paddingBottom="@dimen/dp16"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <RelativeLayout
                android:id="@+id/no_data_found_RL"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/doubt_subjects">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/image"
                        android:background="0x7f080655"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp10"
                        android:layout_below="@+id/ll1"
                        android:layout_centerInParent="true"/>
                    <TextView
                        android:textColor="@color/country_code_text_color"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/no_data"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:text="No Data Found"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/amazon_ember_bd"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="40dp"
                        android:layout_marginTop="@dimen/dp4"
                        android:layout_marginRight="40dp"
                        android:layout_marginBottom="40dp"
                        android:text="Sorry, there is no result for this search."
                        android:fontFamily="@font/amazon_ember_rg"/>
                    <Button
                        android:textSize="@dimen/post_text_size"
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/backBtn"
                        android:background="@drawable/common_round_corners_button_drawable"
                        android:paddingLeft="@dimen/dp24"
                        android:paddingRight="@dimen/dp24"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="24dp"
                        android:text="@string/go_back"
                        android:textAllCaps="false"
                        android:fontFamily="@font/amazon_ember_bd"/>
                </LinearLayout>
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/addDoubt_floatingButton"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp20"
                    android:src="@mipmap/ic_add_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
