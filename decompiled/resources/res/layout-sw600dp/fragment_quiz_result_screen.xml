<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/dp3">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainLL"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp2"
                app:cardElevation="@dimen/dp2">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5">
                    <TextView
                        android:textSize="@dimen/sub_heading_text_size"
                        android:textColor="@color/country_code_text_color"
                        android:padding="@dimen/dp2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp7"
                        android:text="@string/score_card"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/appLogoIV"
                            android:layout_width="@dimen/dp80"
                            android:layout_height="@dimen/dp80"
                            android:layout_margin="@dimen/dp3"
                            android:src="@mipmap/both"
                            android:layout_centerHorizontal="true"/>
                        <TextView
                            android:textSize="@dimen/sub_heading_text_size"
                            android:textColor="@color/country_code_text_color"
                            android:id="@+id/testSeriesnameTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_below="@+id/appLogoIV"
                            android:layout_centerHorizontal="true"/>
                        <View
                            android:background="@color/theme_and_header_color"
                            android:layout_width="@dimen/dp100"
                            android:layout_height="@dimen/dp2"
                            android:layout_margin="@dimen/dp2"
                            android:layout_below="@+id/testSeriesnameTV"
                            android:layout_centerHorizontal="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp2">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:layout_margin="@dimen/dp3"
                                android:src="@mipmap/default_pic"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/dp5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toRightOf="@+id/imageIV">
                                <TextView
                                    android:textSize="@dimen/extrasmall_text_size_11"
                                    android:textColor="@color/country_code_text_color"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/name"
                                    android:maxLines="1"/>
                                <TextView
                                    android:textSize="@dimen/small_text_size"
                                    android:textColor="@color/black_overlay"
                                    android:id="@+id/nameValueTV"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/scoreLL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp2">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:layout_margin="@dimen/dp3"
                                android:src="@mipmap/default_pic"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/dp5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toRightOf="@+id/imageIV">
                                <TextView
                                    android:textSize="@dimen/extrasmall_text_size_11"
                                    android:textColor="@color/country_code_text_color"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/you_scored"
                                    android:maxLines="1"/>
                                <TextView
                                    android:textSize="@dimen/small_text_size"
                                    android:textColor="@color/black_overlay"
                                    android:id="@+id/scoreValueTV"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/rankLL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp2"
                            android:weightSum="2">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:layout_margin="@dimen/dp3"
                                android:src="@mipmap/default_pic"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/dp5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="2">
                                <TextView
                                    android:textSize="@dimen/extrasmall_text_size_11"
                                    android:textColor="@color/country_code_text_color"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/your_rank"
                                    android:maxLines="1"/>
                                <TextView
                                    android:textSize="@dimen/small_text_size"
                                    android:textColor="@color/black_overlay"
                                    android:id="@+id/rankValueTV"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:maxLines="1"/>
                            </LinearLayout>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/leaderboardIV"
                                android:padding="@dimen/dp7"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:layout_margin="@dimen/dp3"
                                android:src="@mipmap/default_pic"/>
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:id="@+id/rankreloadIV"
                                android:padding="@dimen/dp5"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:layout_margin="@dimen/dp3"
                                android:src="@mipmap/default_pic"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp2">
                            <ImageView
                                android:layout_gravity="center_vertical"
                                android:layout_width="@dimen/dp40"
                                android:layout_height="@dimen/dp40"
                                android:layout_margin="@dimen/dp3"
                                android:src="@mipmap/default_pic"/>
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:padding="@dimen/dp5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toRightOf="@+id/imageIV">
                                <TextView
                                    android:textSize="@dimen/extrasmall_text_size_11"
                                    android:textColor="@color/country_code_text_color"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/time_spent"
                                    android:maxLines="1"/>
                                <TextView
                                    android:textSize="@dimen/small_text_size"
                                    android:textColor="@color/black_overlay"
                                    android:id="@+id/timeSpentValueTV"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:maxLines="1"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/shareRankLL"
                android:background="@drawable/bg_card_bottom_corner"
                android:padding="@dimen/dp5"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp1"
                android:layout_marginRight="@dimen/dp20"
                android:elevation="@dimen/dp2">
                <ImageView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp3"
                    android:src="@mipmap/default_pic"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="@dimen/sub_heading_text_size"
                    android:textColor="@color/country_code_text_color"
                    android:padding="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_solution"
                    android:maxLines="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp7">
                <androidx.cardview.widget.CardView
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp5"
                    app:cardBackgroundColor="@color/blue"
                    app:cardElevation="@dimen/dp2">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp5">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp15"
                            android:src="@mipmap/default_pic"/>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/heading_text_size"
                                android:textColor="@color/dullBlack"
                                android:gravity="center"
                                android:padding="@dimen/dp2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp10"
                                android:text="@string/rewards_point_earned"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="@dimen/large_text_size"
                                android:textColor="@color/country_code_text_color"
                                android:gravity="center"
                                android:id="@+id/rewardsValueTV"
                                android:padding="@dimen/dp2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp10"
                                android:text="@string/_0_points"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/questionDistrLL"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp7">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:layout_marginRight="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp5"
                    app:cardElevation="@dimen/dp2">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp5">
                        <TextView
                            android:textSize="@dimen/heading_text_size"
                            android:textColor="@color/country_code_text_color"
                            android:padding="@dimen/dp2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp7"
                            android:text="@string/question_distribution"
                            android:maxLines="1"/>
                        <LinearLayout
                            android:padding="@dimen/dp2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="3">
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/country_code_text_color"
                                android:gravity="center"
                                android:id="@+id/correctTv"
                                android:padding="@dimen/dp2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/correct"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/country_code_text_color"
                                android:gravity="center"
                                android:id="@+id/wrongTv"
                                android:padding="@dimen/dp2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/wrong"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/country_code_text_color"
                                android:gravity="center"
                                android:id="@+id/unattemptedTv"
                                android:padding="@dimen/dp2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/unattempted"
                                android:maxLines="1"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:padding="@dimen/dp3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginRight="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp5"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
