<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_stdFeedBackCard"
    android:background="#eaffed"
    android:layout_width="@dimen/dp300"
    android:layout_height="155dp"
    android:layout_margin="@dimen/dp5"
    android:elevation="@dimen/dp4"
    app:cardBackgroundColor="@color/ab_math_light1"
    app:cardCornerRadius="@dimen/dp9">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/feedbackTxtLay0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:layout_alignParentTop="true"
            android:layout_marginVertical="@dimen/dp5">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp20"
                android:layout_weight="0.2">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/double_quote_left"
                    app:tint="@color/colorPrimary"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:layout_marginVertical="@dimen/dp5">
                <TextView
                    android:textSize="@dimen/sp13"
                    android:textColor="@color/black"
                    android:id="@+id/home_stdFeedBack_feedbackTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feedbackStd"
                    android:maxLines="5"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="bottom"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp20"
                android:layout_weight="0.2">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/double_quote_right"
                    app:tint="@color/colorPrimary"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/feedbackTxtLay1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp50"
            android:layout_marginBottom="@dimen/dp5"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp5">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:layout_marginHorizontal="@dimen/dp10">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/home_stdFeedBack_teacherImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/user_pic"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/sp14"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/home_stdFeedBack_teacherName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/testimonialvideo"
                    android:background="@drawable/round_bg_1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/play_icon"
                    android:layout_marginEnd="@dimen/dp5"
                    app:tint="@color/white"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
