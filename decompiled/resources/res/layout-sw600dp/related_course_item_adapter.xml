<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/currentAffairRL"
    android:paddingLeft="@dimen/dp6"
    android:paddingTop="@dimen/dp12"
    android:paddingRight="@dimen/dp6"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/card_CV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/background_all"
        app:cardCornerRadius="@dimen/dp12"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/videoplayerRL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ibt_single_vd_iv"
                    android:layout_width="@dimen/dp170"
                    android:layout_height="@dimen/dp240"
                    android:src="@mipmap/book_placeholder"
                    android:scaleType="fitXY"
                    android:layout_centerInParent="true"/>
                <ImageView
                    android:id="@+id/liveIV"
                    android:padding="@dimen/dp2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/live"
                    android:scaleType="fitXY"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/title_ll"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp4"
        android:layout_marginRight="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp10">
        <TextView
            android:textSize="@dimen/small_text_size2"
            android:textColor="@color/black_405461"
            android:ellipsize="end"
            android:id="@+id/ibt_current_affair_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Class XII Commerce"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:fontFamily="@font/inter_bold"/>
        <TextView
            android:textSize="@dimen/sp10"
            android:textColor="@color/black_405461"
            android:ellipsize="end"
            android:id="@+id/validityTextTV"
            android:paddingLeft="@dimen/dp1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/validity_365_days"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_below="@+id/ibt_current_affair_title"
            android:fontFamily="@font/inter_regular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp3">
            <TextView
                android:textSize="@dimen/sp10"
                android:textColor="@color/black_white"
                android:id="@+id/mrpCutTV"
                android:paddingLeft="@dimen/dp2"
                android:paddingRight="@dimen/dp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1750.00"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="@font/inter_regular"
                android:textAlignment="textStart"/>
            <TextView
                android:textSize="@dimen/extrasmall_text_size_12"
                android:textColor="@color/black_white_text"
                android:id="@+id/priceTV"
                android:paddingLeft="@dimen/dp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3000.00"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:textAlignment="textEnd"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
