<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parentBottom"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp4"
    android:layout_marginEnd="@dimen/dp4">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tour_ll"
            android:padding="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imageView"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/my_courses_def"
                    android:layout_marginEnd="@dimen/dp5"
                    app:tint="@color/colorPrimary"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/dimen_17sp"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/tilesTextTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="jbfjads  jhk hfhf fhfhhfhfhfhhfhjhjhjhjhgj"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_toEndOf="@+id/imageView"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/liveIV"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/live"
                        android:layout_marginStart="@dimen/dp5"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:id="@+id/bg_bottom"
            android:background="@color/colorPrimary"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:alpha="0.8"
            android:layout_marginStart="@dimen/dp2"
            android:layout_marginEnd="@dimen/dp2"/>
    </LinearLayout>
</LinearLayout>
