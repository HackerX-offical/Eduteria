<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp6"
    android:layout_marginTop="@dimen/dp8"
    android:layout_marginRight="@dimen/dp6"
    android:layout_marginBottom="@dimen/dp8">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parentLL"
        android:background="@drawable/round_corner_for_faq"
        android:padding="@dimen/dp8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/topViewItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/post_text_size"
                android:textColor="@color/black_white_text"
                android:id="@+id/questiontextTV"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp3"
                android:layout_marginBottom="@dimen/dp3"
                android:text="How can I find an imaging center in my area that can perform this procedure?"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="@dimen/dp6"
                android:layout_toStartOf="@+id/dropDownIV"/>
            <ImageView
                android:id="@+id/dropDownIV"
                android:padding="@dimen/dp7"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp30"
                android:src="@mipmap/down_black"
                android:tint="@color/country_code_text_color"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lowerViewItem"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="1">
            <TextView
                android:textSize="@dimen/small_text_size2"
                android:textColor="@color/black_white"
                android:gravity="center_vertical"
                android:id="@+id/answertextTV"
                android:padding="@dimen/dp8"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp3"
                android:text="You might try searching in the database of ACR-accredited facilities. You might try searching in the database of ACR-accredited facilities. You might try searching in the database of ACR-accredited facilities."
                android:layout_weight="1"
                android:lineSpacingExtra="@dimen/dp3"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_regular"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
