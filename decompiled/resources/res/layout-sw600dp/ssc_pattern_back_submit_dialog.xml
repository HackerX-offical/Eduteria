<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw600dp/ssc_pattern_back_submit_dialog_0"
    android:background="@color/gray_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iconTime"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_access_time_24"
                app:layout_constraintBottom_toBottomOf="@+id/tvTimeLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTimeLabel"
                app:tint="@color/ssc_gray"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ssc_gray"
                android:id="@+id/tvTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_left"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/iconTime"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ssc_blue"
                android:id="@+id/tvTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_00_00_00"
                app:layout_constraintBottom_toBottomOf="@+id/tvTimeLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvTimeLabel"/>
            <View
                android:id="@+id/divider1"
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvTimeLabel"/>
            <ImageView
                android:id="@+id/iconAttempted"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/checkbox_on_background"
                app:layout_constraintBottom_toBottomOf="@+id/tvAttemptedLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvAttemptedLabel"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ssc_gray"
                android:id="@+id/tvAttemptedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/attempted"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/iconAttempted"
                app:layout_constraintTop_toBottomOf="@+id/divider1"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tvAttemptedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_0"
                app:layout_constraintBottom_toBottomOf="@+id/tvAttemptedLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvAttemptedLabel"/>
            <View
                android:id="@+id/divider2"
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvAttemptedLabel"/>
            <ImageView
                android:id="@+id/iconUnattempted"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_delete"
                app:layout_constraintBottom_toBottomOf="@+id/tvUnattemptedLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvUnattemptedLabel"
                app:tint="@color/ssc_gray"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ssc_gray"
                android:id="@+id/tvUnattemptedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/unattempted"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/iconUnattempted"
                app:layout_constraintTop_toBottomOf="@+id/divider2"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tvUnattemptedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_0"
                app:layout_constraintBottom_toBottomOf="@+id/tvUnattemptedLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvUnattemptedLabel"/>
            <View
                android:id="@+id/divider3"
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/tvUnattemptedLabel"/>
            <ImageView
                android:id="@+id/iconMarked"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/btn_star_big_on"
                app:layout_constraintBottom_toBottomOf="@+id/tvMarkedLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvMarkedLabel"
                app:tint="@color/ssc_gray"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ssc_gray"
                android:id="@+id/tvMarkedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/_marked"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toEndOf="@+id/iconMarked"
                app:layout_constraintTop_toBottomOf="@+id/divider3"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/tvMarkedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_0"
                app:layout_constraintBottom_toBottomOf="@+id/tvMarkedLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvMarkedLabel"/>
            <View
                android:id="@+id/divider4"
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintTop_toBottomOf="@+id/tvMarkedLabel"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center"
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:text="@string/are_you_sure_you_want_to_submit_the_test"
                android:textAlignment="center"
                app:layout_constraintTop_toBottomOf="@+id/divider4"/>
            <Button
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="@+id/btnYes"
                android:background="@drawable/btn_solid_blue"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:text="@string/yes"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_medium"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toStartOf="@+id/btnNo"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvQuestion"/>
            <Button
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="@+id/btnNo"
                android:background="@drawable/bg_text_card_select"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="20dp"
                android:text="@string/no"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_medium"
                android:layout_marginStart="8dp"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/btnYes"
                app:layout_constraintTop_toBottomOf="@+id/tvQuestion"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupStats"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="iconTime,tvTimeLabel,tvTimeValue,divider1,iconAttempted,tvAttemptedLabel,tvAttemptedValue,divider2,iconUnattempted,tvUnattemptedLabel,tvUnattemptedValue,divider3,iconMarked,tvMarkedLabel,tvMarkedValue,divider4"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
