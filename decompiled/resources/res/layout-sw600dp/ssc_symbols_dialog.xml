<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw600dp/ssc_symbols_dialog_0"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnContainer"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ssc_symbol_warn"
                android:fontFamily="@font/inter_bold"/>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Symbol"
                    android:fontFamily="@font/inter_semibold"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="60dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="35dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_rect_blue_solid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="12"
                        android:fontFamily="@font/inter_semibold"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="You have not yet attempted this Q"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="30dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="35dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_rect_green_solid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="15"
                        android:fontFamily="@font/inter_semibold"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="You have answered this Q"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="30dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="35dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_rect_red_solid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="14"
                        android:fontFamily="@font/inter_semibold"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="You have not answered this Q, but marked it for review later, if time permits"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="30dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="35dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/shape_rect_yellow_solid"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="11"
                        android:fontFamily="@font/inter_semibold"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="You have answered the Q, but marked it for review later, if time permits"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="30dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_solid_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save &amp; Next"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Tapping will take you to next Q"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="25dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ssc_blue"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_outline_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="60dp"
                        android:text="Previous"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Tapping will take you to previous Q"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="25dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ssc_blue"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/btn_outline_blue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="60dp"
                        android:text="Mark For Review"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="By tapping this, you can mark the Q for review later. Please note that if you answer the Q and mark for review, the Q will be treated as answered and evaluated even if you do not review it"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <View
                android:background="@color/ssc_gray_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingVertical="12dp">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ssc_blue_light_txt"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_outline_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="60dp"
                        android:text="Unmark Review"
                        android:textAllCaps="false"
                        android:fontFamily="@font/inter_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ssc_gray_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="By tapping this, you can unmark the Q for review"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/btnContainer"
        android:background="@android:color/white"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:id="@+id/btnBackToTest"
            android:background="@drawable/btn_solid_blue"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/back_to_test"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginHorizontal="16dp"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
