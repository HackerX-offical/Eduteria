<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@color/colorPrimaryDark"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <ImageView
            android:id="@+id/backimag"
            android:padding="@dimen/dp5"
            android:layout_width="@dimen/dp30"
            android:layout_height="@dimen/dp30"
            android:src="@mipmap/back_gray"
            android:scaleType="fitXY"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp20"
            android:textColor="@color/commonToolbarTextColor"
            android:id="@+id/test_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:layout_marginStart="@dimen/dp20"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/layput"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar">
        <ImageView
            android:id="@+id/thumb"
            android:layout_width="@dimen/dp100"
            android:layout_height="@dimen/dp100"
            android:src="@drawable/ic_baseline_thumb_up_24"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="25sp"
            android:textColor="@color/country_code_text_color"
            android:id="@+id/Thanks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/thank_you"
            android:layout_below="@+id/thumb"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/inter_bold"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/country_code_text_color"
            android:id="@+id/test_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/yout_test_has_been_submit_successfully"
            android:layout_below="@+id/Thanks"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/inter_bold"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/live_video_red"
            android:gravity="center"
            android:id="@+id/result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:layout_below="@+id/test_submit"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/inter_medium"/>
        <Button
            android:textSize="@dimen/post_text_size"
            android:textColor="@color/commonBtnTextColor"
            android:id="@+id/backBtn"
            android:background="@drawable/common_round_corners_button_drawable"
            android:paddingLeft="@dimen/dp24"
            android:paddingRight="@dimen/dp24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="@string/go_back"
            android:layout_below="@+id/result"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_bold"/>
    </RelativeLayout>
</RelativeLayout>
