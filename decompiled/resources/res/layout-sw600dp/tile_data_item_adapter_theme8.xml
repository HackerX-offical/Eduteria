<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/currentAffairRL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/tileRL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp7"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginRight="@dimen/dp7"
            android:layout_marginBottom="@dimen/dp5"
            app:cardCornerRadius="@dimen/dp5"
            app:cardElevation="@dimen/dp2">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/maiView"
                android:paddingLeft="@dimen/dp2"
                android:paddingRight="@dimen/dp2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/cvrLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/videoplayerRL"
                        android:layout_width="107dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:layout_marginStart="@dimen/dp10">
                        <com.makeramen.roundedimageview.RoundedImageView
                            android:id="@+id/ibt_single_vd_iv"
                            android:background="@null"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/square_placeholder"
                            android:scaleType="fitXY"
                            app:riv_corner_radius="@dimen/dp12"/>
                        <ImageView
                            android:id="@+id/liveIV"
                            android:padding="@dimen/dp2"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/live"
                            android:scaleType="fitXY"/>
                        <ImageView
                            android:id="@+id/new_course"
                            android:padding="@dimen/dp2"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp60"
                            android:layout_height="@dimen/dp40"
                            android:src="@mipmap/new_"
                            android:scaleType="fitXY"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/layout1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp5"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_marginEnd="@dimen/dp10"
                        android:layout_toEndOf="@+id/videoplayerRL">
                        <TextView
                            android:textSize="@dimen/sp10"
                            android:textStyle="bold"
                            android:textColor="@color/dullBlack"
                            android:ellipsize="end"
                            android:id="@+id/ibt_current_affair_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESE GATE 2021 MODULE COURSE 1 Gate CTQ + Gate Ese 2021"
                            android:maxLines="2"/>
                        <TextView
                            android:textSize="@dimen/extra_extrasmall_text_size"
                            android:textColor="@color/blackApp"
                            android:gravity="center_vertical"
                            android:id="@+id/ibt_single_vd_tv_day"
                            android:paddingTop="@dimen/dp2"
                            android:paddingBottom="@dimen/dp2"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CTQ GATE + ESE 2021"
                            android:maxLines="2"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="@dimen/sp11"
                            android:textColor="@color/light_black_font"
                            android:gravity="start"
                            android:id="@+id/tv_course_expire_date"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Purchased"
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="@dimen/extra_extrasmall_text_size"
                            android:textColor="@color/light_black_font"
                            android:id="@+id/tv_stream_offered"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stream civil engineering"/>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/tag_recyclerview"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/dp30"/>
                        <RelativeLayout
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp20">
                            <TextView
                                android:textSize="@dimen/sp12"
                                android:textColor="@color/light_black_font"
                                android:gravity="end"
                                android:id="@+id/mrpCutTV"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp2"
                                android:text="Purchased"
                                android:maxLines="1"/>
                            <TextView
                                android:textSize="@dimen/sp12"
                                android:textStyle="bold"
                                android:textColor="#01acda"
                                android:id="@+id/priceTV"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 500,000/-*"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/dp5"
                                android:layout_toEndOf="@+id/mrpCutTV"/>
                            <TextView
                                android:textSize="@dimen/sp12"
                                android:textStyle="bold"
                                android:textColor="#01acda"
                                android:gravity="start"
                                android:id="@+id/offerinside"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/priceTV"/>
                        </RelativeLayout>
                        <TextView
                            android:textSize="@dimen/sp10"
                            android:textColor="#8a000000"
                            android:id="@+id/validityTextTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp4"
                            android:text="Begins : 3    Oct 2020"/>
                    </LinearLayout>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/dp15"
                    android:textColor="#ff0000"
                    android:id="@+id/dicount_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp13"
                    android:text="10% off Discount valid till Sept 20, Only"
                    android:layout_below="@+id/cvrLayout"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</LinearLayout>
