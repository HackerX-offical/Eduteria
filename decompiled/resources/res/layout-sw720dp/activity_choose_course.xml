<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_main"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">
        <ImageView
            android:id="@+id/iv_back"
            android:padding="@dimen/dp10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080399"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp10"/>
        <TextView
            android:textSize="@dimen/sp18"
            android:textColor="@color/LogincolorPrimary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Any One Job Role"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter_semibold"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/signupBtn"
        android:layout_below="@+id/rl_main">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/courseListRV"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp6"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/dp2"
            android:layout_marginEnd="@dimen/dp2"/>
        <include
            android:id="@+id/no_data"
            layout="@layout/no_data_found"/>
    </LinearLayout>
    <Button
        android:textSize="@dimen/extrasmall_text_size_16"
        android:textStyle="bold"
        android:textColor="@color/commonBtnTextColor"
        android:id="@+id/signupBtn"
        android:background="@drawable/common_round_corners_button_drawable"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp16"
        android:text="@string/continuee"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        android:fontFamily="@font/inter_medium"/>
</RelativeLayout>
