<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/main_toolbar"
            android:background="@color/theme_and_header_color"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/image_back"
                    android:padding="@dimen/dp5"
                    android:layout_width="@dimen/dp30"
                    android:layout_height="@dimen/dp30"
                    android:src="@mipmap/back_gray"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="@dimen/sp18"
                    android:textColor="@color/commonToolbarTextColor"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/toolbarTitleTV"
                    android:paddingLeft="@dimen/dp5"
                    android:paddingRight="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/migrate_user"
                    android:maxLines="1"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/inter_bold"/>
                <CheckBox
                    android:gravity="center_vertical"
                    android:id="@+id/select_all_delete"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/select"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginEnd="@dimen/dp10"
                    android:layout_alignParentEnd="true"
                    android:buttonTint="@color/colorWhite"/>
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/delete"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/delete"
                    android:drawableLeft="@drawable/delete"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginEnd="@dimen/dp10"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
        <RelativeLayout
            android:id="@+id/layout1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp55"
            android:layout_margin="@dimen/dp12"
            android:layout_marginTop="@dimen/dp12"
            android:layout_below="@+id/main_toolbar">
            <EditText
                android:textSize="@dimen/small_text_size"
                android:id="@+id/m_no"
                android:background="@drawable/round_corner_border_login_signup"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp16"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp16"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Mobile Number"
                android:maxLines="1"
                android:maxLength="10"
                android:drawablePadding="@dimen/dp15"
                android:inputType="number"
                android:drawableStart="@mipmap/gray_mobile"
                android:fontFamily="@font/inter_bold"
                android:layout_toStartOf="@+id/refresh"/>
            <ImageView
                android:id="@+id/refresh"
                android:visibility="gone"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/ic_refresh_black_24dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/proceed"
            android:background="@color/white"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:elevation="10dp">
            <Button
                android:textSize="@dimen/post_text_size"
                android:textColor="@color/commonBtnTextColor"
                android:id="@+id/buttonProceed"
                android:background="@drawable/bg_round_corners_button_fade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp12"
                android:text="@string/fetch_user"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12"/>
        </RelativeLayout>
        <include layout="@layout/no_data_found"/>
    </RelativeLayout>
</RelativeLayout>
