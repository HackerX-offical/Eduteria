<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/ToolbarDarkOverflow"
        android:id="@+id/dashboardToolbar"
        android:background="@color/colorPrimary"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:popupTheme="@style/Theme.AppCompat.NoActionBar">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/dp70">
                <ImageView
                    android:layout_width="@dimen/dp150"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_logo_header"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/searchIcon"
                android:padding="@dimen/dp5"
                android:visibility="gone"
                android:layout_width="@dimen/dp35"
                android:layout_height="35dp"
                android:layout_toLeftOf="@+id/gotoCart"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_search_black"
                app:tint="@color/white"/>
            <ImageView
                android:id="@+id/gotoCart"
                android:padding="@dimen/dp5"
                android:visibility="gone"
                android:layout_width="@dimen/dp35"
                android:layout_height="35dp"
                android:layout_toLeftOf="@+id/notificationLL"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_cart"
                app:tint="@color/white"/>
            <RelativeLayout
                android:id="@+id/notificationLL"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_width="@dimen/dp35"
                android:layout_height="@dimen/dp35"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/notificationIV"
                    android:padding="@dimen/dp5"
                    android:layout_width="@dimen/dp35"
                    android:layout_height="35dp"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="0x7f080515"
                    app:tint="@color/white"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/black_405461"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/notification"
                    android:layout_below="@+id/notificationIV"
                    android:fontFamily="@font/inter_medium"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/cvrNotificationCount1"
                    android:background="@drawable/circle_notification_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp16"
                    android:layout_alignParentRight="true">
                    <TextView
                        android:textSize="@dimen/sp10"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/notificaionCount1"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp16"
                        android:text=""/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/dashboardToolbar">
        <RelativeLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
