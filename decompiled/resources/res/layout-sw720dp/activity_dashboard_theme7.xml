<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/dashBoardMain7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/app_bar_dashboard7"/>
    <FrameLayout
        android:id="@+id/forchatbot"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        android:visibility="visible"
        android:fitsSystemWindows="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nav_headerRL"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/nav_headerLL"
                        android:background="@drawable/card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp30">
                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/profileImage"
                                android:layout_width="@dimen/medium_image_size"
                                android:layout_height="@dimen/medium_image_size"
                                android:src="@mipmap/default_pic"/>
                            <ImageView
                                android:id="@+id/profileImageText"
                                android:visibility="gone"
                                android:layout_width="@dimen/medium_image_size"
                                android:layout_height="@dimen/medium_image_size"
                                android:src="@mipmap/default_pic"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="@dimen/dp16"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:id="@+id/profileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp10"
                            android:text="@string/welcome"/>
                        <TextView
                            android:textSize="@dimen/small_text_size2"
                            android:textColor="@color/whiteApp"
                            android:id="@+id/profileEmail"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"/>
                        <androidx.cardview.widget.CardView
                            android:id="@+id/changeInterfaceCV"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp50"
                            android:layout_marginTop="@dimen/dp10"
                            android:layout_marginBottom="@dimen/dp10"
                            android:layout_marginStart="@dimen/dp50"
                            android:layout_marginEnd="@dimen/dp50"
                            app:cardCornerRadius="@dimen/dp20">
                            <LinearLayout
                                android:layout_gravity="center"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:layout_width="@dimen/dp25"
                                    android:layout_height="@dimen/dp25"
                                    android:layout_margin="@dimen/dp10"
                                    android:layout_marginTop="@dimen/dp10"
                                    android:src="@mipmap/prefrences"/>
                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:textSize="@dimen/dp8"
                                        android:textColor="@color/black"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp10"
                                        android:text="Selected Preference"/>
                                    <TextView
                                        android:textSize="@dimen/dp10"
                                        android:id="@+id/selectionType"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/change_interface"/>
                                </LinearLayout>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:id="@+id/arrow_img"
                                    android:layout_width="@dimen/dp20"
                                    android:layout_height="@dimen/dp20"
                                    android:src="@drawable/ic_baseline_chevron_right_24"
                                    android:layout_marginStart="@dimen/dp20"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/updateProfileBtn"
                        android:padding="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp10"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:src="0x7f08020d"
                        android:layout_alignParentRight="true"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_marginEnd="@dimen/dp10"
                        app:tint="@color/white"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:background="@color/menu_left_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/nav_headerRL">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/navRV"
                    android:paddingTop="@dimen/dp4"
                    android:paddingRight="16dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/darker_gray"
                    android:dividerHeight="0.3dp"
                    android:layout_above="@+id/vNameTV"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/socialIconLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp10"
                    android:layout_above="@+id/vNameTV">
                    <ImageView
                        android:id="@+id/iconYoutube"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/whatsapp"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconTelegram"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/whatsapp"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconLinkedIn"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/whatsapp"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconFacebook"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/whatsapp"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconInstagram"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/whatsapp"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconTwitter"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/whatsapp"
                        android:layout_marginStart="@dimen/dp10"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:gravity="center"
                    android:id="@+id/vNameTV"
                    android:padding="@dimen/dp4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="@font/inter_regular"/>
            </RelativeLayout>
        </RelativeLayout>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
