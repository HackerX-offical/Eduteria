<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/main_toolbar"
        android:background="@color/theme_and_header_color"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/doubtChat_back"
                android:padding="@dimen/dp5"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp30"
                android:src="@mipmap/back_gray"/>
            <TextView
                android:textSize="@dimen/sp18"
                android:textColor="@color/commonToolbarTextColor"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/toolbarTitleTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/doubts"
                android:maxLines="1"
                android:fontFamily="@font/inter_bold"
                android:paddingStart="@dimen/dp16"
                android:paddingEnd="@dimen/dp5"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:id="@+id/main"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/main_toolbar">
        <androidx.cardview.widget.CardView
            android:padding="@dimen/dp2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="@dimen/dp12">
            <RelativeLayout
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_gravity="top"
                    android:id="@+id/doubtSubject"
                    android:paddingTop="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Doubt: "
                    android:maxLines="1"
                    android:fontFamily="@font/amazon_ember_rg"
                    android:layout_toStartOf="@+id/ll_resolved"/>
                <TextView
                    android:textSize="@dimen/sp11"
                    android:layout_gravity="top"
                    android:id="@+id/doubtMessage"
                    android:paddingTop="@dimen/dp6"
                    android:paddingBottom="@dimen/dp6"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="@dimen/dp120"
                    android:text="User Name"
                    android:layout_below="@+id/doubtSubject"
                    android:fontFamily="@font/amazon_ember_rg"
                    android:layout_toStartOf="@+id/ll_resolved"
                    android:nestedScrollingEnabled="false"/>
                <LinearLayout
                    android:id="@+id/ll_resolved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_alignParentEnd="true">
                    <Button
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/doubtUnResolved"
                        android:background="@drawable/bg_mcq_selected2"
                        android:paddingTop="@dimen/dp4"
                        android:paddingBottom="@dimen/dp4"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginBottom="@dimen/dp10"
                        android:text="@string/resolved"
                        android:textAllCaps="false"
                        android:paddingStart="@dimen/dp16"
                        android:paddingEnd="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp8"
                        android:backgroundTint="@color/colorPrimary"/>
                    <Button
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/white"
                        android:layout_gravity="center"
                        android:id="@+id/doubtResolved"
                        android:background="@drawable/bg_mcq_selected2"
                        android:paddingTop="@dimen/dp4"
                        android:paddingBottom="@dimen/dp4"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/click_here_if_issue_resolved"
                        android:textAllCaps="false"
                        android:paddingStart="@dimen/dp16"
                        android:paddingEnd="@dimen/dp16"
                        android:layout_marginEnd="@dimen/dp8"
                        android:backgroundTint="@color/colorPrimary"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/sp11"
                    android:gravity="center"
                    android:background="@drawable/bg_mcq_selected2"
                    android:paddingLeft="@dimen/dp16"
                    android:paddingTop="@dimen/dp12"
                    android:paddingRight="@dimen/dp16"
                    android:paddingBottom="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_centerVertical="true"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/dp8"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/doubt_Reply_Recycler"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp4"
        android:layout_above="@+id/linearLayoutChat"
        android:layout_below="@+id/main"
        android:nestedScrollingEnabled="true"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/linearLayoutChat"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="30dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottomlayout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/linearLayout"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp5"
                android:layout_marginStart="@dimen/dp5"
                android:layout_marginEnd="@dimen/dp5">
                <Button
                    android:layout_gravity="bottom"
                    android:visibility="gone"
                    android:layout_width="39dp"
                    android:layout_height="17dp"
                    android:layout_marginBottom="2dp"/>
                <Button
                    android:layout_gravity="bottom"
                    android:visibility="gone"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_marginBottom="2dp"/>
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/cvr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <Button
                            android:layout_gravity="bottom"
                            android:id="@+id/startaudio"
                            android:background="@mipmap/recording_start"
                            android:visibility="gone"
                            android:layout_width="39dp"
                            android:layout_height="39dp"
                            android:layout_marginBottom="2dp"
                            android:backgroundTint="@color/colorPrimary"/>
                        <Button
                            android:layout_gravity="bottom"
                            android:id="@+id/stopaudio"
                            android:background="@mipmap/recording_off"
                            android:visibility="gone"
                            android:layout_width="39dp"
                            android:layout_height="39dp"
                            android:layout_marginBottom="2dp"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <EditText
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColorHint="@color/black_lite"
                        android:id="@+id/et_message"
                        android:background="@null"
                        android:paddingLeft="@dimen/dp12"
                        android:paddingTop="@dimen/dp5"
                        android:paddingRight="@dimen/dp18"
                        android:paddingBottom="@dimen/dp5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Post Comment"
                        android:maxLines="2"
                        android:layout_toStartOf="@+id/file_upload"
                        android:layout_toEndOf="@+id/cvr"/>
                    <ImageView
                        android:id="@+id/file_upload"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dp12"
                        android:src="@drawable/ic_attach_file_black_24dp"
                        android:tint="@color/colorPrimary"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/chatAddButton"
                    android:padding="@dimen/dp10"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_camera_ic_new"
                    android:tint="@color/colorPrimary"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_send"
                    android:background="@drawable/primary_circle_bg"
                    android:padding="@dimen/dp10"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp36"
                    android:src="@drawable/send_black"
                    app:tint="@color/white"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/theme_and_header_color"
                android:gravity="center"
                android:id="@+id/add_bookmark"
                android:background="@drawable/bg_clicksquare"
                android:padding="@dimen/dp10"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp5"
                android:text="@string/add_bookmark"
                android:layout_alignParentBottom="true"
                android:onClick="showDialog"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
