<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/dashBoardMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/app_bar_home_theme3"/>
    <FrameLayout
        android:id="@+id/forchatbot"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        android:visibility="visible"
        android:fitsSystemWindows="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/nav_headerRL"
                android:background="@color/common_btn_gradient_end_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/nav_headerLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="@dimen/dp10"
                    android:layout_marginBottom="20dp">
                    <FrameLayout
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/profileImage"
                            android:layout_width="@dimen/medium_image_size"
                            android:layout_height="@dimen/medium_image_size"
                            android:src="@mipmap/default_pic"/>
                        <ImageView
                            android:id="@+id/profileImageText"
                            android:visibility="gone"
                            android:layout_width="@dimen/medium_image_size"
                            android:layout_height="@dimen/medium_image_size"
                            android:src="@mipmap/default_pic"/>
                    </FrameLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/dp10"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/sp13"
                            android:textColor="@color/whiteApp"
                            android:id="@+id/profileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:fontFamily="@font/amazon_ember_rg"/>
                        <TextView
                            android:textSize="@dimen/small_text_size2"
                            android:textColor="@color/whiteApp"
                            android:id="@+id/profileEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:padding="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="0x7f08020d"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:background="@color/menu_left_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/nav_headerRL">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/navRV"
                    android:paddingTop="@dimen/dp4"
                    android:paddingRight="16dp"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/darker_gray"
                    android:dividerHeight="0.3dp"
                    android:layout_above="@+id/socialIconLL"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/socialIconLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp10"
                    android:layout_above="@+id/vNameTV">
                    <ImageView
                        android:id="@+id/iconYoutube"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/youtube"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconTelegram"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/telegram"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconLinkedIn"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/linkedin"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconFacebook"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/facebook"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconInstagram"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/instagram"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/iconTwitter"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp30"
                        android:src="@mipmap/twitter"
                        android:layout_marginStart="@dimen/dp10"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:gravity="center"
                    android:id="@+id/vNameTV"
                    android:padding="@dimen/dp4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="@font/inter_regular"/>
            </RelativeLayout>
        </RelativeLayout>
    </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
