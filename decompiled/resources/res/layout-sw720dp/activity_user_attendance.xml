<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/toolbar"
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <RelativeLayout
            android:id="@+id/backBtn"
            android:layout_width="@dimen/dp45"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp12">
            <ImageView
                android:padding="@dimen/dp10"
                android:layout_width="@dimen/dp45"
                android:layout_height="@dimen/dp45"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/whie"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Attendance History"
            android:fontFamily="@font/inter_medium"
            android:layout_marginStart="@dimen/dp10"
            android:layout_toEndOf="@+id/backBtn"/>
        <ImageView
            android:id="@+id/dateRange"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginRight="@dimen/dp8"
            android:src="@drawable/ic_date_range_black_24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:tint="@color/white"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/attendanceHeaderLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/titleLL"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:weightSum="4"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10">
                <View
                    android:background="@color/black"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="40dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"/>
                <View
                    android:background="@color/black"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="40dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Attendance In"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"/>
                <View
                    android:background="@color/black"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="40dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Attendance Out"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"/>
                <View
                    android:background="@color/black"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="40dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Duration"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/attendanceSheetHead"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="3">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"/>
                        <View
                            android:background="@color/black"
                            android:layout_width="@dimen/dp1"
                            android:layout_height="40dp"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="In Time"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"/>
                        <View
                            android:background="@color/black"
                            android:layout_width="@dimen/dp1"
                            android:layout_height="40dp"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Attendance"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"/>
                    </LinearLayout>
                    <View
                        android:background="@color/black"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp1"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attendanceRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:layout_below="@+id/attendanceHeaderLL"/>
        <RelativeLayout
            android:id="@+id/no_data_found_RL"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/image"
                    android:background="0x7f080655"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp10"
                    android:layout_below="@+id/ll1"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/no_data"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="No Data Found"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/amazon_ember_bd"/>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_marginTop="@dimen/dp4"
                    android:layout_marginRight="40dp"
                    android:layout_marginBottom="40dp"
                    android:text="Sorry, there is no result for this search."
                    android:fontFamily="@font/amazon_ember_rg"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
