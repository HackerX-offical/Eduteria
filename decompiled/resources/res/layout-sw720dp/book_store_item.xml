<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:elevation="300dp"
            app:cardCornerRadius="8dp">
            <RelativeLayout
                android:paddingTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <ImageView
                    android:id="@+id/bookImg"
                    android:layout_width="103dp"
                    android:layout_height="133dp"
                    android:src="@drawable/placeholder"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textColor="#3e3e3e"
                    android:id="@+id/topicTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="JEE Advance Physics"
                    android:layout_below="@+id/bookImg"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:textColor="#3e3e3e"
                    android:id="@+id/authorTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="by Ashish Arora"
                    android:layout_below="@+id/topicTV"
                    android:fontFamily="@font/inter_semibold"/>
                <RelativeLayout
                    android:id="@+id/main"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_below="@+id/authorTV">
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/priceTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹13,300"
                        android:fontFamily="@font/inter_regular"/>
                    <TextView
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹4000"
                        android:layout_toRightOf="@+id/priceTV"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginStart="10dp"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/main">
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/offerTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="22% Off"
                        android:fontFamily="@font/inter_regular"/>
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_star"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
    <ImageView
        android:layout_width="54dp"
        android:layout_height="19dp"
        android:src="@drawable/neww"/>
</RelativeLayout>
