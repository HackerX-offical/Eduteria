<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_rectangle_radius"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp10"
    android:layout_marginBottom="@dimen/dp10"
    android:layout_marginStart="@dimen/dp20"
    android:layout_marginEnd="@dimen/dp20">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/header_rl"
        android:background="@drawable/background_rectangle_radius_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp30">
        <TextView
            android:textSize="@dimen/dimen_18sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Coupon Code"/>
    </RelativeLayout>
    <EditText
        android:gravity="center"
        android:id="@+id/coupon_edt"
        android:background="@drawable/filter_selector_1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/dp30"
        android:layout_marginBottom="@dimen/dp10"
        android:maxLength="20"
        android:layout_below="@+id/header_rl"
        android:layout_marginStart="@dimen/dp18"
        android:layout_marginEnd="@dimen/dp18"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp20"
        android:layout_below="@+id/coupon_edt">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/cancel_bg"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:paddingStart="@dimen/dp13"
            android:paddingEnd="@dimen/dp13"/>
        <View
            android:id="@+id/view"
            android:layout_width="70dp"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/apply"
            android:background="@drawable/apply_bg"
            android:paddingTop="@dimen/dp8"
            android:paddingBottom="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:paddingStart="@dimen/dp15"
            android:paddingEnd="@dimen/dp15"/>
    </LinearLayout>
</RelativeLayout>
