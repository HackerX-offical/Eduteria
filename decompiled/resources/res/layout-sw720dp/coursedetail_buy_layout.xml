<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#efecf1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/header_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp200"
        android:src="@mipmap/placeholder_course"
        android:scaleType="fitXY"
        app:riv_corner_radius="5dp"/>
    <RelativeLayout
        android:id="@+id/upper_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_banner">
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2a3447"
                android:id="@+id/basic_program_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/online_record"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="@dimen/dp13"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:id="@+id/batch_name_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/online_record"
                android:layout_toRightOf="@+id/basic_program_txt"
                android:layout_alignBaseline="@+id/basic_program_txt"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2a3447"
                android:id="@+id/meduium_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/medium"
                android:layout_below="@+id/basic_program_txt"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="@dimen/dp13"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:id="@+id/meduium_txt_hindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp10"
                android:text="@string/english_hindi"
                android:layout_toRightOf="@+id/meduium_txt"
                android:layout_below="@+id/basic_program_txt"
                android:layout_alignBaseline="@+id/meduium_txt"
                android:layout_marginStart="8dp"/>
            <View
                android:id="@+id/view_1"
                android:background="#f2f2f2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp10"
                android:layout_below="@+id/meduium_txt"/>
            <RelativeLayout
                android:id="@+id/rl_buy"
                android:background="@color/red"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="@dimen/dp20"
                android:layout_below="@+id/view_1"
                android:layout_marginEnd="@dimen/dp10">
                <include layout="@layout/layout_buy_button"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="#efecf1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp10"
        android:layout_below="@+id/upper_rl">
        <androidx.recyclerview.widget.RecyclerView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tileRv"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp16"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginRight="@dimen/dp16"
            android:layout_marginBottom="@dimen/dp10"/>
    </LinearLayout>
</RelativeLayout>
