<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp2"
        android:elevation="@dimen/dp4"
        app:cardCornerRadius="@dimen/dp6">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_first"
                android:padding="@dimen/dp4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/img_bookmark">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/dp36"
                        android:layout_marginEnd="@dimen/dp4">
                        <ImageView
                            android:id="@+id/bookmark_image"
                            android:visibility="gone"
                            android:layout_width="88dp"
                            android:layout_height="@dimen/dp100"/>
                        <ImageView
                            android:id="@+id/img_play_pause"
                            android:background="@drawable/circle_dim_black"
                            android:padding="@dimen/dp6"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp32"
                            android:layout_height="@dimen/dp32"
                            android:src="@drawable/play_white"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="@dimen/dp2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/dp16"
                                android:textColor="@color/black_text_color"
                                android:ellipsize="end"
                                android:id="@+id/bookmark_count"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="1"
                                android:lines="1"
                                android:layout_marginStart="@dimen/dp8"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <TextView
                                android:textSize="@dimen/sp16"
                                android:textColor="@color/black_text_color"
                                android:ellipsize="end"
                                android:id="@+id/bookmark_tittle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <com.ahmadnemati.clickablewebview.ClickableWebView
                                android:textSize="@dimen/sp16"
                                android:textColor="@color/black_text_color"
                                android:ellipsize="end"
                                android:id="@+id/bookmark_tittle_question"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:layout_marginStart="@dimen/dp8"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:ellipsize="end"
                            android:id="@+id/bookmark_subject"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lines="2"
                            android:fontFamily="@font/inter_semibold"
                            android:layout_marginStart="@dimen/dp8"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="@dimen/sp11"
                            android:textColor="@color/black"
                            android:id="@+id/date_time"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp6"
                            android:text=""
                            android:drawablePadding="4dp"
                            android:layout_below="@+id/Subject_name"
                            android:drawableStart="@drawable/ic_baseline_access_time_24"
                            android:paddingStart="@dimen/dp8"
                            android:layout_toEndOf="@+id/rl_img"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/shareCurrentAffair"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="@dimen/dp30"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="-30dp"
                android:src="0x7f080613"
                android:layout_below="@+id/ll_first"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/img_bookmark"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp10"
                android:src="@drawable/ic_bookmark"
                android:layout_alignParentRight="true"
                app:tint="@color/colorPrimary"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
