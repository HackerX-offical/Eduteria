<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp1"
            app:cardCornerRadius="@dimen/dp5"
            app:cardElevation="@dimen/dp5">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_above="@+id/btn_done"
                    android:layout_below="@+id/ibt_frag_choose_sub_exam_toolbar">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textColor="@color/black_white_text"
                        android:gravity="center"
                        android:id="@+id/TV1"
                        android:background="@color/greayrefcode_dark"
                        android:paddingLeft="30dp"
                        android:paddingTop="12dp"
                        android:paddingRight="30dp"
                        android:paddingBottom="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/delete"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:gravity="center"
                        android:paddingLeft="30dp"
                        android:paddingTop="26dp"
                        android:paddingRight="30dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/CartAlertMessage"
                        android:fontFamily="@font/inter_semibold"/>
                    <RelativeLayout
                        android:padding="@dimen/dp12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/deleteBtn"
                            android:background="@drawable/bg_signup_btn"
                            android:padding="@dimen/dp5"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/dp4"
                            android:layout_marginBottom="@dimen/dp4"
                            android:text="@string/delete"
                            android:layout_alignParentRight="true"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                        <Button
                            android:textColor="@color/black"
                            android:id="@+id/cancelBtn"
                            android:background="@drawable/background_mcq"
                            android:padding="@dimen/dp5"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/dp4"
                            android:layout_marginBottom="@dimen/dp4"
                            android:text="@string/cancel"
                            android:layout_weight="1"
                            android:layout_toLeftOf="@+id/deleteBtn"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</RelativeLayout>
