<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/edit_Profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp15">
        <TextView
            android:textSize="@dimen/sp18"
            android:textColor="@color/colorAccent"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_review"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/cross"
            android:background="@mipmap/download_delete"
            android:layout_width="@dimen/dp32"
            android:layout_height="@dimen/dp32"
            android:layout_marginRight="@dimen/dp20"
            android:layout_alignParentRight="true"
            android:backgroundTint="@color/theme_and_header_color"/>
    </RelativeLayout>
    <View
        android:background="@color/colorPrimaryDark4"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sub_heading_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp20"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/please_rate_your_experience"/>
                <RatingBar
                    android:theme="@style/RatingBar"
                    android:id="@+id/sendCourseRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp10"
                    android:numStars="5"
                    android:scaleX="0.8"
                    android:scaleY="0.8"/>
                <TextView
                    android:textSize="@dimen/sub_heading_text_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp20"
                    android:layout_marginTop="@dimen/dp8"
                    android:text="@string/Additional_comments"/>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:id="@+id/subject1"
                    android:background="@drawable/round_corner_border_advacefilter"
                    android:paddingTop="@dimen/dp8"
                    android:paddingBottom="@dimen/dp8"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginLeft="@dimen/dp20"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp20">
                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp160">
                            <EditText
                                android:textSize="@dimen/post_text_size_x"
                                android:gravity="start"
                                android:id="@+id/ratingComment"
                                android:background="@color/white"
                                android:paddingLeft="@dimen/dp5"
                                android:paddingBottom="@dimen/dp20"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="@dimen/dp4"
                                android:layout_marginBottom="@dimen/dp4"
                                android:hint="@string/comment"
                                android:inputType="textMultiLine"
                                android:fontFamily="@font/amazon_ember_rg"
                                android:layout_marginStart="@dimen/dp4"
                                android:layout_marginEnd="@dimen/dp4"/>
                        </RelativeLayout>
                    </androidx.core.widget.NestedScrollView>
                </RelativeLayout>
                <Button
                    android:textSize="@dimen/sp18"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/submitRating"
                    android:background="@drawable/bg_round_corners"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_marginTop="@dimen/dp40"
                    android:layout_marginRight="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp20"
                    android:text="@string/submit"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>
