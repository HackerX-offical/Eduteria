<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp1"
            app:cardCornerRadius="@dimen/dp5"
            app:cardElevation="@dimen/dp5">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/heading_text_size"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center_horizontal"
                    android:layout_gravity="start"
                    android:id="@+id/titleDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp5"
                    android:text="@string/add_coupon"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/dp10"/>
                <WebView
                    android:id="@+id/msgDialog"
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10">
                    <EditText
                        android:id="@+id/OPT1ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT2ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT3ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT4ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT5ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT6ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <Button
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/btn_cancel"
                            android:background="@drawable/common_round_corners_button_drawable"
                            android:padding="@dimen/dp5"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/dp4"
                            android:layout_marginBottom="@dimen/dp4"
                            android:text="@string/cancel"
                            android:layout_weight="1"
                            android:layout_centerHorizontal="true"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <Button
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/btn_submit"
                            android:background="@drawable/common_round_corners_button_drawable"
                            android:padding="@dimen/dp5"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp40"
                            android:layout_marginTop="@dimen/dp4"
                            android:layout_marginBottom="@dimen/dp4"
                            android:text="@string/submit"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_centerHorizontal="true"
                            android:textAllCaps="false"
                            android:fontFamily="@font/inter_regular"
                            android:layout_marginStart="@dimen/dp4"
                            android:layout_marginEnd="@dimen/dp4"/>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</RelativeLayout>
