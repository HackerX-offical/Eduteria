<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/love_reaction_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginVertical="@dimen/dp2">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/like_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4"
            android:text="��"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/laugh_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4"
            android:text="��"
            android:layout_below="@+id/like_text"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/angry_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4"
            android:text="��"
            android:layout_below="@+id/laugh_text"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/love_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4"
            android:text="❤️"
            android:layout_below="@+id/angry_text"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/sad_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4"
            android:text="��"
            android:layout_below="@+id/love_text"/>
        <TextView
            android:textSize="28sp"
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/wow_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp4"
            android:text="��"
            android:layout_below="@+id/sad_text"/>
    </RelativeLayout>
</RelativeLayout>
