<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/ibt_single_sub_vd_RL"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/study_single_itemLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/study_RL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/iconRL">
                <androidx.cardview.widget.CardView
                    android:id="@+id/card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5"
                    app:cardCornerRadius="@dimen/dp10"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp">
                    <RelativeLayout
                        android:id="@+id/thumbRl"
                        android:layout_width="@dimen/dp100"
                        android:layout_height="@dimen/dp67">
                        <ImageView
                            android:id="@+id/imageIV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/course_placeholder"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <RelativeLayout
                    android:id="@+id/pdfTitleRl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp6"
                    android:layout_toEndOf="@+id/card">
                    <TextView
                        android:textSize="@dimen/sp13"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/examPrepTitleTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:hint="@string/my_exam_selection"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="@dimen/dp5"/>
                </RelativeLayout>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/iconRL"
                android:layout_width="wrap_content"
                android:layout_height="67dp"
                android:layout_alignParentRight="true">
                <ImageView
                    android:id="@+id/arrowIV"
                    android:layout_width="@dimen/dp16"
                    android:layout_height="@dimen/dp16"
                    android:src="@mipmap/forward_black"
                    android:layout_marginEnd="8dp"/>
                <ImageView
                    android:id="@+id/liveIV"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/live"
                    android:layout_below="@+id/arrowIV"/>
                <RelativeLayout
                    android:id="@+id/lockRL"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/liveIV"
                    android:layout_alignParentTop="true"
                    android:paddingStart="@dimen/dp10"
                    android:paddingEnd="@dimen/dp10">
                    <ImageView
                        android:layout_width="@dimen/dp24"
                        android:layout_height="@dimen/dp24"
                        android:src="@mipmap/gray_lock"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/country_code_text_color"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/read_now"
                android:background="@drawable/round_corner_button_bg_grey"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp10"
                android:text="@string/read"
                android:includeFontPadding="false"
                android:layout_below="@+id/study_RL"
                android:fontFamily="@font/amazon_ember_bd"
                android:paddingStart="@dimen/dp5"
                android:paddingEnd="@dimen/dp5"
                android:layout_marginStart="@dimen/dp10"/>
            <ImageView
                android:ellipsize="end"
                android:id="@+id/share"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="0x7f080613"
                android:layout_below="@+id/study_RL"
                android:layout_alignParentRight="true"
                android:paddingStart="@dimen/dp5"
                android:paddingEnd="@dimen/dp10"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <include layout="@layout/no_data_found"/>
</RelativeLayout>
