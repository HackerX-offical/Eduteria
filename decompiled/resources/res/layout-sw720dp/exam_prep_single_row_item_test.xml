<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/ibt_single_sub_vd_RL"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/study_single_itemLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginBottom="@dimen/dp5"
            android:layout_marginStart="@dimen/dp5"
            android:layout_marginEnd="@dimen/dp5">
            <RelativeLayout
                android:id="@+id/imageRL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/test_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="@dimen/dp10"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp">
                    <RelativeLayout
                        android:id="@+id/thumbRl"
                        android:layout_width="@dimen/dp100"
                        android:layout_height="@dimen/dp67">
                        <ImageView
                            android:id="@+id/profileImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/placeholder_course"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <RelativeLayout
                    android:id="@+id/rl_text_mode"
                    android:background="@drawable/primary_stroke_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:backgroundTint="@color/colorPrimary">
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/test_mode_tv"
                        android:paddingRight="@dimen/dp2"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp4"
                        android:layout_marginTop="@dimen/dp2"
                        android:layout_marginRight="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp2"
                        android:text="Online"
                        android:maxLines="1"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/inter_semibold"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/mainContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_toRightOf="@+id/test_card"
                    android:layout_below="@+id/rl_text_mode"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp2"
                    android:layout_toStartOf="@+id/cvrBoundries"
                    android:layout_toEndOf="@+id/test_card">
                    <TextView
                        android:textSize="@dimen/sp13"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/examPrepTitleTV"
                        android:paddingLeft="-1dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="hdgfg dshdshhds hdshdsh  bvdv fdfd fdfdf dffd dfdffd dfdffd dfdfd  "
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_bold"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/startdate"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp2"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/subItemRV"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp2"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_semibold"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4">
                        <TextView
                            android:textSize="@dimen/small_text_size2"
                            android:textColor="@color/country_code_text_color"
                            android:ellipsize="end"
                            android:id="@+id/test_price_tv1"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/registration_fee"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_below="@+id/startdate"
                            android:fontFamily="@font/inter_medium"/>
                        <TextView
                            android:textSize="@dimen/small_text_size2"
                            android:textColor="@color/colorPrimary"
                            android:ellipsize="end"
                            android:id="@+id/test_price_tv"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12000/-"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:layout_below="@+id/startdate"
                            android:fontFamily="@font/inter_semibold"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/cvrBoundries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">
                    <RelativeLayout
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/lockRL"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10">
                        <ImageView
                            android:layout_width="@dimen/dp24"
                            android:layout_height="@dimen/dp24"
                            android:src="@mipmap/gray_lock"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/forwardIV"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:src="@mipmap/forward_black"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/contantLL"
                android:paddingTop="@dimen/dp6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imageRL">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/view_result"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:text="@string/view_result"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_marginEnd="@dimen/dp4"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/attemptLL"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_toEndOf="@+id/view_result">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:gravity="bottom"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attempt_now"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/learn"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:text="@string/learn"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_toEndOf="@+id/attemptLL"/>
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/practice"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:text="@string/practice"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_toEndOf="@+id/learn"/>
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/testResume"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:text="@string/resume"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_toEndOf="@+id/practice"/>
                <ImageView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/share"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:src="0x7f080613"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/small_text_size2"
                android:textColor="@color/country_code_text_color"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/registerText"
                android:background="@drawable/round_corner_button_bg_grey"
                android:paddingTop="@dimen/dp5"
                android:paddingBottom="@dimen/dp5"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp30"
                android:layout_marginRight="@dimen/dp4"
                android:text="Registered"
                android:includeFontPadding="false"
                android:layout_below="@+id/imageRL"
                android:fontFamily="@font/amazon_ember_bd"
                android:paddingStart="@dimen/dp5"
                android:paddingEnd="@dimen/dp5"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <include layout="@layout/no_data_found"/>
</RelativeLayout>
