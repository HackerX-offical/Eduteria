<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp20"
        android:textStyle="bold"
        android:textColor="@color/black_405461"
        android:id="@+id/txt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp24"
        android:text="Advance Filters"
        android:fontFamily="@font/inter_bold"/>
    <ImageView
        android:id="@+id/cancel"
        android:padding="@dimen/dp4"
        android:layout_width="@dimen/dp30"
        android:layout_height="@dimen/dp30"
        android:layout_marginTop="@dimen/dp24"
        android:src="@mipmap/crossfeed"
        android:tint="@color/button_right"
        android:layout_marginEnd="@dimen/dp20"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/sp16"
        android:textColor="@color/black_405461"
        android:id="@+id/txt2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="34dp"
        android:text="Sub-Category"
        android:layout_below="@+id/txt1"
        android:fontFamily="@font/inter_medium"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt2">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/subcat"
            android:background="@drawable/round_corner_border_advacefilter"
            android:paddingTop="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp20">
            <TextView
                android:textSize="@dimen/post_text_size_x"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_light"
                android:layout_gravity="top"
                android:id="@+id/subcatspinner"
                android:paddingLeft="@dimen/dp5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:hint="Select Sub-Category"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/spinnerIV"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter_bold"/>
            <ImageView
                android:id="@+id/spinnerIV"
                android:padding="@dimen/dp4"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/arrow_down"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp16"
        android:textColor="@color/black_405461"
        android:id="@+id/txt3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp17"
        android:text="Post Type"
        android:layout_below="@+id/rl1"
        android:fontFamily="@font/inter_medium"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt3">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/posttype"
            android:background="@drawable/round_corner_border_advacefilter"
            android:paddingTop="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp20">
            <TextView
                android:textSize="@dimen/post_text_size_x"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_light"
                android:layout_gravity="top"
                android:id="@+id/posttypeytext"
                android:paddingLeft="@dimen/dp5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:hint="Select Post Type"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/launguageIV"
                android:layout_centerInParent="true"
                android:inputType="text"
                android:fontFamily="@font/inter_bold"/>
            <ImageView
                android:id="@+id/launguageIV"
                android:padding="@dimen/dp4"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/arrow_down"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <androidx.cardview.widget.CardView
        android:background="@color/off_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:layout_below="@+id/rl2">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/sp16"
                android:textColor="@color/profile_text_color"
                android:id="@+id/filterdata"
                android:background="@drawable/bg_round_corners_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp40"
                android:layout_marginRight="@dimen/dp20"
                android:text="Apply Filter"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_bold"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
