<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="end"
        android:id="@+id/cvrRightAudio"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp5">
        <RelativeLayout
            android:layout_gravity="end"
            android:id="@+id/rl_audio_right"
            android:layout_width="@dimen/dp200"
            android:layout_height="wrap_content">
            <LinearLayout
                android:theme="@style/ThemeOverlay.AppCompat.Dark"
                android:gravity="right"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/mainRl6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/mainContainerLL"
                    android:background="@drawable/chat_bubble_user"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp10"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp6"
                    android:layout_weight="3">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/ivPinAudio"
                            android:visibility="gone"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginLeft="@dimen/dp15"
                            android:layout_marginTop="@dimen/dp2"
                            android:src="@mipmap/red_pin"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="15.8sp"
                            android:textColor="@color/country_code_text_color"
                            android:ellipsize="end"
                            android:layout_gravity="end"
                            android:id="@+id/audioText_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="130dp"
                            android:text="Wijaya Abadi addda zzz"
                            android:maxLines="2"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"
                            android:textAlignment="textEnd"
                            android:layout_marginEnd="@dimen/dp10"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="right"
                        android:paddingTop="@dimen/dp2"
                        android:paddingBottom="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp15">
                        <ImageView
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/userimage"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/voicenote"
                            android:layout_marginStart="@dimen/dp2"/>
                        <TextView
                            android:textColor="@color/black"
                            android:id="@+id/textaudio"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/audio"
                            android:paddingStart="@dimen/dp10"
                            android:paddingEnd="@dimen/dp10"
                            android:layout_marginStart="@dimen/dp10"/>
                        <Button
                            android:id="@+id/audioplay"
                            android:background="@mipmap/play_audio_icon"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_marginStart="@dimen/dp10"
                            android:backgroundTint="@color/colorPrimary"/>
                        <Button
                            android:id="@+id/audiopause"
                            android:background="0x7f08052f"
                            android:visibility="gone"
                            android:layout_width="@dimen/dp20"
                            android:layout_height="@dimen/dp20"
                            android:layout_marginStart="@dimen/dp10"
                            android:backgroundTint="@color/colorPrimary"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp10"/>
                    <LinearLayout
                        android:layout_gravity="end"
                        android:orientation="horizontal"
                        android:id="@+id/timeRl_7"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp25"
                        android:layout_below="@+id/mainRl6"
                        android:layout_marginEnd="@dimen/dp5"
                        android:layout_alignParentEnd="true">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#979797"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/righttexttimeAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21-12"
                            android:fontFamily="@font/inter_regular"
                            android:layout_marginStart="@dimen/dp10"/>
                        <View
                            android:layout_gravity="center_vertical"
                            android:background="#979797"
                            android:visibility="visible"
                            android:layout_width="@dimen/dp1"
                            android:layout_height="13dp"
                            android:layout_marginStart="@dimen/dp10"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:visibility="visible"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:src="@drawable/ic_more_vert"
                            android:tint="#979797"
                            android:layout_toEndOf="@+id/lefttexttime"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
