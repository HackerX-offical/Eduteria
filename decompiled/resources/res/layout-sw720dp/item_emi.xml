<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/dp4"
    android:paddingBottom="@dimen/dp4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7.8">
            <TextView
                android:textSize="@dimen/small_text_size"
                android:textStyle="bold"
                android:textColor="@color/country_code_text_color"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"/>
            <TextView
                android:textSize="@dimen/extrasmall_text_size_12"
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/status_ll"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.2">
            <TextView
                android:textSize="@dimen/extramini_extrasmall_text_size"
                android:textColor="@color/dot_white"
                android:id="@+id/text_status"
                android:background="@drawable/button_background_status_pending"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:textAlignment="center"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/small_text_size"
        android:textStyle="bold"
        android:textColor="@color/app_bg"
        android:gravity="center"
        android:id="@+id/next_payment_txt"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginBottom="@dimen/dp2"
        android:text="@string/next_payment"/>
</LinearLayout>
