<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp70"
    android:layout_marginTop="@dimen/dp4"
    android:layout_marginBottom="@dimen/dp6"
    android:layout_marginStart="@dimen/dp4"
    android:layout_marginEnd="@dimen/dp4"
    app:cardCornerRadius="@dimen/dp10"
    app:cardElevation="@dimen/dp4">
    <RelativeLayout
        android:id="@+id/mainRl"
        android:padding="@dimen/dp7"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/dp100"
            android:layout_height="@dimen/dp100"
            android:src="@mipmap/folder"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp10"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/black"
            android:id="@+id/folderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_centerVertical="true"
            android:fontFamily="@font/amazon_ember_cdrc_bd"
            android:layout_marginStart="@dimen/dp15"
            android:layout_toEndOf="@+id/icon"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
