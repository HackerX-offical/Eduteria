<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp10"
    android:layout_marginStart="@dimen/dp5"
    android:layout_marginEnd="@dimen/dp5">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black_text_color_dim"
        android:id="@+id/optionNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Option 1"
        android:fontFamily="@font/inter_bold"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#05c190"
        android:id="@+id/remove"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove"
        android:fontFamily="@font/inter_medium"
        android:layout_marginEnd="@dimen/dp5"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/optionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp7"
        android:layout_below="@+id/optionNumber">
        <ImageView
            android:id="@+id/correctAnswer"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/check_option"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp10"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/colorActionBarText"
            android:textColorHint="@color/colorActionBarText"
            android:id="@+id/enterOptionEt"
            android:background="@drawable/gray_border"
            android:padding="@dimen/dp10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp6"
            android:hint="Enter Option"
            android:fontFamily="@font/inter_medium"
            android:layout_toEndOf="@+id/correctAnswer"/>
    </RelativeLayout>
</RelativeLayout>
