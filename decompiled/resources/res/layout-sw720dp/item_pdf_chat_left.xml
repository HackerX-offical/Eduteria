<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dp220"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/cvrLeftpdf"
        android:visibility="visible"
        android:layout_width="@dimen/dp250"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp5">
        <LinearLayout
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            android:orientation="horizontal"
            android:id="@+id/nav_headerLLPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/mainRl5"
                android:background="@drawable/chat_bubble"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp6"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15.8sp"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/pdfText_usernameLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="150dp"
                        android:text="Wijaya Abadi sdjbfjksd"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:id="@+id/ivPinMsgLeftPdf"
                        android:visibility="gone"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="5dp"
                        android:src="@mipmap/red_pin"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp15"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/pdfViewLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp12"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/pdflayoutLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:padding="@dimen/dp5"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp2"
                            android:src="@mipmap/pdf_icon"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/black"
                            android:ellipsize="end"
                            android:layout_gravity="center"
                            android:id="@+id/pdfNameLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PDF"
                            android:maxLines="2"
                            android:layout_marginStart="@dimen/dp5"/>
                    </LinearLayout>
                    <ImageView
                        android:background="@mipmap/download_active"
                        android:visibility="gone"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginLeft="@dimen/dp10"
                        android:layout_marginTop="@dimen/dp5"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp10">
                    <RelativeLayout
                        android:id="@+id/cvrDownLoadLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/downloadIcLeft"
                            android:padding="@dimen/dp3"
                            android:layout_width="@dimen/dp25"
                            android:layout_height="@dimen/dp25"
                            android:src="@mipmap/download_active"
                            android:tint="@color/colorPrimary"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/colorPrimary"
                            android:id="@+id/tvLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/download"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/downloadIcLeft"/>
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/timeRl_6"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp25"
            android:layout_below="@+id/nav_headerLLPdf">
            <TextView
                android:textSize="12sp"
                android:textColor="#979797"
                android:layout_gravity="center_vertical"
                android:id="@+id/pdf_timeLeftPdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21-12"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="@dimen/dp10"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="#979797"
                android:visibility="gone"
                android:layout_width="@dimen/dp1"
                android:layout_height="13dp"
                android:layout_marginStart="@dimen/dp10"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_more_vert"
                android:tint="#979797"
                android:layout_toEndOf="@+id/lefttexttime"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
