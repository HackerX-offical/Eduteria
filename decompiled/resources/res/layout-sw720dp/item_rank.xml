<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp3"
    android:layout_marginBottom="@dimen/dp5"
    android:layout_marginStart="@dimen/dp10"
    android:layout_marginEnd="@dimen/dp10"
    app:cardCornerRadius="@dimen/dp10"
    app:cardElevation="@dimen/dp4">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rankLL"
        android:background="@color/colorGray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imgSuccess"
                android:visibility="gone"
                android:layout_width="@dimen/dp25"
                android:layout_height="@dimen/dp25"
                android:layout_marginTop="-15dp"
                android:layout_marginRight="-15dp"
                android:src="@mipmap/score_result_screen"
                android:layout_weight="0.2"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imgthumb"
                android:layout_width="@dimen/dp60"
                android:layout_height="@dimen/dp60"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@mipmap/default_pic"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/imageIVText"
                android:paddingTop="@dimen/dp13"
                android:paddingBottom="@dimen/dp13"
                android:visibility="gone"
                android:layout_width="@dimen/dp60"
                android:layout_height="@dimen/dp60"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@mipmap/default_pic"
                android:scaleType="fitCenter"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp10"
                android:layout_weight="1.8">
                <TextView
                    android:textSize="@dimen/sp10"
                    android:textColor="@color/colorPrimary"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_your_rank"
                    android:paddingTop="@dimen/dp2"
                    android:paddingBottom="@dimen/dp2"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Rank"
                    android:fontFamily="@font/inter_medium"
                    android:paddingEnd="@dimen/dp15"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="3">
                        <TextView
                            android:textSize="@dimen/dp15"
                            android:textColor="@color/country_code_text_color"
                            android:gravity="center_vertical"
                            android:id="@+id/textname"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Ramesh Singh"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/country_code_text_color"
                            android:gravity="center"
                            android:id="@+id/mark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10/10"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"
                            android:paddingEnd="@dimen/dp15"/>
                        <TextView
                            android:textSize="@dimen/dp14"
                            android:textColor="@color/country_code_text_color"
                            android:gravity="end|center_vertical"
                            android:id="@+id/textrank"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="10/10"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"
                            android:paddingEnd="@dimen/dp15"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
