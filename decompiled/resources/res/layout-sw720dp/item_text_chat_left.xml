<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/cvrLeft"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp5">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/nav_headerLL"
            android:background="@drawable/chat_bubble"
            android:paddingLeft="@dimen/dp10"
            android:paddingTop="@dimen/dp10"
            android:paddingRight="@dimen/dp10"
            android:paddingBottom="@dimen/dp10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp6">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15.8sp"
                    android:textColor="@color/colorPrimary"
                    android:ellipsize="end"
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="250dp"
                    android:text="Wijaya Abadi sdfbjs asdffnaksd adfnknsad"
                    android:maxLines="2"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10"/>
                <ImageView
                    android:id="@+id/ivPinMsgLeft"
                    android:visibility="gone"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="@dimen/dp3"
                    android:src="@mipmap/red_pin"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp20"
                    android:layout_toEndOf="@+id/userName"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black_405461"
                android:id="@+id/letfmessageTv"
                android:paddingTop="@dimen/dp6"
                android:paddingBottom="@dimen/dimen_6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lorem Ipsum is simply dummy text of the printing and typesetting"
                android:alpha="0.7"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="@dimen/dp10"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/studentCot_linear"
                android:background="@drawable/background_rank_two"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp4"
                android:layout_marginStart="@dimen/dp10">
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/studentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:textColor="@color/black_405461"
                    android:id="@+id/studentMessageTv"
                    android:paddingTop="@dimen/dp6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:fontFamily="@font/inter_regular"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/reply_file_ll"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/reply_file_img"
                        android:padding="@dimen/dp5"
                        android:visibility="visible"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:layout_margin="@dimen/dp2"
                        android:src="@mipmap/pdf_icon"/>
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/black_405461"
                        android:layout_gravity="center"
                        android:id="@+id/reply_file_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alok reply"
                        android:layout_marginStart="@dimen/dp4"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/timeRl_1"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp25"
                android:layout_below="@+id/nav_headerLL">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#979797"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/lefttexttime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21-12"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginStart="@dimen/dp10"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/editedLayoutLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="#979797"
                        android:visibility="visible"
                        android:layout_width="@dimen/dp1"
                        android:layout_height="13dp"
                        android:layout_marginStart="@dimen/dp8"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/editedLayoutLeft1"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp3"
                        android:layout_marginStart="@dimen/dp10">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="#979797"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/leftEdited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edited"
                            android:fontFamily="@font/inter_regular"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/leftEditImg"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_more_vert"
                        android:layout_toEndOf="@+id/lefttexttime"
                        app:tint="#979797"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
