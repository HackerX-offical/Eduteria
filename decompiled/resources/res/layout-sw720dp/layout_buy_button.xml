<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/buttonLow"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:elevation="10dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp1"
        android:paddingRight="@dimen/dp1"
        android:paddingBottom="@dimen/dp1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/priceLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp8"
            android:layout_weight="0.8">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sp12"
                    android:paddingRight="@dimen/dp1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:textAlignment="textStart"/>
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:id="@+id/mrpCutTV"
                    android:paddingLeft="@dimen/dp2"
                    android:paddingRight="@dimen/dp1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp2"
                    android:text="@string/na"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:textAlignment="textStart"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/priceTV"
                    android:paddingRight="@dimen/dp1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/na"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:textAlignment="textStart"/>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_10"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_gstDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/include_gst"
                    android:maxLines="2"
                    android:layout_alignParentBottom="true"
                    android:fontFamily="@font/inter_regular"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_alignParentEnd="true"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear_addToCart"
            android:background="@drawable/round_corner_border_login_signup"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:padding="@dimen/dp9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cart_icon"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/post_text_size"
            android:textStyle="bold"
            android:textColor="@color/commonBtnTextColor"
            android:id="@+id/buyNowBtn"
            android:background="@drawable/common_round_corners_button_drawable"
            android:padding="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp8"
            android:text="@string/buy_now"
            android:layout_weight="1.1"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"/>
        <Button
            android:textSize="@dimen/small_text_size2"
            android:textStyle="bold"
            android:textColor="@color/commonBtnTextColor"
            android:id="@+id/myLibBtn"
            android:background="@drawable/common_round_corners_button_drawable"
            android:padding="@dimen/dp8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp8"
            android:text="@string/open_in_my_lib"
            android:layout_weight="1.1"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"/>
    </LinearLayout>
</RelativeLayout>
