<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/maincard"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp6"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp6"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/study_single_itemLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/thumbRl"
                    android:layout_width="@dimen/dp100"
                    android:layout_height="@dimen/dp67"
                    android:layout_centerVertical="true">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="@dimen/dp10"
                        app:cardElevation="0dp"
                        app:cardMaxElevation="0dp">
                        <ImageView
                            android:id="@+id/courseImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/square_placeholder_new"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"/>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp10">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/study_item_titleTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColor="@color/color_071E57"
                        android:ellipsize="end"
                        android:layout_gravity="start"
                        android:id="@+id/course_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mathematics"
                        android:maxLines="2"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/liveDate"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="@font/inter_medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/liveTime"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:fontFamily="@font/inter_medium"/>
                    <TextView
                        android:textSize="@dimen/sp10"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/timing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/class_timing_10_00_am_to_11_30_am"
                        android:maxLines="1"
                        android:fontFamily="@font/inter_regular"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true">
                    <TextView
                        android:textSize="@dimen/dp13"
                        android:textStyle="bold"
                        android:textColor="@color/country_code_text_color"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/startedin"
                        android:padding="@dimen/dp3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/starting_in"
                        android:fontFamily="@font/inter_regular"/>
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/white"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/time"
                        android:background="@drawable/bg_round_corner_fill_green_curved"
                        android:padding="@dimen/dp5"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:fontFamily="@font/inter_medium"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/watch_now"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/watch"
                        android:fontFamily="@font/inter_bold"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/view1"
                        android:background="@color/country_code_text_color"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp2"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp10"
                        android:layout_alignParentBottom="true"
                        android:layout_toEndOf="@+id/watch_now"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/listne_now"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/listen"
                        android:fontFamily="@font/inter_bold"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:layout_marginStart="@dimen/dp5"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/pdf_TV"
                        android:background="@drawable/round_corner_button_bg_grey"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pdf"
                        android:fontFamily="@font/inter_bold"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:layout_marginStart="5dp"/>
                    <View
                        android:layout_gravity="center_vertical"
                        android:id="@+id/view2"
                        android:background="@color/country_code_text_color"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp2"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/dp10"
                        android:layout_alignParentBottom="true"
                        android:layout_toEndOf="@+id/watch_now"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:id="@+id/share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="0x7f080613"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp3"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/liveIV"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp6"
            android:src="@mipmap/live"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
