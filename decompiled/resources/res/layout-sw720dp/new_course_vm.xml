<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout-sw720dp/new_course_vm_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp6">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/black"
        android:id="@+id/new_course_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:text="New Courses"
        android:fontFamily="@font/inter_bold"
        android:layout_marginStart="@dimen/dp10"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#faa833"
        android:id="@+id/view_all"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:text="View All"
        android:fontFamily="@font/inter_regular"
        android:layout_marginEnd="@dimen/dp10"
        android:layout_alignParentEnd="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/new_course_recycler"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:layout_below="@+id/new_course_txt"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <View
        android:id="@+id/view1"
        android:background="@color/gray_dark2"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/dp5"
        android:layout_below="@+id/new_course_recycler"/>
</RelativeLayout>
