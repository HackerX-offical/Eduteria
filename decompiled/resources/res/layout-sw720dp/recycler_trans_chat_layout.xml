<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="@dimen/dp3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp20">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_admin"
        android:background="@drawable/trans_bg_lets_massage"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <de.hdodenhof.circleimageview.CircleImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/iv_admin"
            android:layout_width="@dimen/dp25"
            android:layout_height="@dimen/dp25"
            android:src="0x7f08054a"
            android:layout_marginStart="@dimen/dp8"
            app:civ_border_color="@color/colorPrimaryDark"
            app:civ_border_width="0dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp2"
            android:paddingBottom="@dimen/dp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp10">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"/>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:gravity="start"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/tv_time"
                    android:paddingRight="@dimen/dp8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp5"
                    android:maxLines="1"
                    android:textAlignment="textEnd"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/extrasmall_text_size_10"
                android:gravity="start"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp5"
                android:layout_marginTop="@dimen/dp4"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
