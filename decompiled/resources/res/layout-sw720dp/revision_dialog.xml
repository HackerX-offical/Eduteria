<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/calcpagerl"
    android:background="@drawable/round_bg_notes"
    android:paddingBottom="@dimen/dp10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textSize="@dimen/sp19"
        android:textStyle="bold"
        android:textColor="@color/black_405461"
        android:gravity="center_vertical"
        android:id="@+id/add_coupoun_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp15"
        android:layout_marginBottom="@dimen/dp15"
        android:text="@string/create_title"
        android:layout_marginStart="@dimen/dp15"
        android:layout_marginEnd="@dimen/dp15"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/sp16"
        android:textColor="#1a1919"
        android:gravity="center_vertical"
        android:id="@+id/txt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp30"
        android:layout_marginTop="25dp"
        android:text="@string/enter_title_here"
        android:layout_below="@+id/add_coupoun_txt"
        android:layout_marginStart="6dp"
        android:layout_alignParentStart="true"/>
    <EditText
        android:textSize="@dimen/sp13"
        android:textColor="@color/country_code_text_color"
        android:ellipsize="end"
        android:id="@+id/writeCouponET"
        android:background="@drawable/border_edit_notes"
        android:padding="@dimen/dp18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp5"
        android:hint="Enter title here"
        android:maxLines="2"
        android:layout_below="@+id/txt"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp16"
        android:layout_marginBottom="@dimen/sp16"
        android:layout_below="@+id/writeCouponET"
        android:layout_marginStart="@dimen/sp16"
        android:layout_marginEnd="@dimen/sp16">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/country_code_text_color"
            android:gravity="center"
            android:id="@+id/btn__cancel"
            android:background="@drawable/notes_cancel_bg"
            android:paddingTop="@dimen/dp5"
            android:paddingBottom="@dimen/dp5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            android:layout_marginRight="@dimen/dp10"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_below="@+id/writeCouponET"
            android:fontFamily="@font/amazon_ember_medium"
            android:paddingStart="@dimen/dp30"
            android:paddingEnd="@dimen/dp30"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/commonBtnTextColor"
            android:gravity="center"
            android:id="@+id/btn_submit"
            android:background="@drawable/common_round_corners_button_drawable"
            android:paddingTop="@dimen/dp5"
            android:paddingBottom="@dimen/dp5"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp40"
            android:layout_marginLeft="@dimen/dp10"
            android:text="@string/next"
            android:layout_weight="1"
            android:layout_below="@+id/writeCouponET"
            android:fontFamily="@font/amazon_ember_medium"
            android:paddingStart="@dimen/dp30"
            android:paddingEnd="@dimen/dp30"
            android:layout_alignParentEnd="true"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
