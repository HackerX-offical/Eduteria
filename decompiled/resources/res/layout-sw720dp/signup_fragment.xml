<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/mainLLSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <RelativeLayout
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:background="@drawable/round_corner_border_login_signup"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp60"
                    android:layout_marginTop="@dimen/dp4">
                    <RelativeLayout
                        android:id="@+id/flagMainLL"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="@dimen/dp10"
                        android:layout_marginRight="@dimen/dp10"
                        android:layout_centerVertical="true">
                        <RelativeLayout
                            android:id="@+id/flagRL"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true">
                            <ImageView
                                android:id="@+id/imagestate"
                                android:padding="1dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@mipmap/flag"
                                android:layout_centerVertical="true"/>
                            <View
                                android:id="@+id/loginView1"
                                android:background="#c4c4c4"
                                android:layout_width="@dimen/dp2"
                                android:layout_height="@dimen/dp40"
                                android:layout_marginLeft="@dimen/dp10"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/imagestate"/>
                            <TextView
                                android:textSize="@dimen/sp14"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/tv_code"
                                android:padding="@dimen/dp1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+91"
                                android:layout_toRightOf="@+id/loginView1"
                                android:layout_centerInParent="true"
                                android:fontFamily="@font/inter_bold"
                                android:layout_marginStart="@dimen/dp10"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/flagCountryLL"
                            android:visibility="visible"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <com.hbb20.CountryCodePicker
                                android:id="@+id/countryDropDown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                app:ccp_autoDetectCountry="true"
                                app:ccp_autoFormatNumber="false"/>
                            <View
                                android:background="#c4c4c4"
                                android:layout_width="@dimen/dp2"
                                android:layout_height="@dimen/dp40"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/countryDropDown"/>
                        </RelativeLayout>
                    </RelativeLayout>
                    <EditText
                        android:textSize="@dimen/sp14"
                        android:id="@+id/et_mobile"
                        android:background="@null"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingRight="@dimen/dp10"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/mobile_no"
                        android:maxLines="1"
                        android:maxLength="15"
                        android:layout_toRightOf="@+id/flagMainLL"
                        android:layout_centerInParent="true"
                        android:inputType="phone"
                        android:fontFamily="@font/amazon_ember_rg"/>
                </RelativeLayout>
                <Button
                    android:textSize="@dimen/sp16"
                    android:textStyle="bold"
                    android:textColor="@color/commonBtnTextColor"
                    android:id="@+id/signupBtn"
                    android:background="@drawable/common_round_corners_button_drawable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="54dp"
                    android:text="@string/continuee"
                    android:textAllCaps="false"
                    android:fontFamily="@font/inter_semibold"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/bottom"
                    android:paddingBottom="@dimen/dp30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_alignParentBottom="true">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/commonblack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/by_signing_up"
                            android:fontFamily="@font/amazon_ember_rg"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textStyle="bold"
                        android:textColor="@color/black_405461"
                        android:id="@+id/tv_term_and_condition"
                        android:padding="@dimen/dp4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/term_and_condition_underline"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginStart="@dimen/dp3"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/rl_google_signin"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp12"
                android:layout_below="@+id/mainLLSignIn"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/iv_google"
                    android:layout_width="@dimen/dp30"
                    android:layout_height="@dimen/dp30"
                    android:src="0x7f08037f"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
