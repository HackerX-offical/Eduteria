<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp75"
    android:layout_margin="@dimen/dp5"
    app:cardCornerRadius="@dimen/dp12">
    <RelativeLayout
        android:id="@+id/parentRL"
        android:background="@drawable/bg_home_tab_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tabIV"
            android:layout_width="@dimen/dp40"
            android:layout_height="@dimen/dp40"
            android:src="@mipmap/ic_launcher"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp15"/>
        <TextView
            android:textSize="@dimen/sp15"
            android:textColor="@color/black"
            android:id="@+id/tabTitle"
            android:padding="@dimen/dp4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Title"
            android:maxLines="3"
            android:layout_centerVertical="true"
            android:fontFamily="@font/inter_medium"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp5"
            android:layout_toEndOf="@+id/tabIV"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
