<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parentLL"
    android:layout_width="120dp"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp3"
        android:layout_marginTop="@dimen/dp2"
        android:layout_marginRight="@dimen/dp4"
        android:layout_marginBottom="@dimen/dp2"
        app:cardElevation="@dimen/dp2">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imageIV"
                android:padding="@dimen/dp1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp100"
                android:src="@mipmap/default_pic"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp1"
                android:layout_below="@+id/imageIV"
                android:layout_centerVertical="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/dp3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_11"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/nameTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AIMS PG"
                        android:maxLines="2"
                        android:minLines="2"/>
                    <TextView
                        android:textSize="@dimen/extra_extrasmall_text_size"
                        android:textColor="@color/black_overlay"
                        android:id="@+id/priceTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 230"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_11"
                        android:textColor="@color/black_overlay"
                        android:id="@+id/learnerTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1234 learners"
                        android:maxLines="1"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:weightSum="1"
                    android:layout_weight="0.5">
                    <RatingBar
                        android:layout_gravity="center_vertical"
                        android:id="@+id/ratingRB"
                        android:paddingTop="@dimen/dp1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:max="5"
                        android:rating="5"
                        android:stepSize="0.5"
                        android:layout_weight="1"
                        style="@style/Widget.AppCompat.RatingBar.Small"/>
                    <TextView
                        android:textSize="@dimen/small_text_size"
                        android:textColor="@color/black_overlay"
                        android:gravity="center_vertical"
                        android:id="@+id/ratingTV"
                        android:padding="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.0"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
