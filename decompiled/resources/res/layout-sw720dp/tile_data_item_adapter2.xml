<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/currentAffairRL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/topCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="5dp">
        <RelativeLayout
            android:padding="@dimen/dp2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ibt_single_vd_iv"
                android:layout_width="@dimen/dp45"
                android:layout_height="@dimen/dp45"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:id="@+id/cvr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/ibt_single_vd_iv">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/ibt_current_affair_title"
                        android:padding="3dp"
                        android:layout_width="250dp"
                        android:layout_height="30dp"
                        android:text="Appsquadz Testing "
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:id="@+id/desc"
                        android:padding="3dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:text=""
                        android:maxLines="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/liveIV"
                        android:padding="@dimen/dp2"
                        android:visibility="visible"
                        android:layout_width="@dimen/dp30"
                        android:layout_height="@dimen/dp20"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:src="@mipmap/live"
                        android:scaleType="fitXY"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"/>
                    <ImageView
                        android:id="@+id/new_course"
                        android:padding="@dimen/dp2"
                        android:visibility="visible"
                        android:layout_width="@dimen/dp60"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:src="@mipmap/new_"
                        android:scaleType="fitXY"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
