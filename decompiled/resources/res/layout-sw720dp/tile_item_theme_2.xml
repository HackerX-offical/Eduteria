<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="@dimen/dp8">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/maiView"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ibt_single_vd_iv"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@mipmap/placeholder_course"
                android:scaleType="fitXY"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/soldOutImg"
                android:background="#4d000000"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="30sp"
                    android:textColor="#d32f2f"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sold_out_stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sold_out"
                    android:rotation="-15"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="0.1"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/liveIV"
                android:padding="@dimen/dp2"
                android:visibility="visible"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp20"
                android:layout_marginTop="3dp"
                android:src="@mipmap/live"
                android:scaleType="fitXY"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="@dimen/dp3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/new_course"
                android:visibility="visible"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp20"
                android:layout_marginTop="3dp"
                android:src="@mipmap/new_"
                android:scaleType="fitXY"
                android:layout_marginEnd="3dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <RelativeLayout
                android:id="@+id/discountRL"
                android:background="@drawable/discount_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="3dp"
                app:layout_constraintBottom_toTopOf="@+id/ibt_current_affair_title"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:textSize="@dimen/sp12"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/discountTV"
                    android:padding="@dimen/dp4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0% off"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginHorizontal="@dimen/dp5"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/sp14"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/ibt_current_affair_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                android:text="@string/loading"
                android:maxLines="2"
                android:minLines="2"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ibt_single_vd_iv"/>
            <TextView
                android:id="@+id/tileSubTitle"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="For NEET 2024 Dropper Aspirants"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ibt_current_affair_title"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/validityRowId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tileSubTitle">
                <TextView
                    android:textSize="13sp"
                    android:layout_gravity="center"
                    android:id="@+id/validityTextTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    app:drawableStartCompat="@drawable/ic_calender"/>
                <TextView
                    android:textSize="13sp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ends on 30 Jun 2024"
                    android:drawablePadding="6dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="14dp"
                    app:drawableStartCompat="@drawable/ic_calender"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/courseDurationrRow"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/validityRowId">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/rating_star"
                    android:layout_marginStart="13dp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course Duration"
                    android:layout_marginEnd="3dp"/>
                <View
                    android:background="#aaa6a6"
                    android:layout_width="1dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lectures"
                    android:layout_marginEnd="3dp"/>
                <View
                    android:background="#aaa6a6"
                    android:layout_width="1dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Course_Type &amp; many"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="#e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dimen_1dp"
                android:layout_marginTop="@dimen/dp6"
                android:layout_marginHorizontal="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/courseDurationrRow"/>
            <RelativeLayout
                android:id="@+id/price_linear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider">
                <TextView
                    android:textSize="@dimen/sp14"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/priceTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp7"
                    android:text="00.00"
                    android:maxLines="1"
                    android:fontFamily="@font/inter_semibold"
                    android:textAlignment="textEnd"
                    android:layout_marginEnd="@dimen/dp6"/>
                <TextView
                    android:textSize="@dimen/sp11"
                    android:textColor="@color/black_white"
                    android:id="@+id/mrpCutTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp9"
                    android:text="0.00"
                    android:maxLines="1"
                    android:fontFamily="@font/inter_regular"
                    android:textAlignment="textStart"
                    android:layout_marginEnd="@dimen/dp15"
                    android:layout_toEndOf="@+id/priceTV"/>
            </RelativeLayout>
            <TextView
                android:textSize="14sp"
                android:id="@+id/fullBatchId"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="(For Full Batch)"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/price_linear"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fullBatchId">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:ellipsize="end"
                    android:id="@+id/exploreId"
                    android:background="@drawable/discount_light_bg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp0"
                    android:text="@string/explore"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:textAlignment="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/commonBtnTextColor"
                    android:ellipsize="end"
                    android:id="@+id/buyNowId"
                    android:background="@drawable/round_bg_black_corner"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp0"
                    android:text="@string/buy_now"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:textAlignment="center"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10">
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/cartSection"
                android:background="@drawable/cart_bg_grey_new"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_marginStart="@dimen/dp5">
                <ImageView
                    android:id="@+id/cartIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp5"
                    android:src="@drawable/cart_black"
                    app:tint="@color/white"/>
            </RelativeLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/black"
                android:id="@+id/buyNowId1"
                android:background="@drawable/round_button_bg_yellow"
                android:paddingTop="@dimen/dp9"
                android:paddingBottom="@dimen/dp9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUY NOW"
                android:fontFamily="@font/inter_semibold"
                android:textAlignment="center"
                android:paddingStart="@dimen/dp20"
                android:paddingEnd="@dimen/dp20"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
