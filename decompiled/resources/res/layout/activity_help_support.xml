<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="@dimen/dp2">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/myProgress_toolbar"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/searchSV"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="@dimen/sp18"
                    android:textColor="@color/commonToolbarTextColor"
                    android:id="@+id/toolbartitleTV"
                    android:paddingLeft="@dimen/dp5"
                    android:paddingRight="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/help_supports"
                    android:layout_alignParentLeft="true"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/inter_bold"/>
                <ImageView
                    android:id="@+id/imageIV"
                    android:padding="@dimen/dp12"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp50"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_date_range_black_24dp"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnpcd"
        android:layout_below="@+id/app_bar_layout">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/courseRL"
                android:padding="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/sub_heading_text_size"
                    android:typeface="serif"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/orderLabelTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp8"
                    android:text="@string/course_name"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginStart="@dimen/dp8"
                    android:layout_marginEnd="@dimen/dp8"/>
                <TextView
                    android:textSize="@dimen/post_text_size"
                    android:typeface="serif"
                    android:id="@+id/courseIdTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp8"
                    android:text="Stuff Selection Commission"
                    android:layout_below="@+id/orderLabelTxt"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginStart="@dimen/dp8"
                    android:layout_marginEnd="@dimen/dp8"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <EditText
                    android:textSize="@dimen/small_text_size"
                    android:id="@+id/title"
                    android:background="@drawable/round_corner_border_login_signup"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp16"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp8"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp4"
                    android:hint="Title"
                    android:maxLines="1"
                    android:inputType="text"
                    android:fontFamily="@font/inter_medium"/>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:textColor="@color/black_white_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="@dimen/dp12"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/content"
                    android:textAlignment="center"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/round_corner_border_login_signup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp8"
                    android:layout_marginRight="@dimen/dp8"
                    android:layout_marginBottom="@dimen/dp4">
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:textSize="@dimen/post_text_size"
                        android:id="@+id/feedtype"
                        android:padding="@dimen/dp8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Type"
                        android:spinnerMode="dialog"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp12">
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColor="@color/black_white_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/comment"
                        android:textAlignment="center"/>
                    <EditText
                        android:textSize="@dimen/post_text_size"
                        android:gravity="top"
                        android:id="@+id/comment_et"
                        android:background="@drawable/round_corner_border_login_signup"
                        android:padding="@dimen/dp8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="true"
                        android:minLines="7"
                        android:inputType="textMultiLine"
                        android:textCursorDrawable="@null"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/btnpcd"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="10dp">
        <Button
            android:textSize="@dimen/post_text_size_x"
            android:textStyle="bold"
            android:textColor="@color/commonBtnTextColor"
            android:id="@+id/submitBtn"
            android:background="@drawable/common_round_corners_button_drawable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_medium"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp12"/>
    </RelativeLayout>
</RelativeLayout>
