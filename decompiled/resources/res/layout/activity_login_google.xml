<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@color/loginHeaderColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_logo_login"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp16"
            android:textStyle="bold"
            android:textColor="@color/black_405461"
            android:id="@+id/tv_term_and_condition"
            android:padding="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/fill_your_profile_details"
            android:fontFamily="@font/inter_regular"
            android:layout_marginStart="@dimen/dp3"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <EditText
                android:enabled="false"
                android:textSize="@dimen/small_text_size"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_light"
                android:id="@+id/et_name"
                android:background="@drawable/round_corner_border_login_signup"
                android:paddingTop="@dimen/dp20"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp4"
                android:hint="@string/name"
                android:maxLines="1"
                android:inputType="textCapWords"
                android:fontFamily="@font/inter_medium"
                android:paddingStart="@dimen/dp15"
                android:paddingEnd="@dimen/dp15"/>
            <EditText
                android:enabled="false"
                android:textSize="@dimen/small_text_size"
                android:textColor="@color/black"
                android:textColorHint="@color/gray_light"
                android:id="@+id/et_email"
                android:background="@drawable/round_corner_border_login_signup"
                android:paddingTop="@dimen/dp20"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp15"
                android:layout_marginBottom="@dimen/dp4"
                android:hint="@string/email"
                android:maxLines="1"
                android:inputType="textWebEmailAddress"
                android:fontFamily="@font/inter_medium"
                android:paddingStart="@dimen/dp15"
                android:paddingEnd="@dimen/dp15"/>
            <RelativeLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:background="@drawable/round_corner_border_login_signup"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp60"
                android:layout_marginTop="@dimen/dp15">
                <RelativeLayout
                    android:id="@+id/flagMainLL"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp10"
                    android:layout_marginRight="@dimen/dp10">
                    <RelativeLayout
                        android:layout_gravity="bottom"
                        android:id="@+id/flagRL"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true">
                        <ImageView
                            android:id="@+id/imagestate"
                            android:padding="1dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@mipmap/flag"
                            android:layout_centerVertical="true"/>
                        <View
                            android:id="@+id/loginView1"
                            android:background="#c4c4c4"
                            android:layout_width="@dimen/dp2"
                            android:layout_height="@dimen/dp40"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_toEndOf="@+id/imagestate"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/country_code_text_color"
                            android:id="@+id/tv_code"
                            android:padding="@dimen/dp1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+91"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/inter_bold"
                            android:layout_marginStart="@dimen/dp10"
                            android:layout_toEndOf="@+id/loginView1"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/flagCountryLL"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <com.hbb20.CountryCodePicker
                            android:id="@+id/countryDropDown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            app:ccp_autoDetectCountry="true"
                            app:ccp_autoFormatNumber="false"/>
                        <View
                            android:background="#c4c4c4"
                            android:layout_width="@dimen/dp2"
                            android:layout_height="@dimen/dp40"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/countryDropDown"/>
                    </RelativeLayout>
                </RelativeLayout>
                <EditText
                    android:textSize="@dimen/sp14"
                    android:textColorHint="@color/gray_light"
                    android:id="@+id/et_mobile_number"
                    android:background="@null"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingRight="@dimen/dp10"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/mobile_no"
                    android:maxLines="1"
                    android:maxLength="15"
                    android:layout_toRightOf="@+id/flagMainLL"
                    android:layout_centerInParent="true"
                    android:inputType="phone"
                    android:fontFamily="@font/amazon_ember_rg"/>
            </RelativeLayout>
            <Button
                android:textSize="@dimen/sp16"
                android:textColor="@color/commonBtnTextColor"
                android:id="@+id/btn_submit"
                android:background="@drawable/common_round_corners_button_drawable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:layout_marginBottom="4dp"
                android:text="@string/submit"
                android:includeFontPadding="false"
                android:textAllCaps="false"
                android:fontFamily="@font/amazon_ember_rg"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
