<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:padding="@dimen/dp3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:padding="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/study_single_itemLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/imCover"
                        android:layout_width="@dimen/dp60"
                        android:layout_height="@dimen/dp75"
                        android:layout_centerVertical="true">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="@dimen/dp10"
                            app:cardElevation="0dp"
                            app:cardMaxElevation="0dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <com.makeramen.roundedimageview.RoundedImageView
                                    android:id="@+id/courseImage"
                                    android:visibility="visible"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_marginTop="@dimen/dp10"
                                    android:src="@mipmap/course_placeholder"
                                    android:scaleType="fitXY"
                                    android:layout_marginStart="@dimen/dp10"
                                    app:riv_corner_radius="10dp"
                                    app:riv_oval="false"/>
                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/imCover"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp15"
                        android:layout_marginEnd="@dimen/dp5">
                        <LinearLayout
                            android:layout_gravity="start"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="10">
                            <TextView
                                android:textSize="@dimen/post_text_size"
                                android:textColor="@color/country_code_text_color"
                                android:ellipsize="end"
                                android:id="@+id/study_item_titleTV"
                                android:padding="@dimen/dp1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mathematics"
                                android:maxLines="2"
                                android:layout_weight="9"
                                android:fontFamily="@font/inter_semibold"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/sp11"
                                android:textColor="@color/black_405461"
                                android:ellipsize="end"
                                android:padding="@dimen/dp1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/added"
                                android:maxLines="1"
                                android:fontFamily="@font/inter_medium"/>
                            <TextView
                                android:textSize="@dimen/sp11"
                                android:textColor="@color/black_405461"
                                android:ellipsize="end"
                                android:id="@+id/purchase_date"
                                android:padding="@dimen/dp1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:maxLines="1"
                                android:fontFamily="@font/inter_medium"/>
                        </LinearLayout>
                        <TextView
                            android:textColor="@color/live_video_red"
                            android:id="@+id/transer_text"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="transferred"
                            android:textAllCaps="true"
                            android:fontFamily="@font/inter_bold"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_gravity="end"
                        android:id="@+id/more"
                        android:padding="@dimen/dp6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_more_vert"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <ImageView
                    android:id="@+id/liveIV"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/live"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/dp25"/>
                <ImageView
                    android:id="@+id/forwardIV"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp15"
                    android:layout_height="@dimen/dp15"
                    android:src="@mipmap/forward_black"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/dividerView"
                android:background="#8cbdbdbd"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="4dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/dp8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/expiredLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/dp5"
                    android:weightSum="1"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/expires_on"
                        android:layout_weight="0.31"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:layout_weight="0.1"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:textColor="@color/colorActionBarText"
                        android:id="@+id/expiry_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="O554"
                        android:layout_weight="0.6"
                        android:fontFamily="@font/inter_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="@dimen/dp5"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:id="@+id/orderLabelTxt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/order_id_payment_history"
                        android:layout_weight="0.32"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:layout_weight="0.1"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:textColor="@color/colorActionBarText"
                        android:id="@+id/orderIdTxt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="O554"
                        android:layout_weight="0.6"
                        android:layout_below="@+id/orderLabelTxt"
                        android:fontFamily="@font/inter_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/payment_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp5"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:id="@+id/idLabelTxt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_id_payment_history"
                        android:layout_weight="0.3"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:layout_weight="0.1"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:textColor="@color/colorActionBarText"
                        android:id="@+id/paymentIdTxt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="P123456789"
                        android:layout_weight="0.6"
                        android:fontFamily="@font/inter_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/total_paid_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp5"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:textStyle="bold"
                        android:id="@+id/paidLabelTxt"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/total_paid_payment_history"
                        android:layout_weight="0.3"
                        android:layout_alignParentTop="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:layout_weight="0.1"/>
                    <TextView
                        android:textSize="12sp"
                        android:typeface="serif"
                        android:textColor="@color/colorActionBarText"
                        android:id="@+id/paidAmountTxt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/free_course"
                        android:layout_weight="0.6"
                        android:layout_below="@+id/paidLabelTxt"
                        android:fontFamily="@font/inter_semibold"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/extend_validy"
                android:background="@drawable/btn_back_with_ripple"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp30"
                android:layout_marginTop="@dimen/dp10"
                android:layout_marginBottom="@dimen/dp5"
                android:text="@string/extend_validity"
                android:layout_below="@+id/remaing_days"
                android:fontFamily="@font/inter_medium"
                android:paddingStart="@dimen/dp10"
                android:paddingEnd="@dimen/dp10"
                android:layout_marginStart="10dp"
                android:layout_alignParentEnd="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/cvrNewUi"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/ibt_single_sub_vd_RL"
                android:padding="@dimen/dp3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/recycler_card_left_right_margin"
                android:outlineSpotShadowColor="@color/gray_dark2"
                android:outlineAmbientShadowColor="@color/gray_dark2"
                app:cardCornerRadius="@dimen/dp5"
                app:cardElevation="@dimen/dp4">
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/imageRL"
                        android:layout_width="@dimen/dp100"
                        android:layout_height="@dimen/dp67">
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvrImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/dp6"
                            app:cardCornerRadius="@dimen/dp5">
                            <ImageView
                                android:id="@+id/imageCourse"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/square_placeholder_new"
                                android:scaleType="fitXY"/>
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:id="@+id/rl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/emiTxt"
                        android:layout_toRightOf="@+id/imageRL"
                        android:layout_marginStart="@dimen/dp4">
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/country_code_text_color"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/orderId"
                            android:padding="@dimen/dp3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp3"
                            android:text="Order Id"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_semibold"/>
                        <TextView
                            android:textSize="@dimen/sp14"
                            android:textColor="@color/country_code_text_color"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/txtTitle"
                            android:padding="@dimen/dp3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Title"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_semibold"/>
                        <TextView
                            android:textSize="@dimen/sp13"
                            android:textColor="@color/gray_dark2"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/purchasedOnTxt"
                            android:padding="@dimen/dp3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Purchased On"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_regular"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp">
                            <TextView
                                android:textSize="@dimen/sp12"
                                android:textColor="@color/gray_dark2"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/purchasedPriceTxt"
                                android:padding="@dimen/dp3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price"
                                android:includeFontPadding="false"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_regular"/>
                            <TextView
                                android:textSize="@dimen/sp12"
                                android:textColor="@color/gray_dark2"
                                android:layout_gravity="center_vertical"
                                android:id="@+id/purchasedQuantityTxt"
                                android:padding="@dimen/dp3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quantity"
                                android:includeFontPadding="false"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_regular"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/emiTxt"
                        android:background="@drawable/btn_back_with_ripple"
                        android:paddingLeft="@dimen/dp10"
                        android:paddingTop="@dimen/dp4"
                        android:paddingRight="@dimen/dp10"
                        android:paddingBottom="@dimen/dp4"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMI"
                        android:layout_toLeftOf="@+id/forwardIVNew"
                        android:layout_centerVertical="true"/>
                    <ImageView
                        android:id="@+id/forwardIVNew"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp16"
                        android:layout_height="@dimen/dp16"
                        android:src="@mipmap/forward_black"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
