<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/challenge_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/txt_resume"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/close"
        android:layout_marginEnd="@dimen/dp2"
        android:backgroundTint="@color/colorWhite"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#7299e6"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/challenge"
        android:lineSpacingExtra="6sp"
        android:fontFamily="@font/inter_semibold"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/layout_fileAttach"
        android:background="@drawable/attach_corder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:src="@mipmap/attach"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/gray"
            android:id="@+id/txt_tapAddNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_to_doc"
            android:lineSpacingExtra="3sp"
            android:letterSpacing="0.03"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/layout_fileDetail"
        android:background="@drawable/challenge_imgesetborder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp35"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:id="@+id/img_fileAttached"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:src="@drawable/challenge_image_icon"
            android:layout_marginStart="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp35"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/img_crossFile"
            android:layout_toEndOf="@+id/img_fileAttached">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_fileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="wnnfoieifni"
                android:lines="1"
                android:lineSpacingExtra="2sp"
                android:textAlignment="center"
                android:layout_marginStart="15dp"
                android:letterSpacing="0.03"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/country_code_text_color"
                android:id="@+id/txt_fileSize"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:lineSpacingExtra="2sp"
                android:layout_marginStart="15dp"
                android:letterSpacing="0.03"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/img_crossFile"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/close"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <EditText
            android:textSize="12sp"
            android:textColor="@color/country_code_text_color"
            android:textColorHint="@color/gray"
            android:gravity="start|top"
            android:id="@+id/edit_query"
            android:background="@drawable/img_border"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:hint="write Query"
            android:maxLength="500"
            android:lineSpacingExtra="2sp"
            android:inputType="textCapWords"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:letterSpacing="0.03"/>
    </LinearLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/commonBtnTextColor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_submit"
        android:background="@drawable/common_round_corners_button_drawable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="30dp"
        android:text="@string/submit"
        android:textAllCaps="false"
        android:fontFamily="@font/inter_semibold"
        android:paddingStart="45dp"
        android:paddingEnd="45dp"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
