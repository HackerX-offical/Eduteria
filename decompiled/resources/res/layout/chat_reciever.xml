<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp24"
    android:layout_marginTop="@dimen/dp4"
    android:layout_marginBottom="@dimen/dp4">
    <RelativeLayout
        android:background="@drawable/button_background_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="@dimen/post_text_size_x"
            android:textStyle="normal"
            android:textColor="@color/country_code_text_color"
            android:orientation="vertical"
            android:id="@+id/reciever_chat"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp4"
            android:paddingRight="@dimen/dp8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/extrasmall_text_size_10"
            android:textStyle="bold"
            android:textColor="@color/country_code_text_color"
            android:orientation="vertical"
            android:id="@+id/reciever_chat_time"
            android:paddingLeft="@dimen/dp8"
            android:paddingTop="@dimen/dp4"
            android:paddingRight="@dimen/dp8"
            android:paddingBottom="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/reciever_chat"/>
    </RelativeLayout>
</RelativeLayout>
