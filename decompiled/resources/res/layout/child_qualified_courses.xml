<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="@dimen/dp4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewid"
        android:background="@color/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dimen_1dp"/>
    <RelativeLayout
        android:id="@+id/rl_main"
        android:padding="@dimen/dp6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/viewid">
        <TextView
            android:textSize="@dimen/sp12"
            android:textColor="@color/white"
            android:id="@+id/tv_enroll_now"
            android:background="@drawable/primary_bg_round"
            android:paddingTop="@dimen/dp4"
            android:paddingBottom="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enroll Now"
            android:includeFontPadding="false"
            android:layout_alignParentTop="true"
            android:fontFamily="@font/inter_medium"
            android:paddingStart="@dimen/dp6"
            android:paddingEnd="@dimen/dp6"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/sp14"
            android:textColor="@color/black_text_color"
            android:ellipsize="end"
            android:id="@+id/tv_course_title"
            android:paddingBottom="@dimen/dp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:fontFamily="@font/inter_medium"
            android:paddingEnd="@dimen/dp6"
            android:layout_toStartOf="@+id/tv_enroll_now"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/sp12"
            android:textColor="@color/red"
            android:id="@+id/tv_discount_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp4"
            android:includeFontPadding="false"
            android:layout_below="@+id/tv_course_title"
            android:fontFamily="@font/inter_medium"/>
    </RelativeLayout>
</RelativeLayout>
