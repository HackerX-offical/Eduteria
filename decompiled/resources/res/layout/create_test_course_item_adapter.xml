<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/dp200">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/tileRL"
        android:padding="@dimen/dp4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp16">
        <RelativeLayout
            android:id="@+id/videoplayerRL"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp150">
            <ImageView
                android:id="@+id/ibt_single_vd_iv"
                android:background="@drawable/round_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/book_placeholder"
                android:scaleType="fitXY"/>
            <ImageView
                android:id="@+id/liveIV"
                android:padding="@dimen/dp2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/live"
                android:scaleType="fitXY"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/checkIV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp4"
                android:layout_marginRight="@dimen/dp4"
                android:src="@mipmap/check_def"/>
            <TextView
                android:textSize="@dimen/extrasmall_text_size_12"
                android:textColor="@color/black_405461"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class XII Commerce"
                android:maxLines="3"
                android:minLines="3"
                android:fontFamily="@font/inter_bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
