<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corner_chat_item_right"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/cancel"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:layout_margin="@dimen/dp6"
            android:src="0x7f080102"
            app:tint="@color/colorPrimary"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:background="@drawable/bg_mcq_selected5"
            android:paddingLeft="@dimen/dp10"
            android:paddingTop="@dimen/dp30"
            android:paddingRight="@dimen/dp10"
            android:paddingBottom="@dimen/dp30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp6"
            android:layout_weight="3"
            android:translationZ="@dimen/dp2">
            <TextView
                android:textSize="@dimen/small_text_size2"
                android:textColor="@color/country_code_text_color"
                android:id="@+id/audioText_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wijaya Abadi"
                android:layout_weight="0.3"
                android:fontFamily="@font/inter_regular"
                android:textAlignment="textEnd"/>
            <LinearLayout
                android:paddingTop="@dimen/dp2"
                android:paddingBottom="@dimen/dp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12">
                <ImageView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/userimage"
                    android:background="@drawable/headphones"
                    android:layout_width="@dimen/dp20"
                    android:layout_height="@dimen/dp20"
                    android:layout_marginStart="@dimen/dp2"
                    android:backgroundTint="@color/black"/>
                <TextView
                    android:textSize="@dimen/dp20"
                    android:textColor="@color/black"
                    android:id="@+id/textaudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/audio"
                    android:paddingStart="@dimen/dp10"
                    android:paddingEnd="@dimen/dp10"
                    android:layout_marginStart="@dimen/dp10"/>
                <Button
                    android:id="@+id/audioplay1"
                    android:background="@mipmap/play_audio_icon"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginStart="@dimen/dp10"
                    android:backgroundTint="@color/colorPrimary"/>
                <Button
                    android:id="@+id/audiopause1"
                    android:background="0x7f08052f"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginStart="@dimen/dp10"
                    android:backgroundTint="@color/colorPrimary"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="8sp"
                    android:textColor="#979797"
                    android:layout_gravity="end"
                    android:id="@+id/righttexttimeAudio"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp5"
                    android:text="21-12"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/inter_regular"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
