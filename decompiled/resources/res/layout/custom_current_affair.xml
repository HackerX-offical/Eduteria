<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/dp8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp6"
        android:elevation="@dimen/dp8"
        app:cardCornerRadius="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="4">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.7">
                    <TextView
                        android:enabled="true"
                        android:textSize="@dimen/dp16"
                        android:textStyle="bold"
                        android:textColor="@color/loginHeaderColor"
                        android:id="@+id/currentAffair_tittle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp8"
                        android:text="Subject Name"
                        android:lines="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:enabled="true"
                        android:textSize="@dimen/dp14"
                        android:id="@+id/currentAffair_subject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp12"
                        android:lines="2"
                        android:fontFamily="@font/inter_semibold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/shareCurrentAffair"
                        android:padding="6dp"
                        android:layout_width="@dimen/dp36"
                        android:layout_height="@dimen/dp36"
                        android:layout_marginBottom="@dimen/dp8"
                        android:src="0x7f080613"
                        android:layout_alignParentBottom="true"
                        android:layout_marginStart="@dimen/dp8"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/currentAffair_image"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp120"
                    android:src="@mipmap/square_placeholder"
                    android:scaleType="fitXY"
                    android:layout_weight="1.3"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp13"
                android:textColor="@color/loginHeaderColor"
                android:gravity="bottom"
                android:layout_gravity="end|bottom"
                android:id="@+id/currentAffair_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp12"
                android:text="12/02/1995"
                android:fontFamily="@font/inter_semibold"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/blinkNewCF"
                android:padding="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/new_"
                android:scaleType="fitXY"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
