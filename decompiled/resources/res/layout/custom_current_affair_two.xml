<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp5"
        android:elevation="@dimen/dp8"
        app:cardCornerRadius="@dimen/dp6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="@dimen/dp1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="@dimen/dp10">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/dp120"
                    android:layout_height="@dimen/dp80"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="6dp">
                    <ImageView
                        android:id="@+id/currentAffair_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/square_placeholder"
                        android:scaleType="fitXY"/>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.5">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:ellipsize="end"
                        android:id="@+id/currentAffair_tittle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp8"
                        android:layout_marginBottom="@dimen/dp4"
                        android:text="Subject Name"
                        android:lines="1"
                        android:layout_marginStart="@dimen/dp8"
                        android:layout_marginEnd="@dimen/dp8"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/dp13"
                        android:ellipsize="end"
                        android:id="@+id/currentAffair_subject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lines="2"
                        android:fontFamily="@font/inter_semibold"
                        android:layout_marginStart="@dimen/dp12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/shareCurrentAffair"
                    android:padding="6dp"
                    android:layout_width="@dimen/dp36"
                    android:layout_height="@dimen/dp36"
                    android:layout_marginBottom="@dimen/dp8"
                    android:src="0x7f080613"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/dp8"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp13"
                android:textColor="@color/LogincolorPrimary"
                android:gravity="bottom"
                android:layout_gravity="end|bottom"
                android:id="@+id/currentAffair_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="2dp"
                android:text="12/02/1995"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/blinkNewCF"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="20dp"
                android:layout_marginTop="50dp"
                android:layout_marginRight="@dimen/dp8"
                android:src="@mipmap/new_"
                android:scaleType="fitXY"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
