<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/masterMessageCard"
        android:background="@drawable/chat_receive_bg"
        android:padding="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginBottom="@dimen/dp8"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"
        android:elevation="@dimen/dp6">
        <TextView
            android:textSize="@dimen/sp13"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginRight="@dimen/dp20"
            android:text=""
            android:maxLines="1"
            android:fontFamily="@font/amazon_ember_rg"/>
        <TextView
            android:textSize="@dimen/sp13"
            android:textColor="@color/black_text_color"
            android:layout_gravity="top"
            android:id="@+id/replayMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp220"
            android:text="Message"
            android:fontFamily="@font/amazon_ember_rg"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/cvrLeftimage"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp8"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">
        <LinearLayout
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="@dimen/dp10"
            android:layout_marginBottom="2dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/iv_img_left_click"
                android:background="@drawable/chat_receive_bg"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp6"
                android:layout_weight="1"
                android:translationZ="@dimen/dp2">
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/userNameimage"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:fontFamily="@font/inter_bold"/>
                <ImageView
                    android:id="@+id/letfmessageTvimage"
                    android:paddingTop="@dimen/dp6"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp200"
                    android:scaleType="centerCrop"
                    android:alpha="0.7"
                    android:fontFamily="@font/inter_regular"/>
                <TextView
                    android:textSize="8sp"
                    android:textColor="#979797"
                    android:id="@+id/leftimagetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:text="21-12"
                    android:fontFamily="@font/inter_regular"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/cvrLeftAudio"
        android:visibility="gone"
        android:layout_width="@dimen/dp250"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp5"
        android:layout_marginBottom="@dimen/dp8">
        <LinearLayout
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            android:orientation="horizontal"
            android:id="@+id/nav_headerLeftAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:background="@drawable/chat_receive_bg"
                android:paddingLeft="@dimen/dp10"
                android:paddingTop="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:paddingBottom="@dimen/dp10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp6"
                android:layout_weight="1"
                android:translationZ="@dimen/dp2">
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/colorPrimary"
                    android:id="@+id/audioText_usernameLeft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/dp2"
                    android:paddingBottom="@dimen/dp2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp10">
                    <Button
                        android:id="@+id/audioplayLeft"
                        android:background="@mipmap/play_audio_icon"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:layout_marginStart="@dimen/dp10"
                        android:backgroundTint="@color/colorPrimary"/>
                    <Button
                        android:id="@+id/audiopauseLeft"
                        android:background="0x7f08052f"
                        android:visibility="gone"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:layout_marginStart="@dimen/dp10"
                        android:backgroundTint="@color/colorPrimary"/>
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/textaudioLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"
                        android:layout_marginStart="@dimen/dp10"/>
                    <ImageView
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/userimageLeft"
                        android:background="@drawable/headphones"
                        android:layout_width="@dimen/dp20"
                        android:layout_height="@dimen/dp20"
                        android:layout_marginStart="@dimen/dp2"
                        android:backgroundTint="@color/black"/>
                </LinearLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="8sp"
                        android:textColor="#979797"
                        android:id="@+id/audio_timeLeftAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:text="21-12"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/inter_regular"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:id="@+id/userMessageCard"
        android:background="@drawable/chat_send_bg"
        android:padding="@dimen/dp16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"
        android:elevation="@dimen/dp6">
        <TextView
            android:textSize="@dimen/sp13"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp5"
            android:layout_marginRight="@dimen/dp20"
            android:text="You"
            android:maxLines="1"
            android:fontFamily="@font/amazon_ember_rg"/>
        <TextView
            android:textSize="@dimen/sp13"
            android:textColor="@color/black_text_color"
            android:layout_gravity="top"
            android:id="@+id/userMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/dp220"
            android:text="Message"
            android:fontFamily="@font/amazon_ember_rg"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp11"
        android:textColor="@color/black_text_color"
        android:layout_gravity="top"
        android:id="@+id/tv_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp2"
        android:text="Message"
        android:fontFamily="@font/amazon_ember_rg"
        android:layout_marginStart="@dimen/dp10"
        android:layout_marginEnd="@dimen/dp10"/>
</LinearLayout>
