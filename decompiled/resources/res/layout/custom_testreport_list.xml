<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5">
                    <ImageView
                        android:layout_width="@dimen/dp100"
                        android:layout_height="@dimen/dp67"
                        android:src="@mipmap/square_placeholder_new"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp8"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/sp13"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/testReport_title"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:text="Test Demo"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="5dp"
                        android:layout_toStartOf="@+id/l1"/>
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/gray_light"
                        android:ellipsize="end"
                        android:id="@+id/testReport_startTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="@dimen/dp2"
                        android:layout_marginBottom="@dimen/dp4"
                        android:text="Start: 01 Oct 2023 12:00 AM"
                        android:maxLines="4"
                        android:includeFontPadding="false"
                        android:layout_below="@+id/ibt_single_sub_vd_tv_title"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:layout_toStartOf="@+id/l1"/>
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/gray_light"
                        android:ellipsize="end"
                        android:id="@+id/testReport_endTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginRight="@dimen/dp2"
                        android:layout_marginBottom="@dimen/dp4"
                        android:text="Start: 01 Oct 2023 12:00 AM"
                        android:maxLines="4"
                        android:includeFontPadding="false"
                        android:layout_below="@+id/ibt_single_sub_vd_tv_title"
                        android:fontFamily="@font/amazon_ember_bd"
                        android:layout_toStartOf="@+id/l1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp4">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/view_result"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp5"
                    android:text="@string/view_result"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/country_code_text_color"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/attempt"
                    android:background="@drawable/round_corner_button_bg_grey"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp5"
                    android:text="@string/attempt"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
