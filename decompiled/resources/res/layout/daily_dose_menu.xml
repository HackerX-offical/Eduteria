<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/parentLL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp2"
        app:cardCornerRadius="@dimen/dp8"
        app:cardElevation="@dimen/dp3"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/Linear_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/dp10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <RelativeLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/imageplayerRL"
                    android:layout_width="@dimen/dp60"
                    android:layout_height="@dimen/dp60">
                    <ImageView
                        android:id="@+id/itemIV"
                        android:layout_width="@dimen/dp60"
                        android:layout_height="@dimen/dp60"
                        android:src="@mipmap/placeholder"
                        android:scaleType="centerCrop"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/extrasmall_text_size_12"
                    android:textColor="@color/black_overlay"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/itemTitleTV"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quiz"
                    android:maxLines="2"
                    android:minLines="2"/>
                <View
                    android:background="@color/dark_quiz_grey"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp1"
                    android:layout_marginTop="@dimen/dp5"/>
            </LinearLayout>
            <View
                android:id="@+id/view1"
                android:background="@color/dark_quiz_grey"
                android:visibility="gone"
                android:layout_width="@dimen/dp1"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
