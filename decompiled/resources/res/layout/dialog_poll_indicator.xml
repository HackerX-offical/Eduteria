<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outer_touch_area"
    android:background="@color/fully_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/pollIndicatorRL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="40dp"
        android:paddingEnd="8dp"
        android:paddingVertical="36dp">
        <FrameLayout
            android:id="@+id/iconWithDot"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/iconIV"
                android:background="@drawable/circle_background_poll"
                android:padding="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/poll_indicator_logo"
                android:scaleType="centerInside"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/redDot"
                android:background="@drawable/red_dot_circle_poll"
                android:visibility="gone"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="2dp"/>
        </FrameLayout>
        <Button
            android:textSize="@dimen/sp11"
            android:textColor="@color/white"
            android:id="@+id/btnResult"
            android:background="@drawable/common_round_corners_button_drawable"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:text="@string/result"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_regular"
            android:layout_marginStart="@dimen/dp12"
            android:layout_toEndOf="@+id/iconWithDot"
            android:paddingHorizontal="28dp"/>
        <Button
            android:textSize="@dimen/sp11"
            android:textColor="@color/white"
            android:id="@+id/btnLeaderboard"
            android:background="@drawable/common_round_corners_button_drawable"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:text="@string/leaderboard"
            android:layout_below="@+id/btnResult"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_regular"
            android:layout_marginStart="-44dp"
            android:layout_alignStart="@+id/btnResult"
            android:paddingHorizontal="32dp"/>
        <ImageView
            android:id="@+id/ivCloseIndic"
            android:visibility="invisible"
            android:layout_width="@dimen/dp24"
            android:layout_height="@dimen/dp24"
            android:src="0x7f0801f8"
            android:layout_marginStart="@dimen/dp8"
            android:layout_toEndOf="@+id/btnLeaderboard"/>
    </RelativeLayout>
</FrameLayout>
