<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerLL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/primary_bottom_round_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp36"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/imageRL"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp12"
                android:layout_marginBottom="@dimen/dp12"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12"
                app:cardBackgroundColor="@color/background_all"
                app:cardCornerRadius="@dimen/dp8"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/currentAffairRL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/tileRL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.cardview.widget.CardView
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp7"
                                android:layout_marginTop="@dimen/dp5"
                                android:layout_marginRight="@dimen/dp7"
                                android:layout_marginBottom="@dimen/dp5"
                                app:cardCornerRadius="@dimen/dp5"
                                app:cardElevation="@dimen/dp2">
                                <RelativeLayout
                                    android:orientation="horizontal"
                                    android:id="@+id/maiView"
                                    android:paddingLeft="@dimen/dp2"
                                    android:paddingRight="@dimen/dp2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <RelativeLayout
                                        android:id="@+id/cvrLayout"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">
                                        <RelativeLayout
                                            android:id="@+id/videoplayerRL"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp10"
                                            android:layout_marginBottom="@dimen/dp10"
                                            android:layout_marginStart="@dimen/dp10">
                                            <androidx.cardview.widget.CardView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                app:cardCornerRadius="@dimen/dp10">
                                                <ImageView
                                                    android:id="@+id/courseImagebg"
                                                    android:layout_width="105dp"
                                                    android:layout_height="140dp"
                                                    android:src="@mipmap/square_placeholder"
                                                    android:scaleType="fitXY"/>
                                            </androidx.cardview.widget.CardView>
                                            <ImageView
                                                android:id="@+id/liveIV"
                                                android:padding="@dimen/dp2"
                                                android:visibility="gone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:src="@mipmap/live"
                                                android:scaleType="fitXY"/>
                                            <ImageView
                                                android:id="@+id/new_course"
                                                android:padding="@dimen/dp2"
                                                android:visibility="gone"
                                                android:layout_width="@dimen/dp60"
                                                android:layout_height="@dimen/dp40"
                                                android:src="@mipmap/new_"
                                                android:scaleType="fitXY"/>
                                        </RelativeLayout>
                                        <LinearLayout
                                            android:gravity="center_vertical"
                                            android:layout_gravity="center_vertical"
                                            android:orientation="vertical"
                                            android:id="@+id/layout1"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp10"
                                            android:layout_marginBottom="@dimen/dp5"
                                            android:layout_marginStart="@dimen/dp10"
                                            android:layout_marginEnd="@dimen/dp10"
                                            android:layout_toEndOf="@+id/videoplayerRL">
                                            <TextView
                                                android:textSize="@dimen/sp17"
                                                android:textStyle="bold"
                                                android:textColor="@color/dullBlack"
                                                android:ellipsize="end"
                                                android:id="@+id/title"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="ESE GATE 2021 MODULE COURSE 1 Gate CTQ + Gate Ese 2021"
                                                android:maxLines="3"/>
                                            <TextView
                                                android:textSize="@dimen/extra_extrasmall_text_size"
                                                android:textColor="@color/blackApp"
                                                android:gravity="center_vertical"
                                                android:id="@+id/ibt_single_vd_tv_day"
                                                android:paddingTop="@dimen/dp2"
                                                android:paddingBottom="@dimen/dp2"
                                                android:visibility="gone"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:text="CTQ GATE + ESE 2021"
                                                android:maxLines="2"
                                                android:includeFontPadding="false"/>
                                            <TextView
                                                android:textSize="@dimen/sp11"
                                                android:textColor="@color/light_black_font"
                                                android:gravity="start"
                                                android:id="@+id/tv_course_expire_date"
                                                android:visibility="gone"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:text="Purchased"
                                                android:maxLines="1"/>
                                            <TextView
                                                android:textSize="@dimen/extra_extrasmall_text_size"
                                                android:textColor="@color/light_black_font"
                                                android:id="@+id/tv_stream_offered"
                                                android:visibility="gone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Stream civil engineering"/>
                                            <androidx.recyclerview.widget.RecyclerView
                                                android:id="@+id/tag_recyclerview"
                                                android:visibility="gone"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:minHeight="@dimen/dp30"/>
                                            <RelativeLayout
                                                android:id="@+id/ratingRL"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="@dimen/dp7">
                                                <TextView
                                                    android:textSize="13sp"
                                                    android:textColor="@color/white"
                                                    android:gravity="center"
                                                    android:id="@+id/cartRating"
                                                    android:background="@drawable/round_button_bg_cart_rating"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="5dp"
                                                    android:text="4.6"
                                                    android:drawablePadding="2dp"
                                                    android:textAlignment="center"
                                                    android:paddingStart="4dp"
                                                    android:paddingEnd="5dp"
                                                    android:paddingVertical="2dp"
                                                    app:drawableStartCompat="@drawable/star_white"/>
                                                <TextView
                                                    android:textSize="12sp"
                                                    android:id="@+id/userRatedCounts"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/dp7"
                                                    android:text="(213) Ratings"
                                                    android:layout_marginStart="@dimen/dp10"
                                                    android:layout_toEndOf="@+id/cartRating"/>
                                            </RelativeLayout>
                                            <RelativeLayout
                                                android:gravity="center_vertical"
                                                android:layout_width="match_parent"
                                                android:layout_height="@dimen/dp20"
                                                android:layout_marginTop="@dimen/dp20">
                                                <TextView
                                                    android:textSize="@dimen/sp13"
                                                    android:textStyle="bold"
                                                    android:textColor="@color/app_eye_color"
                                                    android:gravity="end"
                                                    android:id="@+id/mrpCutTV"
                                                    android:visibility="visible"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/dp2"
                                                    android:text="Purchased"
                                                    android:maxLines="1"
                                                    android:layout_marginEnd="5dp"/>
                                                <TextView
                                                    android:textSize="@dimen/sp12"
                                                    android:textStyle="bold"
                                                    android:textColor="#ff7200"
                                                    android:id="@+id/priceTV"
                                                    android:visibility="visible"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="Rs 500,000/-*"
                                                    android:layout_centerVertical="true"
                                                    android:layout_toEndOf="@+id/mrpCutTV"/>
                                                <TextView
                                                    android:textSize="@dimen/sp12"
                                                    android:textStyle="bold"
                                                    android:textColor="#01acda"
                                                    android:gravity="start"
                                                    android:id="@+id/offerinside"
                                                    android:visibility="visible"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:maxLines="1"
                                                    android:layout_centerVertical="true"
                                                    android:layout_toEndOf="@+id/priceTV"/>
                                            </RelativeLayout>
                                            <TextView
                                                android:textSize="@dimen/sp10"
                                                android:textColor="#8a000000"
                                                android:id="@+id/validityTextTV"
                                                android:visibility="gone"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="@dimen/dp4"
                                                android:text="Begins : 3    Oct 2020"/>
                                        </LinearLayout>
                                        <LinearLayout
                                            android:orientation="horizontal"
                                            android:visibility="gone"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/dp10"
                                            android:layout_marginBottom="@dimen/dp12"
                                            android:layout_below="@+id/videoplayerRL">
                                            <RelativeLayout
                                                android:gravity="center"
                                                android:id="@+id/cartSection"
                                                android:background="@drawable/cart_bg_grey_new"
                                                android:layout_width="match_parent"
                                                android:layout_height="40dp"
                                                android:layout_weight="1"
                                                android:layout_marginStart="@dimen/dp5"
                                                android:layout_marginEnd="@dimen/dp7">
                                                <ImageView
                                                    android:id="@+id/cartIcon"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:src="@drawable/cart_black"
                                                    app:tint="@color/whie"/>
                                                <TextView
                                                    android:textSize="12sp"
                                                    android:textColor="@color/whie"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:text="ADD TO CART"
                                                    android:fontFamily="@font/inter_semibold"
                                                    android:textAlignment="center"
                                                    android:layout_marginStart="@dimen/dp5"
                                                    android:layout_toEndOf="@+id/cartIcon"/>
                                            </RelativeLayout>
                                            <TextView
                                                android:textSize="12sp"
                                                android:textColor="@color/black"
                                                android:gravity="center"
                                                android:id="@+id/buyNowId"
                                                android:background="@drawable/round_button_bg_yellow"
                                                android:paddingTop="@dimen/dp9"
                                                android:paddingBottom="@dimen/dp9"
                                                android:layout_width="match_parent"
                                                android:layout_height="40dp"
                                                android:text="BUY NOW"
                                                android:layout_weight="1"
                                                android:fontFamily="@font/inter_semibold"
                                                android:textAlignment="center"
                                                android:paddingStart="@dimen/dp25"
                                                android:paddingEnd="@dimen/dp25"
                                                android:layout_marginStart="7dp"
                                                android:layout_marginEnd="@dimen/dp10"/>
                                        </LinearLayout>
                                    </RelativeLayout>
                                    <TextView
                                        android:textSize="@dimen/dp15"
                                        android:textColor="#ff0000"
                                        android:id="@+id/dicount_value"
                                        android:visibility="gone"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginBottom="@dimen/dp13"
                                        android:text="10% off Discount valid till Sept 20, Only"
                                        android:layout_below="@+id/cvrLayout"
                                        android:layout_centerHorizontal="true"/>
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_compat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp12"
                android:layout_marginEnd="@dimen/dp12">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/quantityCountRL"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp4"
                        android:layout_marginBottom="@dimen/dp12"
                        android:layout_marginStart="@dimen/dp12">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="#2e2e2e"
                            android:id="@+id/someText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="QTY:"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/cart_count_bg_white"
                            android:padding="@dimen/dp1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp5"
                            android:layout_marginEnd="12dp"
                            android:layout_toEndOf="@+id/someText"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <Button
                                android:id="@+id/subtractButton"
                                android:background="@drawable/cart_count_bg_white_minus"
                                android:layout_width="28dp"
                                android:layout_height="22dp"
                                android:text="-"/>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="@color/black"
                                android:id="@+id/cartCountText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:layout_marginHorizontal="@dimen/dp10"/>
                            <Button
                                android:id="@+id/addButton"
                                android:background="@drawable/cart_count_bg_white_plus"
                                android:layout_width="28dp"
                                android:layout_height="22dp"
                                android:text="+"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/inStockRL"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp6"
                        android:layout_marginBottom="@dimen/dp12"
                        android:layout_marginStart="@dimen/dp12"
                        android:layout_toEndOf="@+id/quantityCountRL">
                        <TextView
                            android:textSize="16.5sp"
                            android:textColor="#2e2e2e"
                            android:id="@+id/inStockText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IN STOCK:"/>
                        <TextView
                            android:textSize="16.5sp"
                            android:textColor="@color/colorPrimary"
                            android:id="@+id/quantityText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE"
                            android:layout_marginStart="@dimen/dp5"
                            android:layout_toEndOf="@+id/inStockText"/>
                    </RelativeLayout>
                </RelativeLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp18"
                        android:textColor="@color/black"
                        android:id="@+id/course_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_semibold"
                        android:textAlignment="center"/>
                    <TextView
                        android:textSize="@dimen/sp14"
                        android:textColor="@color/light_black_font"
                        android:id="@+id/authorname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_regular"/>
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/light_black_font"
                        android:id="@+id/validityTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp8"
                        android:includeFontPadding="false"
                        android:drawablePadding="@dimen/dp6"
                        android:drawableStart="@drawable/ic_calender"
                        android:fontFamily="@font/inter_regular"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="@dimen/dp8"
                android:paddingBottom="@dimen/dp8"
                android:visibility="gone"
                android:layout_width="@dimen/dp240"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp16"
                android:weightSum="2">
                <LinearLayout
                    android:gravity="top|center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:id="@+id/courseid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1234"
                        android:fontFamily="@font/inter_regular"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top|center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type"
                        android:fontFamily="@font/amazon_ember_rg"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorOrange"
                        android:id="@+id/type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="online course"
                        android:fontFamily="@font/amazon_ember_rg"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:paddingTop="@dimen/dp12"
            android:paddingBottom="@dimen/dp12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp8">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="start"
                android:id="@+id/tileRv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:background="@color/light_quiz_grey"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp3"
                android:layout_marginTop="@dimen/dp4"/>
            <include layout="@layout/no_data_found"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
