<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/ibt_single_sub_vd_RL"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/study_single_itemLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/thumbRl"
                android:layout_width="@dimen/dp100"
                android:layout_height="@dimen/dp67"
                android:layout_margin="@dimen/dp5">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="@dimen/dp10"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/profileImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@mipmap/course_placeholder"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/subjectBTNLL"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/thumbRl">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp4">
                    <Button
                        android:textSize="@dimen/sp16"
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/paper"
                        android:background="@drawable/primary_bg_round"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4"
                        android:layout_marginTop="@dimen/dp8"
                        android:layout_marginBottom="4dp"
                        android:text="@string/paper"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/amazon_ember_rg"/>
                    <Button
                        android:textSize="@dimen/sp16"
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/booklet"
                        android:background="@drawable/primary_bg_round"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4"
                        android:layout_marginTop="@dimen/dp8"
                        android:layout_marginBottom="4dp"
                        android:text="@string/answer_key"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/amazon_ember_rg"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp4">
                    <Button
                        android:textSize="@dimen/sp16"
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/upload"
                        android:background="@drawable/primary_bg_round"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4"
                        android:layout_marginTop="@dimen/dp8"
                        android:layout_marginBottom="4dp"
                        android:text="@string/upload"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/amazon_ember_rg"/>
                    <Button
                        android:textSize="@dimen/sp16"
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/marks"
                        android:background="@drawable/bg_round_corner_fill_green_curved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4"
                        android:layout_marginTop="@dimen/dp8"
                        android:layout_marginBottom="4dp"
                        android:text="@string/marks"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:fontFamily="@font/amazon_ember_rg"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/thumbRl">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/attemptLL"
                    android:background="@drawable/border_test_attampt"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp5"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:gravity="bottom"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attempt_now"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/amazon_ember_bd"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/learn"
                    android:background="@drawable/border_test_attampt"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp5"
                    android:text="@string/learn"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_toEndOf="@+id/attemptLL"/>
                <TextView
                    android:textSize="@dimen/small_text_size2"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center_vertical"
                    android:id="@+id/practice"
                    android:background="@drawable/border_test_attampt"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp5"
                    android:text="@string/practice"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/amazon_ember_bd"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_toEndOf="@+id/learn"/>
                <ImageView
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/share"
                    android:paddingTop="@dimen/dp5"
                    android:paddingBottom="@dimen/dp5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp30"
                    android:layout_marginRight="@dimen/dp4"
                    android:layout_marginBottom="@dimen/dp5"
                    android:src="0x7f080613"
                    android:paddingStart="@dimen/dp5"
                    android:paddingEnd="@dimen/dp5"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp67"
                android:layout_margin="@dimen/dp5"
                android:layout_toRightOf="@+id/thumbRl"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/cvrBoundries"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/dp5">
                    <TextView
                        android:textSize="@dimen/sp13"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/examPrepTitleTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginBottom="@dimen/dp4"
                        android:maxLines="2"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="@dimen/dp5"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/startdate"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_below="@+id/examPrepTitleTV"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/subItemRV"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_below="@+id/startdate"
                        android:fontFamily="@font/inter_semibold"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/cvrBoundries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">
                    <RelativeLayout
                        android:orientation="vertical"
                        android:id="@+id/lockRL"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_above="@+id/subjectBTNLL"
                        android:layout_centerVertical="true"
                        android:paddingStart="@dimen/dp10"
                        android:paddingEnd="@dimen/dp10"
                        android:layout_alignParentEnd="true">
                        <ImageView
                            android:layout_width="@dimen/dp24"
                            android:layout_height="@dimen/dp24"
                            android:src="@mipmap/gray_lock"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/forwardIV"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/forward_black"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <include layout="@layout/no_data_found"/>
</RelativeLayout>
