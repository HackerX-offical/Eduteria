<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp20"
        android:textStyle="bold"
        android:textColor="@color/black_405461"
        android:id="@+id/txt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp24"
        android:text="@string/advance_filters"
        android:fontFamily="@font/inter_bold"/>
    <TextView
        android:textSize="@dimen/sp16"
        android:textColor="@color/black_405461"
        android:id="@+id/txt2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="34dp"
        android:text="@string/subject"
        android:layout_below="@+id/txt1"
        android:fontFamily="@font/inter_medium"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt2">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/subject"
            android:background="@drawable/round_corner_border_advacefilter"
            android:paddingTop="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp20">
            <TextView
                android:textSize="@dimen/post_text_size_x"
                android:layout_gravity="top"
                android:id="@+id/subjectspinner"
                android:paddingLeft="@dimen/dp5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:text="@string/select_subject"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/spinnerIV"
                android:layout_centerInParent="true"
                android:inputType="text"
                android:fontFamily="@font/amazon_ember_rg"/>
            <ImageView
                android:id="@+id/spinnerIV"
                android:padding="@dimen/dp4"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/arrow_down"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp16"
        android:textColor="@color/black_405461"
        android:id="@+id/txt3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp17"
        android:text="@string/language"
        android:layout_below="@+id/rl1"
        android:fontFamily="@font/inter_medium"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/rl2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txt3">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/launguage"
            android:background="@drawable/round_corner_border_advacefilter"
            android:paddingTop="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp20"
            android:layout_marginTop="@dimen/dp8"
            android:layout_marginRight="@dimen/dp20">
            <TextView
                android:textSize="@dimen/post_text_size_x"
                android:layout_gravity="top"
                android:id="@+id/launguagespinner"
                android:paddingLeft="@dimen/dp5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:text="@string/select_language"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/launguageIV"
                android:layout_centerInParent="true"
                android:inputType="text"
                android:fontFamily="@font/inter_medium"/>
            <ImageView
                android:id="@+id/launguageIV"
                android:padding="@dimen/dp4"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/arrow_down"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/sp16"
        android:textColor="@color/black_405461"
        android:id="@+id/txt4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp17"
        android:text="@string/course_type"
        android:layout_below="@+id/rl2"
        android:fontFamily="@font/inter_medium"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/free"
        android:background="@drawable/bg_tile_unselected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_below="@+id/txt4">
        <TextView
            android:textSize="@dimen/sub_heading_text_size"
            android:textStyle="bold"
            android:textColor="@color/tile_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/freeTextTv"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp10"
            android:text="@string/freee"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/paid_ll"
        android:background="@drawable/bg_tile_unselected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_toRightOf="@+id/free"
        android:layout_below="@+id/txt4">
        <TextView
            android:textSize="@dimen/sub_heading_text_size"
            android:textStyle="bold"
            android:textColor="@color/tile_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/paidTextTv"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp10"
            android:text="@string/paid"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/both_ll"
        android:background="@drawable/bg_tile_unselected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp20"
        android:layout_marginTop="@dimen/dp16"
        android:layout_toRightOf="@+id/paid_ll"
        android:layout_below="@+id/txt4">
        <TextView
            android:textSize="@dimen/sub_heading_text_size"
            android:textStyle="bold"
            android:textColor="@color/tile_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/bothTextTv"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp10"
            android:text="@string/both"
            android:maxLines="1"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:background="@color/off_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp40"
        android:layout_below="@+id/paid_ll">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Button
                android:textSize="@dimen/sp16"
                android:textColor="@color/commonBtnTextColor"
                android:id="@+id/filterdata"
                android:background="@drawable/common_round_corners_button_drawable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp20"
                android:layout_marginTop="@dimen/dp40"
                android:layout_marginRight="@dimen/dp20"
                android:text="@string/apply_filter"
                android:layout_centerVertical="true"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_medium"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
