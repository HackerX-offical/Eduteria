<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentLL"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llnote"
        android:background="@color/orange_lite"
        android:paddingLeft="@dimen/dp12"
        android:paddingTop="@dimen/dp6"
        android:paddingRight="@dimen/dp12"
        android:paddingBottom="@dimen/dp6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/extrasmall_text_size_10"
            android:gravity="start"
            android:id="@+id/topText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_single_or_multiple_chapter_s"
            android:layout_weight="7"
            android:fontFamily="@font/inter_regular"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/createTestRV"
        android:padding="@dimen/dp5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/spinnerLL"
        android:layout_below="@+id/llnote"
        android:overScrollMode="never"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/spinnerLL"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp12"
        android:layout_above="@+id/btnpcd">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/State"
            android:background="@drawable/round_corner_border_login_signup"
            android:paddingTop="@dimen/dp16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12">
            <TextView
                android:textSize="@dimen/small_text_size"
                android:textColor="@color/black"
                android:layout_gravity="top"
                android:id="@+id/typeSpinner"
                android:paddingLeft="@dimen/dp10"
                android:paddingRight="@dimen/dp10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_type"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/downarrowIV"
                android:layout_centerInParent="true"
                android:inputType="text"
                android:fontFamily="@font/inter_medium"/>
            <ImageView
                android:id="@+id/downarrowIV"
                android:padding="@dimen/dp4"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp40"
                android:src="@drawable/arrow_down"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp10"
                android:layout_marginEnd="@dimen/dp10"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <include layout="@layout/no_data_found"/>
    <RelativeLayout
        android:id="@+id/btnpcd"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:elevation="10dp">
        <Button
            android:textSize="@dimen/post_text_size_x"
            android:textStyle="bold"
            android:textColor="@color/commonBtnTextColor"
            android:id="@+id/buttonProceed"
            android:background="@drawable/common_round_corners_button_drawable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp12"
            android:layout_marginBottom="@dimen/dp12"
            android:text="@string/proceed"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_medium"
            android:layout_marginStart="@dimen/dp12"
            android:layout_marginEnd="@dimen/dp12"/>
    </RelativeLayout>
</RelativeLayout>
