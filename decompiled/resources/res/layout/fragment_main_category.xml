<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="22sp"
        android:textColor="@color/colorPrimary"
        android:id="@+id/chose_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp30"
        android:text="Select Exam category"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter_bold"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/select_txt"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp10"
        android:text="Based on Your Section \10 we will Provide You Subject"
        android:layout_below="@+id/chose_txt"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter_regular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/main_cat_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp20"
        android:layout_below="@+id/chose_txt"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</RelativeLayout>
