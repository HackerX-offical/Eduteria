<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/pwe_custom_card_gray_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:elevation="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_root_pwenet"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/pwe_title_color"
            android:gravity="center"
            android:id="@+id/text_card_type_label"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="EMI"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/linear_change_bank_holder"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/pwe_button_color"
                    android:id="@+id/text_change_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Bank"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="15dp"
                    android:src="@drawable/pwe_edit"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:textColor="@color/pwe_button_color"
                android:layout_gravity="center"
                android:id="@+id/button_change_bank"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="40dp"
                android:text="Change Bank"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/linear_change_plan_holder"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/pwe_button_color"
                    android:id="@+id/text_change_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Plan"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="15dp"
                    android:src="@drawable/pwe_edit"/>
            </LinearLayout>
            <Button
                android:textSize="14sp"
                android:textColor="@color/pwe_button_color"
                android:layout_gravity="center"
                android:id="@+id/button_change_plan"
                android:background="?android:attr/selectableItemBackground"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="40dp"
                android:text="Change Plan"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear_emi_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp">
            <FrameLayout
                android:id="@+id/emi_frame_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.98"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/pwe_upi_limit_note_color"
                android:gravity="center"
                android:id="@+id/text_note_msg"
                android:background="@drawable/note_dash_background"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:text=""
                android:layout_weight="0.02"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
