<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/pwe_custom_card_gray_background"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="10dp"
    android:elevation="2dp">
    <TextView
        android:textSize="20sp"
        android:textColor="@color/pwe_title_color"
        android:gravity="center"
        android:id="@+id/text_card_type_label"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:text="UPI"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.easebuzz.payment.kit.ExpandableHeightGridView
                android:id="@+id/grid_upi_options"
                android:background="@color/pwe_fragment_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="3"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linear_upi_address_holder"
                android:background="@drawable/custom_background_white"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <EditText
                        android:textSize="13sp"
                        android:textColor="@color/pwe_text_color"
                        android:textColorHint="@color/pwe_hint_color"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/edit_upi_username"
                        android:background="@color/white"
                        android:padding="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:hint="username"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/pwe_error_color"
                android:id="@+id/text_upi_address_error"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/pwe_pay_button_layout"/>
</LinearLayout>
