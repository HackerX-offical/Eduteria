<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_class_cardView"
    android:background="@drawable/corner_border"
    android:layout_width="285dp"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="10dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/study_single_itemLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp12"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/home_courseImage"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp36"
            android:src="@mipmap/both"
            android:layout_marginEnd="@dimen/dp12"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp16"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/home_subCourseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complete SSC"
                android:maxLines="1"
                android:fontFamily="@font/inter_semibold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_071E57"
                android:ellipsize="end"
                android:layout_gravity="start"
                android:id="@+id/home_courseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mathematics"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/country_code_text_color"
                android:ellipsize="end"
                android:id="@+id/home_liveDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
