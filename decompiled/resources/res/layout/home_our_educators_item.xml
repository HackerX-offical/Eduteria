<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="140dp">
    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="124dp"
        android:layout_margin="5dp"
        app:cardCornerRadius="10dp">
        <RelativeLayout
            android:id="@+id/educatorsCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dp10">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_gravity="center"
                    android:id="@+id/educatorProfileImage"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="@dimen/dp5"
                    android:layout_marginBottom="@dimen/dp15"
                    android:src="@drawable/user_pic"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/educatorFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp10"
                    android:text="Abhinay Sharma"
                    android:maxLines="1"
                    android:layout_marginHorizontal="@dimen/dp5"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <RelativeLayout
        android:id="@+id/educatorExpRel"
        android:background="@drawable/educator_bg"
        android:layout_width="80dp"
        android:layout_height="22dp"
        android:layout_margin="@dimen/dp3"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:elevation="2dp">
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/dp4"
            android:layout_marginEnd="@dimen/dp4">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dp15"
                android:layout_height="@dimen/dp15"
                android:src="@drawable/portfolio"
                android:layout_marginEnd="@dimen/dp4"
                app:tint="@color/colorPrimary"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/teachingExp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Yr Exp."
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
