<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp4"
    app:cardCornerRadius="11dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp8">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:id="@+id/courseBannerTC"
                        android:background="@drawable/image_corner_shap"
                        android:layout_width="match_parent"
                        android:layout_height="146dp"
                        android:src="@mipmap/square_placeholder_new"
                        android:scaleType="fitXY"/>
                    <FrameLayout
                        android:id="@+id/soldOutImgTC"
                        android:background="#4d000000"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="146dp">
                        <TextView
                            android:textSize="30sp"
                            android:textColor="#d32f2f"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_sold_out_stamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sold_out"
                            android:rotation="-15"
                            android:fontFamily="@font/inter_bold"
                            android:letterSpacing="0.1"/>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
                <RelativeLayout
                    android:layout_gravity="end"
                    android:id="@+id/discountRLTC"
                    android:background="@drawable/discount_bg"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginEnd="3dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent">
                    <TextView
                        android:textSize="@dimen/sp10"
                        android:textColor="@color/colorPrimary"
                        android:id="@+id/discountTC"
                        android:padding="@dimen/dp5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00% off"
                        android:layout_centerHorizontal="true"
                        android:layout_marginHorizontal="@dimen/dp3"/>
                </RelativeLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp14"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/courseTitleTC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:maxLines="2"
                android:lines="2"
                android:layout_below="@+id/courseBannerTC"
                android:fontFamily="@font/inter_semibold"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/validityRowIdTC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp8"
                android:layout_below="@+id/courseTitleTC">
                <TextView
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/validity_"
                    android:drawablePadding="6dp"
                    app:drawableStartCompat="@drawable/ic_calender"/>
                <TextView
                    android:textSize="@dimen/sp13"
                    android:gravity="start"
                    android:id="@+id/validityTC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/loading"
                    android:drawablePadding="@dimen/dp6"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp14"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="#e6e6e6"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp1"
                android:layout_marginTop="@dimen/dp8"
                android:layout_below="@+id/validityRowIdTC"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/price_linear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_below="@+id/divider">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/freeCourseTextTC"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free for Students"/>
                <LinearLayout
                    android:gravity="start"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/paidCourseLayTC"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3">
                    <TextView
                        android:textSize="@dimen/sp14"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/priceTC"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:text="00.00"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_semibold"/>
                    <TextView
                        android:textSize="@dimen/sp11"
                        android:textColor="@color/gray_dark2"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/originalPriceTC"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4"
                        android:text="0.00"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_regular"
                        android:paddingStart="@dimen/dp2"/>
                </LinearLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_weight="0.7">
                    <TextView
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/buyNowIdTC"
                        android:background="@drawable/discount_solid_bg"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Buy Now"
                        android:textAllCaps="false"/>
                    <TextView
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"
                        android:id="@+id/exploreIdTC"
                        android:background="@drawable/discount_light_bg"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="@string/explore"
                        android:textAllCaps="false"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/relative_blink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/liveIV"
                android:padding="@dimen/dp3"
                android:visibility="gone"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp20"
                android:layout_marginTop="3dp"
                android:src="@mipmap/live"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="@dimen/dp3"/>
            <ImageView
                android:layout_gravity="end"
                android:id="@+id/new_course"
                android:padding="@dimen/dp3"
                android:visibility="gone"
                android:layout_width="@dimen/dp40"
                android:layout_height="@dimen/dp20"
                android:layout_marginTop="3dp"
                android:src="@mipmap/new_"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="3dp"/>
        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
