<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:id="@+id/countInstallment"
        android:padding="@dimen/dp6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Installment Details"
        android:fontFamily="@font/inter_bold"/>
    <View
        android:background="@color/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp2"
        android:layout_marginLeft="@dimen/dp10"
        android:layout_marginRight="@dimen/dp10"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp5"
                android:weightSum="8">
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price"
                        android:fontFamily="@font/inter_bold"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GST"
                        android:fontFamily="@font/inter_bold"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:fontFamily="@font/inter_bold"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due Date"
                        android:fontFamily="@font/inter_bold"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/marks_nper_ques"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_ntime"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp5"
                android:layout_marginBottom="@dimen/dp5"
                android:weightSum="8">
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/priceTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 6000"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/gstTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 480"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/ttlTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 6480"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/dueDateTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:padding="@dimen/dp2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/markPerQuesTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/marks_nper_ques"
                        android:textAlignment="center"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/section_time"
                    android:padding="@dimen/dp2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="2">
                    <TextView
                        android:textSize="@dimen/small_text_size2"
                        android:textColor="@color/country_code_text_color"
                        android:id="@+id/totTimeTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_ntime"
                        android:textAlignment="center"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
