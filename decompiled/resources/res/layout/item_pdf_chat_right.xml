<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="end"
        android:id="@+id/cvrRightpdf"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="end"
            android:layout_width="@dimen/dp250"
            android:layout_height="wrap_content">
            <LinearLayout
                android:theme="@style/ThemeOverlay.AppCompat.Dark"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:id="@+id/pdf_right_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp6"
                android:baselineAligned="false"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:background="@drawable/chat_bubble_user"
                    android:paddingLeft="@dimen/dp10"
                    android:paddingTop="@dimen/dp10"
                    android:paddingRight="@dimen/dp10"
                    android:paddingBottom="@dimen/dp10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp6"
                    android:layout_weight="3">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/ivPinPdf"
                            android:visibility="gone"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginTop="@dimen/dp2"
                            android:src="@mipmap/red_pin"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="15.8sp"
                            android:textColor="@color/country_code_text_color"
                            android:layout_gravity="end"
                            android:id="@+id/pdfText_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/dp120"
                            android:text="Wijaya Abadi ad asdas afad"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"
                            android:textAlignment="textEnd"
                            android:layout_marginEnd="@dimen/dp5"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/pdfViewRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp12"
                        android:layout_marginBottom="@dimen/dp12"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/pdflayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp16"
                            android:layout_marginRight="@dimen/dp16">
                            <ImageView
                                android:padding="@dimen/dp5"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/dp2"
                                android:src="@mipmap/pdf_icon"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/black"
                                android:ellipsize="end"
                                android:layout_gravity="center"
                                android:id="@+id/pdfNameRight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PDF"
                                android:maxLines="2"
                                android:layout_marginStart="@dimen/dp5"/>
                        </LinearLayout>
                        <ImageView
                            android:background="@mipmap/download_active"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="@dimen/dp10"
                            android:layout_marginTop="@dimen/dp5"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dp10">
                        <RelativeLayout
                            android:gravity="center"
                            android:id="@+id/cvrDownLoadRight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/downloadIc"
                                android:padding="@dimen/dp3"
                                android:layout_width="@dimen/dp25"
                                android:layout_height="@dimen/dp25"
                                android:src="@mipmap/download_active"
                                android:tint="@color/colorPrimary"
                                android:layout_centerVertical="true"/>
                            <TextView
                                android:textSize="14sp"
                                android:textColor="@color/colorPrimary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/download"
                                android:layout_toRightOf="@+id/downloadIc"
                                android:layout_centerVertical="true"/>
                        </RelativeLayout>
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/timeRl_5"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp25"
                android:layout_below="@+id/pdf_right_click"
                android:layout_marginEnd="@dimen/dp5"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#979797"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/righttexttimePdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21-12"
                    android:fontFamily="@font/inter_regular"
                    android:layout_marginStart="@dimen/dp10"
                    android:layout_marginEnd="@dimen/dp15"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:background="#979797"
                    android:visibility="gone"
                    android:layout_width="@dimen/dp1"
                    android:layout_height="13dp"
                    android:layout_marginStart="@dimen/dp10"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:visibility="gone"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="#979797"
                    android:layout_toEndOf="@+id/lefttexttime"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
