<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/no_data_found_RL"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:background="0x7f080655"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp10"
            android:layout_below="@+id/ll1"
            android:layout_centerInParent="true"/>
        <TextView
            android:textColor="@color/country_code_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/no_data"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp10"
            android:text="@string/no_data_found"
            android:layout_centerInParent="true"
            android:fontFamily="@font/amazon_ember_bd"/>
        <TextView
            android:textSize="@dimen/extrasmall_text_size_12"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="@dimen/dp4"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="40dp"
            android:text="@string/sorry_there_is_no_result_for_this_search"
            android:fontFamily="@font/amazon_ember_rg"/>
        <Button
            android:textSize="@dimen/post_text_size"
            android:textColor="@color/commonBtnTextColor"
            android:id="@+id/backBtn"
            android:background="@drawable/common_round_corners_button_drawable"
            android:paddingLeft="@dimen/dp24"
            android:paddingRight="@dimen/dp24"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:text="@string/go_back"
            android:textAllCaps="false"
            android:fontFamily="@font/amazon_ember_bd"/>
    </LinearLayout>
</RelativeLayout>
