<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize">
            <ImageView
                android:id="@+id/iv_back"
                android:padding="@dimen/dp10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp10"
                android:src="@mipmap/back_gray"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="@dimen/sp18"
                android:textColor="@color/country_code_text_color"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verification_code"
                android:layout_toRightOf="@+id/iv_back"
                android:layout_centerVertical="true"
                android:fontFamily="@font/inter_bold"
                android:layout_marginStart="51dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:padding="@dimen/dp20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="false">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/dp200"
                    android:layout_height="@dimen/dp150"
                    android:src="0x7f080657"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp20">
                    <TextView
                        android:textSize="@dimen/sp15"
                        android:textStyle="bold"
                        android:textColor="@color/country_code_text_color"
                        android:gravity="center"
                        android:id="@+id/verifyTextTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/verify_your_one_time_otp"
                        android:alpha="0.9"
                        android:fontFamily="@font/inter_semibold"
                        android:textAlignment="center"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black_405461"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="35dp"
                        android:text="@string/enter_code_sent"
                        android:alpha="0.9"
                        android:fontFamily="@font/inter_regular"
                        android:textAlignment="center"/>
                </LinearLayout>
                <EditText
                    android:textColor="#00000000"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/pin_hidden_edittext"
                    android:background="@null"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:cursorVisible="false"
                    android:password="true"
                    android:maxLength="6"
                    android:inputType="number"
                    android:contentDescription="@string/pin_content_desc"/>
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/OPT1ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT2ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT3ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT4ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT5ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                    <EditText
                        android:id="@+id/OPT6ET"
                        android:layout_width="@dimen/dp40"
                        android:layout_height="@dimen/dp40"
                        style="@style/otpTextStyle"/>
                </LinearLayout>
                <Button
                    android:textSize="@dimen/post_text_size"
                    android:textColor="@color/commonBtnTextColor"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/verifyBtn"
                    android:background="@drawable/common_round_corners_button_drawable"
                    android:paddingLeft="@dimen/dp30"
                    android:paddingRight="@dimen/dp30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="@string/verfiy"
                    android:textAllCaps="false"
                    android:fontFamily="@font/inter_semibold"
                    android:elevation="@dimen/dp5"/>
                <TextView
                    android:textSize="13dp"
                    android:textStyle="bold"
                    android:textColor="@color/blue"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15"
                    android:text="01:00"
                    android:drawablePadding="@dimen/dp10"
                    android:drawableStart="@drawable/ic_timer"
                    android:fontFamily="@font/inter_semibold"/>
                <LinearLayout
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp15">
                    <TextView
                        android:id="@+id/resendotpTV1"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/didn_t_receive_otp"/>
                    <TextView
                        android:textColor="@color/blue"
                        android:id="@+id/resendotpTV"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resendotp"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
