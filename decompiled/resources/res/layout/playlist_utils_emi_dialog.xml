<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/imageCloseIV"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="-32dp"
        android:layout_alignParentEnd="true"
        app:cardBackgroundColor="@color/button_left"
        app:cardCornerRadius="15dp"
        app:cardElevation="2dp"
        app:cardPreventCornerOverlap="false">
        <ImageView
            android:layout_gravity="center"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/close"
            android:adjustViewBounds="true"
            android:layout_alignTop="@+id/logo_btn"
            android:layout_toEndOf="@+id/logo_btn"/>
    </androidx.cardview.widget.CardView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp12">
        <androidx.cardview.widget.CardView
            android:id="@+id/data_cv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp1"
            app:cardCornerRadius="@dimen/dp12"
            app:cardElevation="@dimen/dp5">
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/dp16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/heading_text_size"
                    android:textStyle="bold"
                    android:textColor="@color/country_code_text_color"
                    android:gravity="start"
                    android:layout_gravity="start"
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/dp10"
                    android:text="@string/add_coupon"
                    android:maxLines="1"/>
                <ListView
                    android:id="@+id/list"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@color/colorBackground"
                    android:dividerHeight="1px"/>
                <TextView
                    android:textSize="@dimen/sp17"
                    android:textStyle="bold"
                    android:textColor="@color/country_code_text_color"
                    android:id="@+id/totalPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp10"
                    android:layout_marginBottom="@dimen/dp10"
                    android:text="@string/add_coupon"
                    android:maxLines="1"/>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:weightSum="2">
                    <Button
                        android:textColor="@color/commonBtnTextColor"
                        android:id="@+id/continueBtn"
                        android:background="@drawable/common_round_corners_button_drawable"
                        android:padding="@dimen/dp5"
                        android:paddingLeft="@dimen/dp12"
                        android:paddingRight="@dimen/dp12"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp40"
                        android:layout_marginLeft="@dimen/dp80"
                        android:layout_marginTop="@dimen/dp4"
                        android:layout_marginRight="@dimen/dp80"
                        android:layout_marginBottom="@dimen/dp4"
                        android:text="@string/continuee"
                        android:layout_weight="1"
                        android:layout_centerHorizontal="true"
                        android:textAllCaps="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</RelativeLayout>
