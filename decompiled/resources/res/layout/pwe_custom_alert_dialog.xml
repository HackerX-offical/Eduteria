<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/pwe_title_color"
                android:gravity="center_horizontal"
                android:id="@+id/text_alert_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <Button
                android:textSize="16sp"
                android:textColor="@color/pwe_button_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_alert_ok"
                android:background="@drawable/pwe_custom_button"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginRight="10dp"
                android:text="OK"
                android:textAllCaps="false"/>
            <Button
                android:textSize="16sp"
                android:textColor="@color/pwe_button_text_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_alert_cancel"
                android:background="@drawable/pwe_custom_button"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="30dp"
                android:text="Cancel"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
