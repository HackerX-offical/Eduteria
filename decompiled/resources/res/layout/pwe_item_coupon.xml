<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/pwe_custom_card_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:elevation="5dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/linear_coupon_data_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/img_coupon"
                android:layout_width="135dp"
                android:layout_height="70dp"
                android:layout_margin="5dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/pwe_text_color"
                android:id="@+id/text_coupons_brand_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="5dp"
                android:text=""
                android:singleLine="true"/>
            <TextView
                android:textSize="13sp"
                android:id="@+id/text_coupons_offer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="3dp"
                android:text=""
                android:singleLine="true"/>
            <View
                android:background="@color/pwe_divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="3dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.7">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/pwe_text_color"
                        android:layout_gravity="left"
                        android:id="@+id/text_coupon_price"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="10dp"
                    android:layout_weight="0.3">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/pwe_text_color"
                        android:gravity="right"
                        android:id="@+id/text_coupon_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="View"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
