<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/linear_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/pwe_custom_card_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:elevation="2dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/linear_main_layout"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="0.15">
                <ImageView
                    android:id="@+id/img_card_type"
                    android:layout_width="40dp"
                    android:layout_height="35dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="0.5">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/pwe_text_color"
                    android:id="@+id/text_saved_card_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/linear_cvv_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_weight="0.4">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <EditText
                            android:textSize="14sp"
                            android:textColor="@color/pwe_text_color"
                            android:textColorHint="@color/pwe_hint_color"
                            android:gravity="center"
                            android:id="@+id/edit_cvv_number"
                            android:background="@drawable/custom_background_white"
                            android:padding="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="32dp"
                            android:hint=" CVV "
                            android:maxLength="4"
                            android:inputType="numberPassword"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="2">
                        <ImageView
                            android:id="@+id/ib_remove_card"
                            android:padding="5dp"
                            android:focusable="false"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/pwe_close_black"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/pwe_error_color"
                    android:layout_gravity="center"
                    android:id="@+id/text_saved_card_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text=""
                    android:lines="2"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
