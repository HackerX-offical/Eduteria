<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/linear_root_footer"
    android:background="@color/pwe_footer_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/pwe_discount_coupon_card"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="14sp"
            android:textColor="@color/pwe_cancel_button_text_color"
            android:layout_gravity="center"
            android:id="@+id/button_cancel_transaction"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="Cancel Transaction"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/pwe_cancel_button_text_color"
            android:layout_gravity="center"
            android:id="@+id/button_failed_transaction"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="Fail Transaction"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
    <include layout="@layout/pwe_layout_certificate_new"/>
</LinearLayout>
