<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/pwe_upi_limit_note_color"
        android:gravity="center"
        android:id="@+id/text_note_message"
        android:background="@drawable/note_dash_background"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="10dp"
        android:text=""/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/pwe_button_text_color"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/button_proceed_for_payment"
        android:background="@drawable/pwe_custom_pay_button_background"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="Pay"
        android:textAllCaps="false"/>
</LinearLayout>
