<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/payment_step_progress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <View
            android:layout_gravity="center"
            android:id="@+id/cart_progress_bar"
            android:background="@color/gray_light"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/first_progress_bar_text"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:drawableLeft="@drawable/cart_without_progress"
            android:drawablePadding="2dp"
            android:drawableTint="@color/colorPrimary"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <View
            android:layout_gravity="center"
            android:id="@+id/address_progress_bar"
            android:background="@color/gray_light"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#7d7b7b"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/second_progress_bar_text"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            android:drawableLeft="@drawable/cart_without_progress"
            android:drawablePadding="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <View
            android:layout_gravity="center"
            android:id="@+id/payment_progress_bar"
            android:background="@color/gray_light"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#7d7b7b"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/third_progress_bar_text"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:drawableLeft="@drawable/cart_without_progress"
            android:drawablePadding="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <View
            android:layout_gravity="center"
            android:id="@+id/fourth_progress_bar"
            android:background="@color/gray_light"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#7d7b7b"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/fourth_progress_bar_text"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4"
            android:drawableLeft="@drawable/cart_without_progress"
            android:drawablePadding="2dp"/>
    </LinearLayout>
</LinearLayout>
