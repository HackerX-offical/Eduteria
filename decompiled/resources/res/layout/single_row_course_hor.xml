<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/parentLL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp3"
        android:layout_marginRight="@dimen/dp3"
        android:layout_marginBottom="@dimen/dp5"
        app:cardElevation="@dimen/dp2">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp2">
            <ImageView
                android:id="@+id/imageIV"
                android:layout_width="@dimen/dp80"
                android:layout_height="@dimen/dp80"
                android:src="@mipmap/default_pic"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/imageIV">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/dp5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:weightSum="3"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/post_text_size"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:id="@+id/nameTV"
                        android:padding="@dimen/dp2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:text=""
                        android:maxLines="2"
                        android:layout_weight="1.8"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_11"
                        android:textColor="@color/black_overlay"
                        android:id="@+id/priceTV"
                        android:paddingLeft="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text=""
                        android:maxLines="1"
                        android:layout_weight="0.6"/>
                    <TextView
                        android:textSize="@dimen/extrasmall_text_size_11"
                        android:textColor="@color/black_overlay"
                        android:id="@+id/learnerTV"
                        android:paddingLeft="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:text=""
                        android:maxLines="1"
                        android:layout_weight="0.6"/>
                </LinearLayout>
                <RelativeLayout
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5">
                    <TextView
                        android:textSize="@dimen/dp30"
                        android:textColor="@color/black_overlay"
                        android:id="@+id/ratingTV"
                        android:padding="@dimen/dp2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.0"
                        android:layout_centerInParent="true"/>
                    <RatingBar
                        android:id="@+id/ratingRB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:rating="5"
                        android:layout_below="@+id/ratingTV"
                        android:layout_centerInParent="true"
                        style="@style/Base.Widget.AppCompat.RatingBar.Small"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
