<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/countLL"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/colorPrimary"
        android:id="@+id/sectionText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/parentLLTestpad"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="50dp"
            android:layout_height="50dp">
            <RelativeLayout
                android:layout_gravity="center"
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:id="@+id/imageIVText"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/circle"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textColor="@color/country_code_text_color"
                    android:gravity="center"
                    android:id="@+id/myImageViewText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_alignLeft="@+id/imageIVText"
                    android:layout_alignTop="@+id/imageIVText"
                    android:layout_alignRight="@+id/imageIVText"
                    android:layout_alignBottom="@+id/imageIVText"
                    android:fontFamily="@font/inter_medium"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_selected"
                android:visibility="gone"
                android:layout_width="@dimen/dp20"
                android:layout_height="@dimen/dp20"
                android:layout_marginTop="@dimen/dp25"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="@dimen/dp5">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/mark_with_circle"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <TextView
            android:textColor="@color/country_code_text_color"
            android:id="@+id/questionTV"
            android:paddingTop="3dp"
            android:paddingBottom="@dimen/dp3"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"/>
        <com.ahmadnemati.clickablewebview.ClickableWebView
            android:id="@+id/webview_questionTV"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
