<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/ibt_single_sub_vd_RL"
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp12"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp12"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <RelativeLayout
            android:background="@drawable/nav_ripple"
            android:padding="@dimen/dp6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/study_single_itemLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_gravity="center_vertical"
                    android:id="@+id/rlThumb"
                    android:padding="@dimen/dp5"
                    android:layout_width="@dimen/dp100"
                    android:layout_height="@dimen/dp70">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="@dimen/dp10"
                        app:cardElevation="0dp"
                        app:cardMaxElevation="0dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/courseImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/square_placeholder"
                                android:scaleType="fitXY"/>
                            <RelativeLayout
                                android:layout_gravity="center"
                                android:orientation="vertical"
                                android:id="@+id/lockRL"
                                android:background="#8016a0ba"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true">
                                <ImageView
                                    android:layout_width="@dimen/dp24"
                                    android:layout_height="@dimen/dp24"
                                    android:src="@mipmap/white_lock"
                                    android:layout_centerInParent="true"/>
                            </RelativeLayout>
                            <ImageView
                                android:id="@+id/liveIV"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp3"
                                android:layout_marginTop="@dimen/dp2"
                                android:src="@mipmap/live"/>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/dp15"
                    android:layout_marginEnd="@dimen/dp15">
                    <TextView
                        android:textSize="@dimen/sp13"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="start"
                        android:id="@+id/study_item_titleTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp10"
                        android:layout_marginRight="@dimen/dp12"
                        android:maxLines="2"
                        android:fontFamily="@font/inter_bold"/>
                    <TextView
                        android:textSize="@dimen/sp12"
                        android:textColor="@color/country_code_text_color"
                        android:ellipsize="end"
                        android:layout_gravity="start"
                        android:id="@+id/count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp5"
                        android:layout_marginRight="@dimen/dp12"
                        android:fontFamily="@font/inter_bold"/>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/forwardIV"
                android:layout_width="@dimen/dp15"
                android:layout_height="@dimen/dp15"
                android:src="@mipmap/forward_black"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textColor="@color/country_code_text_color"
        android:gravity="center"
        android:id="@+id/no_data"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/dp200"
        android:text="@string/no_data_found"
        android:layout_centerInParent="true"
        android:fontFamily="@font/inter_bold"/>
</RelativeLayout>
