<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/ssc_pattern_drawer_layout_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/headerContainer"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/symbolText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_help_outline"
                app:tint="@color/ssc_blue"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/ssc_blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symbols"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/ssc_gray_light"
            android:layout_width="1dp"
            android:layout_height="30dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/instructionText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info_outline"
                app:tint="@color/ssc_blue"/>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/ssc_blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/instructions"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divHeader"
        android:background="@color/ssc_gray_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmitContainer"
        app:layout_constraintTop_toBottomOf="@+id/divHeader">
        <LinearLayout
            android:orientation="vertical"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/sectionAsPart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/include_toolbar"
                app:spanCount="4"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/selectedSectionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="5dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_legend_box"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/shape_circle_green"
                        android:layout_width="12dp"
                        android:layout_height="12dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ssc_test_light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/answered_qs"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/answeredQuesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0"/>
                </LinearLayout>
                <View
                    android:background="@color/ssc_gray_light_new"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/shape_circle_blue"
                        android:layout_width="12dp"
                        android:layout_height="12dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ssc_test_light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unanswered_qs"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/unansweredQuesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0"/>
                </LinearLayout>
                <View
                    android:background="@color/ssc_gray_light_new"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/shape_circle_purple"
                        android:layout_width="12dp"
                        android:layout_height="12dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/ssc_test_light"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/marked_as_reviewed_qs"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/markedQuesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_0"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@+id/rvQuestionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/btnSubmitContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btnSectionSwitch"
            android:background="@drawable/bg_text_card_select"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/section_move"
            android:layout_marginHorizontal="16dp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btnSubmitTest"
            android:background="@drawable/bg_text_card_select"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/submit_test"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="10dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
