<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mainLay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/subscriptionRelativeLayout"
            android:background="@drawable/apply_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp10">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/dp20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="40dp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="-2dp"
                    android:text="₹"
                    android:fontFamily="@font/inter_semibold"/>
                <TextView
                    android:textSize="96dp"
                    android:textColor="@color/white"
                    android:id="@+id/subscription_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp120"
                    android:text="1"
                    android:fontFamily="@font/inter_bold"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/sp14"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/please_select_a_plan_to_continue"
            android:fontFamily="@font/inter_semibold"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subscriptionPlanRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/dp10"/>
        <TextView
            android:textSize="@dimen/sp20"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:id="@+id/subscriptionBenefits"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp20"
            android:text="@string/benefits"
            android:fontFamily="@font/inter_bold"
            android:layout_marginStart="@dimen/dp20"/>
        <WebView
            android:id="@+id/subscriptionDescription"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp10"
            android:layout_marginEnd="@dimen/dp10"/>
    </LinearLayout>
</RelativeLayout>
