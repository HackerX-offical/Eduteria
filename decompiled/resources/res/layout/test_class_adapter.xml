<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:padding="@dimen/dp3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp8"
        android:layout_marginTop="@dimen/dp8"
        android:layout_marginRight="@dimen/dp8"
        android:layout_marginBottom="@dimen/dp8"
        android:outlineSpotShadowColor="@color/gray_dark2"
        android:outlineAmbientShadowColor="@color/gray_dark2"
        app:cardBackgroundColor="@color/background_all_Lite"
        app:cardCornerRadius="@dimen/dp10"
        app:cardElevation="@dimen/dp4">
        <RelativeLayout
            android:padding="@dimen/dp6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/study_single_itemLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/detais_layout1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/rl_text_mode"
                        android:background="@drawable/primary_stroke_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:backgroundTint="@color/colorPrimary">
                        <TextView
                            android:textSize="@dimen/sp11"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:id="@+id/test_mode_tv"
                            android:paddingRight="@dimen/dp2"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp2"
                            android:layout_marginRight="@dimen/dp4"
                            android:layout_marginBottom="@dimen/dp2"
                            android:text="Online"
                            android:maxLines="1"
                            android:layout_centerInParent="true"
                            android:fontFamily="@font/inter_semibold"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/thumbRl"
                        android:layout_width="@dimen/dp100"
                        android:layout_height="@dimen/dp67"
                        android:layout_centerVertical="true">
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="@dimen/dp10"
                            app:cardElevation="0dp"
                            app:cardMaxElevation="0dp">
                            <ImageView
                                android:id="@+id/courseImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/square_placeholder_new"
                                android:scaleType="fitXY"
                                android:layout_centerVertical="true"/>
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/detais_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp10"
                        android:layout_marginEnd="@dimen/dp4"
                        android:layout_toStartOf="@+id/rl_text_mode"
                        android:layout_toEndOf="@+id/thumbRl">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/country_code_text_color"
                            android:id="@+id/study_item_titleTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:fontFamily="@font/inter_bold"/>
                        <TextView
                            android:textSize="@dimen/extrasmall_text_size_12"
                            android:textColor="@color/color_071E57"
                            android:ellipsize="end"
                            android:layout_gravity="start"
                            android:id="@+id/c_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:maxLines="2"
                            android:fontFamily="@font/inter_semibold"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/country_code_text_color"
                            android:ellipsize="end"
                            android:id="@+id/date_tv"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:fontFamily="@font/inter_medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/country_code_text_color"
                            android:ellipsize="end"
                            android:id="@+id/endDate_tv"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:fontFamily="@font/inter_medium"/>
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/layout_test"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp6"
                    android:layout_below="@+id/detais_layout1">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@+id/share">
                            <TextView
                                android:textSize="@dimen/dp13"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/startedin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/started_in"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/inter_semibold"/>
                            <TextView
                                android:textSize="@dimen/sp10"
                                android:textColor="@color/white"
                                android:layout_gravity="center"
                                android:id="@+id/time"
                                android:background="@drawable/bg_round_corner_fill_green_curved"
                                android:padding="@dimen/dp3"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:fontFamily="@font/inter_medium"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/show_rank"
                                android:background="@drawable/round_corner_button_bg_grey"
                                android:paddingTop="@dimen/dp5"
                                android:paddingBottom="@dimen/dp5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/inter_bold"
                                android:paddingStart="@dimen/dp5"
                                android:paddingEnd="@dimen/dp5"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/learn"
                                android:background="@drawable/round_corner_button_bg_grey"
                                android:paddingTop="@dimen/dp5"
                                android:paddingBottom="@dimen/dp5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/learn"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/inter_bold"
                                android:paddingStart="@dimen/dp5"
                                android:paddingEnd="@dimen/dp5"
                                android:layout_marginStart="@dimen/dp3"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/practice"
                                android:background="@drawable/round_corner_button_bg_grey"
                                android:paddingTop="@dimen/dp5"
                                android:paddingBottom="@dimen/dp5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/practice"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/inter_bold"
                                android:paddingStart="@dimen/dp5"
                                android:paddingEnd="@dimen/dp5"
                                android:layout_marginStart="@dimen/dp3"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/attemp"
                                android:background="@drawable/round_corner_button_bg_grey"
                                android:paddingTop="@dimen/dp5"
                                android:paddingBottom="@dimen/dp5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/attempt"
                                android:includeFontPadding="false"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_bold"
                                android:paddingStart="@dimen/dp5"
                                android:paddingEnd="@dimen/dp5"
                                android:layout_marginStart="@dimen/dp3"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/country_code_text_color"
                                android:id="@+id/testResume"
                                android:background="@drawable/round_corner_button_bg_grey"
                                android:paddingTop="@dimen/dp5"
                                android:paddingBottom="@dimen/dp5"
                                android:visibility="gone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/resume"
                                android:includeFontPadding="false"
                                android:textAllCaps="false"
                                android:fontFamily="@font/inter_bold"
                                android:paddingStart="@dimen/dp5"
                                android:paddingEnd="@dimen/dp5"
                                android:layout_marginStart="@dimen/dp3"/>
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f080613"
                            android:layout_marginStart="@dimen/dp3"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/subjectBTNLL"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/detais_layout1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4">
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/paper"
                            android:background="@drawable/primary_bg_round"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/paper"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/booklet"
                            android:background="@drawable/primary_bg_round"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/answer_key"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp4">
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/upload"
                            android:background="@drawable/primary_bg_round"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/upload"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                        <Button
                            android:textSize="@dimen/sp16"
                            android:textColor="@color/commonBtnTextColor"
                            android:id="@+id/marks"
                            android:background="@drawable/bg_round_corner_fill_green_curved"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/dp4"
                            android:layout_marginTop="@dimen/dp8"
                            android:layout_marginBottom="4dp"
                            android:text="@string/marks"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:fontFamily="@font/amazon_ember_rg"/>
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
            <ImageView
                android:id="@+id/liveIV"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/live"
                android:layout_marginEnd="@dimen/dp25"/>
            <ImageView
                android:id="@+id/forwardIV"
                android:visibility="gone"
                android:layout_width="@dimen/dp15"
                android:layout_height="@dimen/dp15"
                android:src="@mipmap/forward_black"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
